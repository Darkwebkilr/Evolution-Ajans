---
export interface Props {
  title: string;
  description: string;
  image?: string;
  type?: string;
}
const {
  title = "Evolution Ajans | Geleceğin Reklamcılığı",
  description = "Markanızın dijital dünyadaki evrimini yönetiyoruz. SEO, web tasarım, sosyal medya ve dijital pazarlama çözümleri.",
  image = "/img/social-media.png", // Default sharing image
  type = "website",
} = Astro.props;

import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";
import Wpbutton from "../components/Wpbutton.astro";
import LogoAnimation from "../components/LogoAnimation.astro";
---

<html lang="tr">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO & Canonical -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={Astro.url.href} />

    <!-- Schema.org JSON-LD (ProfessionalService) -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "ProfessionalService",
        "name": "Evolution Ajans",
        "image": "https://evolutionajans.com/img/Logo.png",
        "@id": "https://evolutionajans.com/#organization",
        "url": "https://evolutionajans.com",
        "telephone": "+905519283598",
        "priceRange": "$$",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "Folkart Towers, Bayraklı",
          "addressLocality": "İzmir",
          "addressCountry": "TR"
        },
        "sameAs": [
          "https://www.instagram.com/evolutionajans",
          "https://www.linkedin.com/company/evolutionajans"
        ]
      }
    </script>

    <!-- Open Graph (Facebook, LinkedIn, etc.) -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Evolution Ajans" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
  </head>
  <body class="bg-[#f8fafc] text-black">
    <Wpbutton />
    <Header />
    <main class="pt-28 md:pt-36">
      <slot />
    </main>
    <script src="../scripts/lenis.js"></script>
    <Footer />
  </body>
</html>
