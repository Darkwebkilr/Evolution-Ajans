---
import MainLayout from "../layout/mainLayout.astro";
import Form from "../components/Form.astro";
import { Icon } from "astro-icon/components";

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Ana Sayfa",
      "item": "https://evolutionajans.com/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "İletişim",
      "item": "https://evolutionajans.com/iletisim/"
    }
  ]
};

const contactPageSchema = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  "name": "İletişim - Evolution Ajans",
  "description": "Evolution Ajans iletişim bilgileri, Folkart Towers Bayraklı İzmir ofisi, telefon numarası ve teklif formu.",
  "url": "https://evolutionajans.com/iletisim/",
  "mainEntity": {
    "@type": "ProfessionalService",
    "@id": "https://evolutionajans.com/#organization"
  }
};
---

<MainLayout
  title="İletişim | İzmir Web Tasarım ve Reklam Ajansı - Evolution Ajans"
  description="İzmir'de projenizi büyütmek için bizimle iletişime geçin. Web tasarım, SEO ve reklam yönetimi için doğrudan telefon veya atölye randevusu alın."
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(contactPageSchema)} />

  <!-- Breadcrumb Bar -->
  <div class="max-w-6xl mx-auto px-6 pt-12">
    <nav class="font-mono text-xs text-[#6E6A62] flex items-center gap-2">
      <a href="/" class="hover:text-[#BE5836] transition-colors">Ana Sayfa</a>
      <span>/</span>
      <span class="text-[#181816] font-medium">İletişim</span>
    </nav>
  </div>

  <Form />
</MainLayout>
