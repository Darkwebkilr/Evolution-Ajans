---
import MainLayout from "../layout/mainLayout.astro";
import Form from "../components/Form.astro";
import { Icon } from "astro-icon/components";
---

<MainLayout
  title="İletişim - Evolution Ajans | Dijital Dönüşüm İçin Adım Atın"
  description="İzmir'in önde gelen dijital ajansı ile projenizi hayata geçirin. Web tasarım, SEO ve reklam yönetimi için bizimle iletişime geçin."
>
  <!-- Minimalist Hero Header for Contact Page -->
  <section class="relative pt-40 pb-12 overflow-hidden retro-grid">
    <div class="max-w-7xl mx-auto px-6 relative z-10">
      <div
        class="flex flex-col md:flex-row justify-between items-end gap-10 border-b-4 border-black pb-16"
      >
        <div class="max-w-3xl" data-aos="fade-right">
          <h1
            class="text-4xl md:text-5xl lg:text-6xl font-black uppercase tracking-tighter leading-none mb-6"
          >
            <span class="block text-black">GELECEĞİ</span>
            <span
              class="block text-purple-600 mt-2"
              >PLANLAYALIM.</span
            >
          </h1>
          <p class="text-lg text-black/60 font-light leading-relaxed max-w-xl">
            Sıradan bir iletişim sayfasında değilsiniz. Markanızın kaderini
            değiştirecek o ilk adımı atmak üzeresiniz.
          </p>
        </div>

        <div class="flex gap-4" data-aos="fade-left" data-aos-delay="100">
          <a
            href="https://instagram.com"
            target="_blank"
            class="w-12 h-12 rounded-none border-2 border-black flex items-center justify-center text-black bg-white hover:bg-[#facc15] hover:shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] hover:-translate-x-[2px] hover:-translate-y-[2px] shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] transition-all"
          >
            <Icon name="mdi:instagram" size={24} />
          </a>
          <a
            href="https://linkedin.com"
            target="_blank"
            class="w-12 h-12 rounded-none border-2 border-black flex items-center justify-center text-black bg-white hover:bg-[#facc15] hover:shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] hover:-translate-x-[2px] hover:-translate-y-[2px] shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] transition-all"
          >
            <Icon name="mdi:linkedin" size={24} />
          </a>
        </div>
      </div>

      <!-- Quick Info Grid -->
      <div
        class="grid grid-cols-1 md:grid-cols-3 gap-8 py-16"
        data-aos="fade-up"
        data-aos-delay="200"
      >
        <div class="space-y-4">
          <span
            class="text-[9px] font-mono uppercase tracking-[0.3em] text-blue-600 block font-pixel"
            >Lokasyon</span
          >
          <h4 class="text-xl font-bold uppercase tracking-wide text-black font-pixel">
            İzmir, TR
          </h4>
          <p class="text-black/60 text-sm leading-relaxed">
            Folart Towers, Bayraklı<br />
            İzmir, Türkiye
          </p>
        </div>
        <div class="space-y-4">
          <span
            class="text-[9px] font-mono uppercase tracking-[0.3em] text-purple-600 block font-pixel"
            >Direkt Hat</span
          >
          <a
            href="tel:+905519283598"
            class="text-xl font-bold tracking-wide text-black hover:text-purple-600 transition-colors block font-pixel"
            >+90 551 928 35 98</a
          >
          <p class="text-black/60 text-sm leading-relaxed font-mono">
            Hafta içi: 09:00 - 18:00<br />
            Hafta sonu: Kapalı
          </p>
        </div>
        <div class="space-y-4">
          <span
            class="text-[9px] font-mono uppercase tracking-[0.3em] text-pink-600 block font-pixel"
            >Dijital Ağ</span
          >
          <a
            href="mailto:hello@evolution.com"
            class="text-xl font-bold tracking-wide text-black hover:text-pink-600 transition-colors block font-pixel"
            >hello@evolution.com</a
          >
          <p class="text-black/60 text-sm leading-relaxed">
            Proje detaylarınızı ve<br />
            sunumlarınızı iletebilirsiniz.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- The existing Form Component handles the actual form -->
  <div class="pb-24 bg-white">
    <Form />
  </div>

  <!-- Map / Location Visuals (Abstract) -->
  <section
    class="h-[30vh] min-h-[300px] w-full relative bg-[#f8fafc] flex items-center justify-center overflow-hidden border-t-4 border-black retro-grid"
  >
    <!-- Simulating a stylized digital map / radar -->
    <div class="absolute inset-0 flex items-center justify-center opacity-30">
      <div
        class="absolute w-[800px] h-[800px] rounded-full border border-black/5 animate-[ping_4s_cubic-bezier(0,0,0.2,1)_infinite]"
      >
      </div>
      <div
        class="absolute w-[600px] h-[600px] rounded-full border border-black/5 animate-[ping_4s_cubic-bezier(0,0,0.2,1)_infinite]"
        style="animation-delay: 1s"
      >
      </div>
      <div
        class="absolute w-[400px] h-[400px] rounded-full border border-black/10"
      >
      </div>
      <div
        class="absolute w-[200px] h-[200px] rounded-full border border-black/20"
      >
      </div>
    </div>
  </section>
</MainLayout>

<script>
  import AOS from "aos";
  document.addEventListener("DOMContentLoaded", () => {
    AOS.init({
      duration: 1000,
      once: true,
      easing: "ease-out-cubic",
    });
  });
</script>

