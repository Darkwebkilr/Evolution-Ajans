---
import { getCollection, render } from "astro:content";
import MainLayout from "../../layout/mainLayout.astro";

export async function getStaticPaths() {
  const allPosts = await getCollection("blog", ({ data }) => {
    return !data.isDraft;
  });
  return allPosts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const currentUrl = `https://evolutionajans.com/blog/${post.id}/`;

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Ana Sayfa",
      "item": "https://evolutionajans.com/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Blog",
      "item": "https://evolutionajans.com/blog/"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": post.data.title,
      "item": currentUrl
    }
  ]
};

const blogPostingSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": post.data.title,
  "description": post.data.description,
  "url": currentUrl,
  "datePublished": new Date(post.data.pubDate).toISOString(),
  "dateModified": new Date(post.data.pubDate).toISOString(),
  "author": {
    "@type": "Organization",
    "name": post.data.author || "Evolution Ajans",
    "url": "https://evolutionajans.com/"
  },
  "publisher": {
    "@type": "Organization",
    "name": "Evolution Ajans",
    "logo": {
      "@type": "ImageObject",
      "url": "https://evolutionajans.com/img/Logo.png"
    }
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": currentUrl
  }
};
---

<MainLayout
  title={`${post.data.title} | Evolution Ajans Blog`}
  description={post.data.description}
  image={post.data.image}
  type="article"
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(blogPostingSchema)} />

  <div class="container mx-auto px-6 py-20 md:py-32">
    <!-- Breadcrumb Nav -->
    <nav class="max-w-4xl mx-auto mb-8 font-mono text-xs text-black/60 flex items-center gap-2 flex-wrap">
      <a href="/" class="hover:text-black underline underline-offset-2">Ana Sayfa</a>
      <span>/</span>
      <a href="/blog/" class="hover:text-black underline underline-offset-2">Blog</a>
      <span>/</span>
      <span class="text-black font-bold truncate max-w-xs">{post.data.title}</span>
    </nav>

    <article class="max-w-4xl mx-auto bg-white border-4 border-black p-6 sm:p-10 md:p-14 shadow-[8px_8px_0px_0px_rgba(0,0,0,1)]">
      <!-- Metadata Bar -->
      <div class="text-[10px] font-mono text-black/60 font-pixel mb-6 pb-4 border-b-2 border-black/10 flex justify-between items-center flex-wrap gap-2">
        <div class="flex items-center gap-3">
          <span class="bg-black text-white px-2 py-0.5 uppercase tracking-wider font-bold">Blog</span>
          <span>Yazar: <strong>{post.data.author}</strong></span>
        </div>
        <span>Yayın Tarihi: {new Date(post.data.pubDate).toLocaleDateString("tr-TR", { day: "numeric", month: "long", year: "numeric" })}</span>
      </div>

      <!-- Article Title -->
      <h1 class="text-2xl sm:text-3xl md:text-4xl font-black text-black mb-8 tracking-tight leading-tight font-pixel uppercase">
        {post.data.title}
      </h1>

      <!-- Tags if present -->
      {post.data.tags && post.data.tags.length > 0 && (
        <div class="flex flex-wrap gap-2 mb-8">
          {post.data.tags.map((tag: string) => (
            <span class="text-[10px] font-mono uppercase bg-slate-100 text-black border border-black/20 px-2.5 py-1">
              #{tag}
            </span>
          ))}
        </div>
      )}

      <!-- Article Body -->
      <div class="article-content max-w-none text-black font-mono">
        <Content />
      </div>

      <!-- Conversion Box at the end of article -->
      <div class="mt-12 p-6 sm:p-8 bg-black text-white border-4 border-black relative overflow-hidden">
        <h3 class="text-lg sm:text-xl font-black font-pixel uppercase tracking-tight mb-3">
          İşletmenizi Dijitalde Bir Adım Öne Taşıyalım
        </h3>
        <p class="text-white/80 font-mono text-xs sm:text-sm leading-relaxed mb-6 max-w-2xl">
          Evolution Ajans olarak İzmir ve tüm Türkiye'deki işletmelere özel SEO, kurumsal web tasarım ve Google Ads reklam yönetimi hizmetleri sunuyoruz. Ücretsiz dijital analiz için hemen iletişime geçin.
        </p>
        <div class="flex flex-wrap gap-4">
          <a
            href="/iletisim/"
            class="inline-block bg-white text-black font-pixel font-black text-xs uppercase px-6 py-3 border-2 border-white hover:bg-black hover:text-white transition-all shadow-[4px_4px_0px_0px_rgba(255,255,255,0.4)]"
          >
            Ücretsiz Teklif Al →
          </a>
          <a
            href="https://wa.me/905519283598"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-block bg-emerald-500 text-white font-pixel font-black text-xs uppercase px-6 py-3 border-2 border-emerald-400 hover:bg-emerald-600 transition-all shadow-[4px_4px_0px_0px_rgba(0,0,0,0.4)]"
          >
            WhatsApp ile Danış →
          </a>
        </div>
      </div>

      <!-- Navigation footer -->
      <div class="mt-10 pt-6 border-t-2 border-black/10 flex justify-between items-center">
        <a href="/blog/" class="font-pixel text-xs font-black uppercase text-black hover:underline underline-offset-4 flex items-center gap-2">
          ← Tüm Blog Yazılarına Dön
        </a>
      </div>
    </article>
  </div>
</MainLayout>

<style is:global>
  .article-content h2 {
    font-family: var(--font-pixel);
    font-size: 1.35rem;
    font-weight: 800;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    line-height: 1.3;
    border-left: 4px solid #000;
    padding-left: 0.75rem;
    text-transform: uppercase;
    color: #000;
  }
  @media (min-width: 640px) {
    .article-content h2 {
      font-size: 1.6rem;
    }
  }
  .article-content h3 {
    font-family: var(--font-pixel);
    font-size: 1.15rem;
    font-weight: 700;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    line-height: 1.3;
    color: #000;
  }
  .article-content p {
    margin-bottom: 1.25rem;
    line-height: 1.85;
    font-size: 0.95rem;
    color: #1f2937;
  }
  .article-content ul, .article-content ol {
    margin-bottom: 1.5rem;
    padding-left: 1.5rem;
  }
  .article-content ul {
    list-style-type: square;
  }
  .article-content ol {
    list-style-type: decimal;
  }
  .article-content li {
    margin-bottom: 0.5rem;
    line-height: 1.75;
    font-size: 0.92rem;
    color: #1f2937;
  }
  .article-content a {
    color: #2563eb;
    text-decoration: underline;
    text-underline-offset: 4px;
    font-weight: 700;
    transition: color 0.2s ease;
  }
  .article-content a:hover {
    color: #1d4ed8;
  }
  .article-content strong {
    font-weight: 700;
    color: #000;
  }
  .article-content hr {
    border-color: #e2e8f0;
    border-width: 2px;
    margin: 2.5rem 0;
  }
</style>
