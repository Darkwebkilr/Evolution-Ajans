---
import { getCollection, render } from "astro:content";
import MainLayout from "../../layout/mainLayout.astro";

export async function getStaticPaths() {
  const allPosts = await getCollection("blog", ({ data }) => {
    return !data.isDraft;
  });
  return allPosts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const currentUrl = `https://evolutionajans.com/blog/${post.id}/`;

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Ana Sayfa",
      "item": "https://evolutionajans.com/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Blog",
      "item": "https://evolutionajans.com/blog/"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": post.data.title,
      "item": currentUrl
    }
  ]
};

const blogPostingSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": post.data.title,
  "description": post.data.description,
  "url": currentUrl,
  "datePublished": new Date(post.data.pubDate).toISOString(),
  "dateModified": post.data.updatedDate ? new Date(post.data.updatedDate).toISOString() : new Date(post.data.pubDate).toISOString(),
  "author": {
    "@type": "Organization",
    "name": post.data.author || "Evolution Ajans",
    "url": "https://evolutionajans.com/"
  },
  "publisher": {
    "@type": "Organization",
    "name": "Evolution Ajans",
    "logo": {
      "@type": "ImageObject",
      "url": "https://evolutionajans.com/img/Logo.png"
    }
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": currentUrl
  }
};
---

<MainLayout
  title={`${post.data.title} | Evolution Ajans Blog`}
  description={post.data.description}
  image={post.data.image}
  type="article"
  datePublished={new Date(post.data.pubDate).toISOString()}
  dateModified={post.data.updatedDate ? new Date(post.data.updatedDate).toISOString() : new Date(post.data.pubDate).toISOString()}
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(blogPostingSchema)} />

  <div class="container mx-auto px-6 py-20 md:py-32">
    <!-- Breadcrumb Nav -->
    <nav class="max-w-4xl mx-auto mb-8 font-mono text-xs text-black/60 flex items-center gap-2 flex-wrap">
      <a href="/" class="hover:text-black underline underline-offset-2">Ana Sayfa</a>
      <span>/</span>
      <a href="/blog/" class="hover:text-black underline underline-offset-2">Blog</a>
      <span>/</span>
      <span class="text-black font-bold truncate max-w-xs">{post.data.title}</span>
    </nav>

    <article class="max-w-4xl mx-auto bg-white border border-[#181816]/12 rounded-[28px] p-8 sm:p-12 md:p-16 shadow-[0_4px_30px_rgba(24,24,22,0.03)]">
      <!-- Metadata Bar -->
      <div class="text-xs font-mono text-[#6E6A62] mb-8 pb-5 border-b border-dashed border-[#181816]/15 flex justify-between items-center flex-wrap gap-3">
        <div class="flex items-center gap-3">
          <span class="bg-[#EBF0E6] text-[#536248] px-2.5 py-0.5 uppercase tracking-wider text-[10px] rounded-full">Blog</span>
          <span>Yazar: <strong>{post.data.author}</strong></span>
        </div>
        <div class="flex items-center gap-3 flex-wrap">
          <span>Yayın: <time datetime={new Date(post.data.pubDate).toISOString()} itemprop="datePublished">{new Date(post.data.pubDate).toLocaleDateString("tr-TR", { day: "numeric", month: "long", year: "numeric" })}</time></span>
          <span>•</span>
          <span>Güncelleme: <time datetime={post.data.updatedDate ? new Date(post.data.updatedDate).toISOString() : new Date(post.data.pubDate).toISOString()} itemprop="dateModified">{new Date(post.data.updatedDate || post.data.pubDate).toLocaleDateString("tr-TR", { day: "numeric", month: "long", year: "numeric" })}</time></span>
        </div>
      </div>

      <!-- Article Title -->
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-serif text-[#181816] mb-8 tracking-tight leading-tight">
        {post.data.title}
      </h1>

      <!-- Tags if present -->
      {post.data.tags && post.data.tags.length > 0 && (
        <div class="flex flex-wrap gap-2 mb-8">
          {post.data.tags.map((tag: string) => (
            <span class="text-[10px] font-mono uppercase bg-slate-100 text-black border border-black/20 px-2.5 py-1">
              #{tag}
            </span>
          ))}
        </div>
      )}

      <!-- Article Body -->
      <div class="article-content max-w-none text-[#34322E] font-sans leading-relaxed">
        <Content />
      </div>

      <!-- Conversion Box at the end of article -->
      <div class="mt-16 p-8 sm:p-10 bg-[#FAEDE8] border border-[#BE5836]/30 rounded-[24px] relative overflow-hidden">
        <h3 class="text-2xl font-serif text-[#181816] tracking-tight mb-3">
          İşletmenizi Dijitalde Bir Adım Öne Taşıyalım
        </h3>
        <p class="text-[#4A4742] text-sm leading-relaxed mb-6 max-w-2xl font-sans">
          Evolution Ajans olarak İzmir ve tüm Türkiye'deki işletmelere özel SEO, kurumsal web tasarım ve Google Ads reklam yönetimi hizmetleri sunuyoruz. Ücretsiz dijital analiz için hemen iletişime geçin.
        </p>
        <div class="flex flex-wrap gap-4">
          <a
            href="/iletisim/"
            class="inline-block bg-[#BE5836] text-white text-xs uppercase tracking-widest font-medium px-6 py-3 rounded-full hover:bg-[#9E4324] transition-all shadow-sm"
          >
            Ücretsiz Teklif Al →
          </a>
          <a
            href="https://wa.me/905519283598"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-block bg-white border border-[#181816]/15 text-[#181816] text-xs uppercase tracking-widest font-medium px-6 py-3 rounded-full hover:bg-[#F3EFE6] transition-all shadow-sm"
          >
            WhatsApp ile Danış →
          </a>
        </div>
      </div>

      <!-- Navigation footer -->
      <div class="mt-12 pt-6 border-t border-dashed border-[#181816]/15 flex justify-between items-center">
        <a href="/blog/" class="text-xs font-mono uppercase text-[#181816] hover:text-[#BE5836] transition-colors flex items-center gap-2">
          ← Tüm Blog Yazılarına Dön
        </a>
      </div>
    </article>
  </div>
</MainLayout>

<style is:global>
  .article-content h2 {
    font-family: var(--font-pixel);
    font-size: 1.35rem;
    font-weight: 800;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    line-height: 1.3;
    border-left: 4px solid #000;
    padding-left: 0.75rem;
    text-transform: uppercase;
    color: #000;
  }
  @media (min-width: 640px) {
    .article-content h2 {
      font-size: 1.6rem;
    }
  }
  .article-content h3 {
    font-family: var(--font-pixel);
    font-size: 1.15rem;
    font-weight: 700;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    line-height: 1.3;
    color: #000;
  }
  .article-content p {
    margin-bottom: 1.25rem;
    line-height: 1.85;
    font-size: 0.95rem;
    color: #1f2937;
  }
  .article-content ul, .article-content ol {
    margin-bottom: 1.5rem;
    padding-left: 1.5rem;
  }
  .article-content ul {
    list-style-type: square;
  }
  .article-content ol {
    list-style-type: decimal;
  }
  .article-content li {
    margin-bottom: 0.5rem;
    line-height: 1.75;
    font-size: 0.92rem;
    color: #1f2937;
  }
  .article-content a {
    color: #2563eb;
    text-decoration: underline;
    text-underline-offset: 4px;
    font-weight: 700;
    transition: color 0.2s ease;
  }
  .article-content a:hover {
    color: #1d4ed8;
  }
  .article-content strong {
    font-weight: 700;
    color: #000;
  }
  .article-content hr {
    border-color: #e2e8f0;
    border-width: 2px;
    margin: 2.5rem 0;
  }
</style>
