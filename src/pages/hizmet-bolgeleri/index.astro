---
import MainLayout from "../../layout/mainLayout.astro";
import { districts } from "../../components/data/districts.js";
import { Icon } from "astro-icon/components";

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Ana Sayfa",
      "item": "https://evolutionajans.com/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Hizmet Bölgeleri",
      "item": "https://evolutionajans.com/hizmet-bolgeleri/"
    }
  ]
};

const collectionPageSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "İzmir Hizmet Bölgelerimiz - Evolution Ajans",
  "description": "İzmir'in 30 ilçesi için yerel SEO, web tasarım ve Google Haritalar optimizasyon çözümleri.",
  "url": "https://evolutionajans.com/hizmet-bolgeleri/",
  "isPartOf": {
    "@type": "WebSite",
    "url": "https://evolutionajans.com"
  }
};
---

<MainLayout 
  title="İzmir Hizmet Bölgelerimiz | Yerel SEO ve Web Tasarım - Evolution Ajans"
  description="İzmir genelinde 30 ilçede Google Ads, Meta Ads, Web Tasarım ve Harita SEO çözümlerimizle yerel işletmenizi büyütüyoruz. İlçenizi seçerek detaylı çözümleri inceleyin."
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(collectionPageSchema)} />

  <section class="py-20 md:py-28 bg-[#FBF9F5] relative z-10 border-b border-dashed border-[#181816]/15">
    <div class="max-w-7xl mx-auto px-6">
      
      <!-- Page Header -->
      <div class="text-center mb-20 space-y-6">
        <div class="inline-flex items-center gap-3 px-4 py-2 border-2 border-black bg-black text-white" data-aos="fade-down">
          <span class="w-2 h-2 rounded-full bg-blue-500 animate-ping"></span>
          <span class="text-xs font-mono uppercase tracking-[0.2em] font-bold font-pixel">YEREL HİZMET REHBERİ</span>
        </div>
        <h1 class="text-4xl md:text-6xl font-black uppercase tracking-tighter text-black" data-aos="fade-up" data-aos-delay="100">
          İZMİR HİZMET BÖLGELERİMİZ
        </h1>
        <p class="text-[#6E6A62] max-w-2xl mx-auto text-base sm:text-lg leading-relaxed font-sans" data-aos="fade-up" data-aos-delay="200">
          İzmir'in 30 ilçesindeki yerel hizmet işletmeleri, esnaflar ve sanayi kuruluşları için özel olarak kurguladığımız dijital büyüme, reklam ve Google Harita optimizasyonu çözümleri.
        </p>
      </div>

      <!-- Districts Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-3 gap-6" data-aos="fade-up" data-aos-delay="300">
        {districts.map((dist) => (
          <a 
            href={`/hizmet-bolgeleri/${dist.slug}/`} 
            class="group bg-white border border-[#181816]/12 rounded-[20px] p-6 shadow-[0_2px_12px_rgba(24,24,22,0.02)] hover:border-[#BE5836]/40 hover:-translate-y-0.5 transition-all duration-300 flex flex-col justify-between"
          >
            <div class="space-y-3">
              <div class="flex items-center justify-between gap-2 border-b-2 border-black/10 pb-2">
                <span class="text-[10px] font-mono text-[#536248] uppercase bg-[#EBF0E6] px-2.5 py-0.5 rounded-full">
                  Yerel SEO
                </span>
                <span class="text-[10px] font-mono text-[#BE5836] uppercase">
                  4 Hizmet Sayfası
                </span>
              </div>
              <h2 class="text-2xl font-serif text-[#181816] tracking-tight group-hover:text-[#BE5836] transition-colors">
                {dist.name}
              </h2>
              <p class="text-xs text-[#6E6A62] font-sans">
                Google Haritalar SEO, Google Ads & Web Tasarım
              </p>
              <div class="flex flex-wrap gap-1 pt-1">
                <span class="text-[10px] font-mono px-2 py-0.5 bg-slate-100 border border-black/20 text-black/80">
                  Local Pack SEO
                </span>
                <span class="text-[10px] font-mono px-2 py-0.5 bg-slate-100 border border-black/20 text-black/80">
                  Google & Meta Ads
                </span>
              </div>
            </div>

            <div class="mt-6 pt-4 border-t border-[#181816]/8 flex items-center justify-between text-xs font-mono text-[#6E6A62] group-hover:text-[#BE5836]">
              <span>{dist.name} Çözümleri</span>
              <div class="w-7 h-7 border-2 border-black bg-[#facc15] flex items-center justify-center transition-all group-hover:translate-x-1">
                <Icon name="mdi:arrow-right" size={16} class="text-black" />
              </div>
            </div>
          </a>
        ))}
      </div>

    </div>
  </section>
</MainLayout>
