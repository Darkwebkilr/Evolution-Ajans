---
import MainLayout from "../../../layout/mainLayout.astro";
import { districts } from "../../../components/data/districts.js";
import { Icon } from "astro-icon/components";

export async function getStaticPaths() {
  const servicesList = [
    {
      slug: "web-tasarim",
      name: "Web Tasarım",
      title: "Yüksek Dönüşümlü Web Tasarım (Landing Page)",
      icon: "mdi:xml",
      color: "bg-amber-500/10 text-amber-600 border-amber-500/20",
      description: "Şimşek hızında açılan, mobil uyumlu ve telefon çaldıran neo-brutalist tek sayfalık açılış sayfaları."
    },
    {
      slug: "reklam-yonetimi",
      name: "Reklam Yönetimi",
      title: "Google & Meta Reklam Yönetimi",
      icon: "mdi:google-ads",
      color: "bg-blue-500/10 text-blue-600 border-blue-500/20",
      description: "Nokta atışı hedefleme ile bütçenizi koruyan, doğrudan iş getiren arama ve form reklamları."
    },
    {
      slug: "google-haritalar-seo",
      name: "Google Haritalar SEO",
      title: "Google Haritalar SEO ve Yorum Optimizasyonu",
      icon: "mdi:map-marker-radius-outline",
      color: "bg-green-500/10 text-green-600 border-green-500/20",
      description: "Haritalarda ilk 3 sırada (Local Pack) yer alarak telefon aramalarınızı ve yol tariflerinizi katlama stratejisi."
    },
    {
      slug: "seo",
      name: "SEO",
      title: "SEO (Arama Motoru Optimizasyonu)",
      icon: "mdi:trending-up",
      color: "bg-purple-500/10 text-purple-600 border-purple-500/20",
      description: "Sektörel anahtar kelimelerde organik aramalarda zirveye çıkarak reklamsız sürdürülebilir müşteri kazanımı."
    }
  ];

  const paths = [];
  districts.forEach((dist) => {
    servicesList.forEach((srv) => {
      paths.push({
        params: { districtSlug: dist.slug, serviceSlug: srv.slug },
        props: { dist, srv, allServices: servicesList },
      });
    });
  });
  return paths;
}

const { dist, srv, allServices } = Astro.props;

// Filter out the current service to show others for internal linking
const otherServices = allServices.filter(s => s.slug !== srv.slug);
---

<MainLayout 
  title={`${dist.name} ${srv.name} Hizmeti - Yerel SEO ve Büyüme Çözümleri | Evolution Ajans`}
  description={`${dist.name} ilçesindeki işletmeler için profesyonel ${srv.name} çözümleri. Sektörünüzde öne çıkmak ve yeni müşteriler kazanmak için hemen analiz talep edin.`}
>
  <section class="py-32 bg-slate-50 relative z-10 retro-grid border-b-4 border-black">
    <div class="max-w-5xl mx-auto px-6">
      
      <!-- Breadcrumbs -->
      <nav class="flex items-center gap-2 text-xs md:text-sm font-mono text-black/50 mb-10 font-bold uppercase font-pixel" data-aos="fade-down">
        <a href="/" class="hover:text-black transition-colors">Anasayfa</a>
        <span>/</span>
        <a href="/hizmet-bolgeleri" class="hover:text-black transition-colors">Hizmet Bölgeleri</a>
        <span>/</span>
        <a href={`/hizmet-bolgeleri/${dist.slug}`} class="hover:text-black transition-colors">{dist.name}</a>
        <span>/</span>
        <span class="text-black">{srv.name}</span>
      </nav>

      <!-- Main Headline Info -->
      <div class="space-y-6 text-center md:text-left max-w-4xl">
        <div class="inline-flex items-center gap-3 px-4 py-2 border-2 border-black bg-black text-white" data-aos="fade-right">
          <span class="w-2 h-2 rounded-full bg-blue-500 animate-pulse"></span>
          <span class="text-xs font-mono uppercase tracking-[0.2em] font-bold font-pixel">{dist.name} / {srv.name}</span>
        </div>
        
        <h1 class="text-4xl md:text-6xl font-black uppercase tracking-tighter text-black leading-tight" data-aos="fade-up" data-aos-delay="100">
          {dist.name} {srv.title}
        </h1>
        
        <p class="text-black/85 text-xl md:text-2xl font-medium leading-relaxed font-mono pt-4" data-aos="fade-up" data-aos-delay="200">
          {dist.name} genelinde faaliyet gösteren esnaflar ve yerel firmalar için tasarlanmış, bütçeyi korurken doğrudan yeni müşteri aramaları getiren profesyonel {srv.name} çözümü.
        </p>
      </div>

    </div>
  </section>

  <!-- Deep localized SEO Copy -->
  <section class="py-24 bg-white relative z-10">
    <div class="max-w-4xl mx-auto px-6">
      
      <!-- Local copywriting blocks -->
      <div class="prose max-w-none space-y-8 text-black/80 text-lg md:text-xl leading-relaxed font-mono" data-aos="fade-up">
        
        <p>
          <strong>{dist.name}</strong> bölgesinde rekabet her geçen gün artıyor. Yerel müşteriler ihtiyaç duydukları hizmetleri (nakliyat, klima servisi, temizlik, altyapı vb.) bulmak için Google aramalarına ve harita uygulamalarına yöneliyor. Bu noktada profesyonel bir <strong>{srv.name}</strong> çalışması, potansiyel alıcıların rakipleriniz yerine doğrudan sizinle iletişim kurmasını sağlayan en önemli pazarlama tünelidir.
        </p>

        <div class="my-10 p-8 border-4 border-black bg-slate-50 shadow-[4px_4px_0px_rgba(0,0,0,1)]">
          <h3 class="text-xl md:text-2xl font-black uppercase text-black font-pixel mb-4 tracking-tight">
            Neden {dist.name} {srv.name} Çalışması?
          </h3>
          <ul class="list-disc pl-6 space-y-3 text-base md:text-lg">
            <li><strong>Lokal Arama Hacimleri:</strong> {dist.name} genelinde doğrudan sizin hizmetiniz için arama yapan yüksek dönüşümlü sıcak müşterileri hedefleriz.</li>
            <li><strong>Maksimum Bütçe Koruma:</strong> İlgisiz arama terimlerini ve komşu ilçelerden gelen gereksiz tıklamaları filtreleyerek genel harcamalarınızı optimize ederiz.</li>
            <li><strong>Dönüşüm Odaklı Yaklaşım:</strong> Sadece sitenize hit çekmekle kalmaz; gelen trafiği telefon aramalarına ve WhatsApp başvurularına yönlendirecek CTA kurgularını kurarız.</li>
          </ul>
        </div>

        <p>
          Evolution Ajans olarak, {dist.name} bölgesinin ticari dinamiklerini, en sık aranan kelime gruplarını ve rakip analizlerini titizlikle çıkartıyoruz. Hazırladığımız <strong>{srv.name}</strong> stratejisiyle, işletmenizin dijital görünürlüğünü organik olarak artırıyor ve bütçenizin her kuruşunun doğrudan size yeni bir iş olarak geri dönmesini hedefliyoruz.
        </p>

        <p>
          İster küçük bir esnaf olun ister büyük bir yerel marka, {dist.name} bölgesinde dijital hakimiyet kurmak ve rakiplerinizin önüne geçmek için bizimle iletişime geçebilirsiniz. İşletmenizin dijital altyapısını ücretsiz inceleyip tüm eksiklikleri telefon görüşmemizde aktarmaktan memnuniyet duyarız.
        </p>

      </div>

      <!-- Action Button Area -->
      <div class="mt-16 pt-12 border-t-2 border-black/10 text-center font-pixel" data-aos="fade-up">
        <a 
          href="/#iletisim" 
          class="group relative inline-flex items-center justify-center gap-4 px-8 py-5 border-2 border-black bg-[#facc15] text-black font-bold uppercase tracking-widest text-sm sm:text-base hover:-translate-x-[4px] hover:-translate-y-[4px] hover:shadow-[6px_6px_0px_0px_rgba(0,0,0,1)] active:translate-x-0 active:translate-y-0 active:shadow-none shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] transition-all"
        >
          <span>{dist.name} {srv.name} Analizimi İste</span>
          <Icon name="mdi:send" size={18} />
        </a>
      </div>

    </div>
  </section>

  <!-- Cross-Linking / Internal links to other services in same district -->
  <section class="py-20 bg-slate-50 border-t-4 border-black relative z-10 retro-grid">
    <div class="max-w-5xl mx-auto px-6">
      
      <div class="mb-12 border-l-4 border-black pl-6 space-y-2">
        <span class="text-xs font-mono uppercase tracking-[0.2em] text-black/50 block font-pixel">BÖLGESEL ÇÖZÜMLER</span>
        <h2 class="text-3xl md:text-4xl font-black uppercase tracking-tighter text-black font-pixel">
          {dist.name} İlçesindeki Diğer Odak Hizmetlerimiz
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {otherServices.map((service, index) => (
          <a 
            href={`/hizmet-bolgeleri/${dist.slug}/${service.slug}`}
            class="group bg-white border-4 border-black p-6 rounded-none shadow-[4px_4px_0px_rgba(0,0,0,1)] hover:-translate-x-[4px] hover:-translate-y-[4px] hover:shadow-[6px_6px_0px_rgba(0,0,0,1)] active:translate-x-0 active:translate-y-0 active:shadow-none transition-all duration-300 flex flex-col justify-between"
            data-aos="fade-up"
            data-aos-delay={index * 100}
          >
            <div class="space-y-4">
              <div class="flex items-center gap-3">
                <div class="w-10 h-10 border-2 border-black rounded-none flex items-center justify-center bg-black/5 text-black">
                  <Icon name={service.icon} size={20} />
                </div>
                <h4 class="text-lg font-black uppercase text-black font-pixel tracking-tight">
                  {service.name}
                </h4>
              </div>
              <p class="text-black/75 text-sm md:text-base font-mono leading-relaxed">
                {service.description}
              </p>
            </div>
            <div class="mt-6 pt-4 border-t border-black/5 flex items-center justify-between text-xs uppercase font-pixel tracking-wider text-black/50 group-hover:text-blue-600 transition-colors">
              <span>İncele</span>
              <Icon name="mdi:arrow-right" size={14} class="group-hover:translate-x-1 transition-transform" />
            </div>
          </a>
        ))}
      </div>

    </div>
  </section>
</MainLayout>

<script>
  import AOS from "aos";
  document.addEventListener("DOMContentLoaded", () => {
    AOS.init({
      duration: 1000,
      once: true,
      easing: 'ease-out-cubic'
    });
  });
</script>
