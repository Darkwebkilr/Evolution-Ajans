---
import MainLayout from "../../layout/mainLayout.astro";
import { districts } from "../../components/data/districts.js";
import { Icon } from "astro-icon/components";

export async function getStaticPaths() {
  return districts.map((dist) => ({
    params: { slug: dist.slug },
    props: { dist },
  }));
}

const { dist } = Astro.props;

const localServices = [
  {
    slug: "google-haritalar-seo",
    title: `${dist.name} Google Haritalar SEO & Yorum Optimizasyonu`,
    description: `${dist.name} genelinde yerel esnaf ve kurumsal işletmeler için Google Haritalar (GMB) kaydınızı A'dan Z'ye optimize ediyoruz. Bölgeden arama yapan müşterilerin karşısına ilk 3 sırada (Local 3-Pack) çıkarak telefon aramalarınızı ve yol tarifi taleplerinizi hızla artırıyoruz.`,
    icon: "mdi:map-marker-radius-outline",
    color: "bg-green-500/10 text-green-600 border-green-500/20"
  },
  {
    slug: "reklam-yonetimi",
    title: `${dist.name} Reklam Yönetimi (Google Ads & Meta)`,
    description: `Sadece ${dist.name} ilçe sınırları ve yakın çevresindeki müşterileri hedefleyen nokta atışı Google Arama Ağı ve Instagram reklamları kurguluyoruz. Bütçenizi boşa harcayan alakasız tıklamaları negatif anahtar kelimelerle eliyor, harcadığınız her bütçenin doğrudan nitelikli iş talebine dönüşmesini sağlıyoruz.`,
    icon: "mdi:google-ads",
    color: "bg-blue-500/10 text-blue-600 border-blue-500/20"
  },
  {
    slug: "web-tasarim",
    title: `${dist.name} Yüksek Dönüşümlü Web Tasarım (Landing Page)`,
    description: `${dist.name} bölgesinde arama yapan kullanıcıların doğrudan WhatsApp'tan yazmasını veya telefonla aramasını sağlayan ultra hızlı açılış sayfaları (Landing Page) tasarlıyoruz. Karmaşık ve yavaş sitelerin aksine, mobil uyumlu, modern ve doğrudan satış getirmeye odaklı altyapılar inşa ediyoruz.`,
    icon: "mdi:xml",
    color: "bg-amber-500/10 text-amber-600 border-amber-500/20"
  },
  {
    slug: "seo",
    title: `${dist.name} SEO (Arama Motoru Optimizasyonu)`,
    description: `${dist.name} odaklı sektörel aramalarda reklam vermeseniz dahi web sitenizin en üst sıralarda yer alması için kapsamlı teknik ve bölgesel SEO çalışması yapıyoruz. Yerel anahtar kelime eşleşmeleri, backlink stratejileri ve içerik mimarisi ile uzun vadeli organik müşteri akışı kuruyoruz.`,
    icon: "mdi:trending-up",
    color: "bg-purple-500/10 text-purple-600 border-purple-500/20"
  }
];

// Nearby & Other districts for intelligent mesh linking
const nearbyDistricts = (dist.nearby || [])
  .map(slug => districts.find(d => d.slug === slug))
  .filter(Boolean);

const otherDistricts = districts.filter(d => d.slug !== dist.slug && !(dist.nearby || []).includes(d.slug));

// Schemas
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Anasayfa",
      "item": "https://evolutionajans.com/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Hizmet Bölgeleri",
      "item": "https://evolutionajans.com/hizmet-bolgeleri/"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": dist.name,
      "item": `https://evolutionajans.com/hizmet-bolgeleri/${dist.slug}/`
    }
  ]
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": (dist.localFaqs || []).map(faq => ({
    "@type": "Question",
    "name": faq.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.a
    }
  }))
};

const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  "name": `Evolution Ajans - ${dist.name} Dijital Pazarlama ve Web Tasarım`,
  "url": `https://evolutionajans.com/hizmet-bolgeleri/${dist.slug}/`,
  "telephone": "+905519283598",
  "priceRange": "₺₺",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": dist.name,
    "addressRegion": "İzmir",
    "addressCountry": "TR"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": dist.coordinates?.lat || "38.4192",
    "longitude": dist.coordinates?.lng || "27.1287"
  },
  "areaServed": {
    "@type": "AdministrativeArea",
    "name": dist.name
  },
  ...(dist.localReview ? {
    "aggregateRating": {
      "@type": "AggregateRating",
      "ratingValue": "5.0",
      "reviewCount": "1",
      "bestRating": "5",
      "worstRating": "1"
    },
    "review": [
      {
        "@type": "Review",
        "author": {
          "@type": "Person",
          "name": dist.localReview.author || dist.localReview.client
        },
        "datePublished": dist.localReview.date || "2026-08-15",
        "reviewBody": dist.localReview.quote,
        "reviewRating": {
          "@type": "Rating",
          "ratingValue": String(dist.localReview.rating || 5),
          "bestRating": "5",
          "worstRating": "1"
        }
      }
    ]
  } : {})
};
---

<MainLayout 
  title={`${dist.name} Web Tasarım, SEO ve Google Reklam Yönetimi | Evolution Ajans`}
  description={`${dist.name} bölgesindeki işletmeniz için profesyonel Web Tasarım, Google Haritalar SEO, Google Ads ve Meta Reklam Yönetimi. Yerel aramalarda zirveye çıkın.`}
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />

  <!-- Hero Section -->
  <section class="py-24 md:py-32 bg-slate-50 relative z-10 retro-grid border-b-4 border-black">
    <div class="max-w-5xl mx-auto px-6 text-center space-y-6">
      
      <!-- Top badges -->
      <div class="flex flex-wrap items-center justify-center gap-3" data-aos="fade-down">
        <div class="inline-flex items-center gap-2 px-3 py-1.5 border-2 border-black bg-black text-white font-pixel text-xs uppercase tracking-wider">
          <span class="w-2 h-2 rounded-full bg-[#25D366] animate-ping"></span>
          <span>{dist.name} Yerel SEO & Dijital Büyüme</span>
        </div>
        <div class="inline-flex items-center gap-2 px-3 py-1.5 border-2 border-black bg-[#facc15] text-black font-pixel text-xs uppercase tracking-wider font-bold">
          <span>Google Harita & Reklam Çözümleri</span>
        </div>
      </div>

      <h1 class="text-4xl md:text-6xl font-black uppercase tracking-tighter text-black leading-tight" data-aos="fade-up" data-aos-delay="100">
        {dist.name} Web Tasarım, SEO ve Google Reklam Yönetimi
      </h1>

      <p class="text-black/85 max-w-3xl mx-auto text-lg md:text-2xl font-medium leading-relaxed font-mono" data-aos="fade-up" data-aos-delay="200">
        {dist.name} genelinde faaliyet gösteren işletmeniz için boşa harcanan bütçelere son veriyoruz. Nokta atışı Google & Meta reklamları, Harita SEO ve şimşek hızında dönüşüm sayfaları ile sizi bölgenin lideri yapıyoruz.
      </p>

      <div class="flex flex-col sm:flex-row gap-4 sm:gap-6 justify-center pt-6 font-pixel" data-aos="fade-up" data-aos-delay="300">
        <a href="/#iletisim" class="group relative inline-flex items-center justify-center gap-3 px-8 py-4 border-2 border-black bg-[#facc15] text-black font-bold uppercase tracking-widest text-xs sm:text-sm hover:-translate-x-[4px] hover:-translate-y-[4px] hover:shadow-[6px_6px_0px_0px_rgba(0,0,0,1)] active:translate-x-0 active:translate-y-0 active:shadow-none shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] transition-all">
          <span>Ücretsiz {dist.name} SEO Analizi Al</span>
          <Icon name="mdi:arrow-right" size={18} class="group-hover:translate-x-1 transition-transform" />
        </a>
        <a href="/hizmet-bolgeleri/" class="group relative inline-flex items-center justify-center gap-3 px-8 py-4 border-2 border-black bg-white text-black font-bold uppercase tracking-widest text-xs sm:text-sm hover:-translate-x-[4px] hover:-translate-y-[4px] hover:shadow-[6px_6px_0px_0px_rgba(0,0,0,1)] active:translate-x-0 active:translate-y-0 active:shadow-none shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] transition-all">
          <span>Tüm Hizmet Bölgeleri</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Local SEO & Growth Strategy -->
  <section class="py-20 bg-white border-b-4 border-black relative z-10">
    <div class="max-w-5xl mx-auto px-6">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
        
        <!-- Left: SEO Strategy Text -->
        <div class="lg:col-span-7 space-y-6" data-aos="fade-right">
          <div class="border-l-4 border-black pl-4">
            <span class="text-xs font-mono uppercase tracking-[0.2em] text-black/50 block font-pixel">YEREL SEO STRATEJİSİ</span>
            <h2 class="text-2xl md:text-4xl font-black uppercase tracking-tight text-black font-pixel">
              {dist.name} Bölgesinde Google'da İlk Sıraya Çıkma Rehberi
            </h2>
          </div>
          
          <p class="text-black/80 text-base md:text-lg leading-relaxed font-mono">
            <strong>{dist.name}</strong> bölgesinde hizmet veya ürün arayan potansiyel müşterilerin %85'inden fazlası doğrudan akıllı telefonlarından Google Arama ve Google Haritalar sonuçlarına başvurmaktadır. Arama çubuğuna yazılan "{dist.name} en yakın servis", "{dist.name} ustası" veya "{dist.name} fiyatları" gibi ticari niyetli sorgularda ilk sayfada yer almayan işletmeler, her gün hazır müşterilerini doğrudan rakiplerine kaptırmaktadır.
          </p>

          <p class="text-black/80 text-base md:text-lg leading-relaxed font-mono">
            {dist.name} genelinde faaliyet gösteren firmalar için en büyük risk, genel geçer reklam stratejileriyle komşu ilçelerden veya alakasız aramalardan gereksiz maliyet üretmektir. Biz; <strong>{dist.name}</strong> pazarının yerel dinamiklerine, arama alışkanlıklarına ve sektörel rekabetine özel stratejiler kurgulayarak reklam bütçenizi korur, organik sıralamalarda kalıcı yer edinmenizi sağlarız.
          </p>

          <div class="pt-4 grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div class="p-4 border-2 border-black bg-slate-50">
              <span class="font-pixel text-xs font-bold uppercase text-black block mb-1">Nokta Atışı Konum</span>
              <p class="text-xs font-mono text-black/70">Yalnızca {dist.name} ve hizmet sınırlarınızdaki gerçek müşterilere bütçe harcanır.</p>
            </div>
            <div class="p-4 border-2 border-black bg-slate-50">
              <span class="font-pixel text-xs font-bold uppercase text-black block mb-1">Kalıcı Organik Trafik</span>
              <p class="text-xs font-mono text-black/70">Reklam bütçeniz dursa dahi 1. sayfa organik sıralamalardan müşteri akışı devam eder.</p>
            </div>
          </div>
        </div>

        <!-- Right: Real Customer Review Card with Stars, Date and Schema Verification -->
        <div class="lg:col-span-5 space-y-6" data-aos="fade-left">
          {dist.localReview && (
            <div class="p-6 md:p-8 border-4 border-black bg-[#fefce8] shadow-[6px_6px_0px_rgba(0,0,0,1)] space-y-4">
              <div class="flex items-center justify-between border-b-2 border-black/10 pb-3">
                <div class="flex items-center gap-1 text-amber-500">
                  <Icon name="mdi:star" size={22} />
                  <Icon name="mdi:star" size={22} />
                  <Icon name="mdi:star" size={22} />
                  <Icon name="mdi:star" size={22} />
                  <Icon name="mdi:star" size={22} />
                </div>
                <span class="text-xs font-mono font-bold text-black bg-white px-2.5 py-1 border border-black shadow-[2px_2px_0px_rgba(0,0,0,1)] font-pixel">
                  {dist.localReview.rating || 5}.0 / 5.0
                </span>
              </div>

              <p class="text-black/85 italic font-mono text-sm md:text-base leading-relaxed">
                "{dist.localReview.quote}"
              </p>

              <div class="pt-4 border-t-2 border-black/10 flex items-center justify-between">
                <div>
                  <h4 class="font-black text-sm uppercase text-black font-pixel">
                    {dist.localReview.author}
                  </h4>
                  <p class="text-xs font-mono text-black/70 font-semibold">
                    {dist.localReview.role} — {dist.localReview.client}
                  </p>
                </div>
                <div class="text-right">
                  <span class="text-[11px] font-mono text-black/50 block">
                    {dist.localReview.date}
                  </span>
                  <span class="inline-flex items-center gap-1 text-[10px] font-mono text-green-700 font-bold uppercase">
                    <Icon name="mdi:check-decagram" size={12} /> Doğrulanmış Müşteri
                  </span>
                </div>
              </div>
            </div>
          )}

          <!-- SEO Benefit Summary Box -->
          <div class="p-6 border-4 border-black bg-white shadow-[6px_6px_0px_rgba(0,0,0,1)] space-y-3">
            <h3 class="font-black uppercase text-base font-pixel text-black flex items-center gap-2">
              <Icon name="mdi:shield-check" size={20} class="text-blue-600" />
              {dist.name} Garantili SEO Süreci
            </h3>
            <ul class="space-y-2 text-xs font-mono text-black/80">
              <li class="flex items-start gap-2">
                <Icon name="mdi:check-bold" size={16} class="text-green-600 shrink-0 mt-0.5" />
                <span>Google Haritalar'da Local 3-Pack paketine yerleşim</span>
              </li>
              <li class="flex items-start gap-2">
                <Icon name="mdi:check-bold" size={16} class="text-green-600 shrink-0 mt-0.5" />
                <span>Negatif anahtar kelime filtreleriyle bütçe koruması</span>
              </li>
              <li class="flex items-start gap-2">
                <Icon name="mdi:check-bold" size={16} class="text-green-600 shrink-0 mt-0.5" />
                <span>1 saniyenin altında açılan dönüşüm odaklı tasarım</span>
              </li>
              <li class="flex items-start gap-2">
                <Icon name="mdi:check-bold" size={16} class="text-green-600 shrink-0 mt-0.5" />
                <span>Şeffaf aylık telefon çağrısı ve tıklama raporlaması</span>
              </li>
            </ul>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- 4 Core SEO Service Pages (Clickable & Independent Subpages) -->
  <section class="py-24 bg-slate-50 relative z-10 border-b-4 border-black">
    <div class="max-w-5xl mx-auto px-6">
      
      <!-- Section Header -->
      <div class="mb-16 border-l-4 border-black pl-6 space-y-2">
        <span class="text-xs font-mono uppercase tracking-[0.2em] text-black/50 block font-pixel">4 ANA HİZMET ALANI</span>
        <h2 class="text-3xl md:text-5xl font-black uppercase tracking-tighter text-black font-pixel">
          {dist.name} İçin Özel SEO & Reklam Sayfalarımız
        </h2>
        <p class="text-black/70 font-mono text-sm md:text-base max-w-2xl pt-2">
          {dist.name} pazarında firmanızı zirveye taşıyacak 4 temel büyüme kanalımız. İncelemek istediğiniz hizmetin üzerine tıklayarak detaylı rehber sayfasına gidebilirsiniz:
        </p>
      </div>

      <!-- Services Stack with Distinct Links -->
      <div class="space-y-8">
        {localServices.map((service, index) => (
          <a 
            href={`/hizmet-bolgeleri/${dist.slug}/${service.slug}/`}
            class="group block bg-white border-4 border-black p-8 md:p-10 rounded-none shadow-[4px_4px_0px_rgba(0,0,0,1)] hover:-translate-x-[2px] hover:-translate-y-[2px] hover:shadow-[6px_6px_0px_rgba(0,0,0,1)] transition-all duration-300 flex flex-col md:flex-row gap-8 items-start"
            data-aos="fade-up"
            data-aos-delay={index * 100}
          >
            <!-- Service Icon Box -->
            <div class={`w-16 h-16 shrink-0 border-2 border-black rounded-none flex items-center justify-center ${service.color}`}>
              <Icon name={service.icon} size={32} />
            </div>

            <!-- Service Info -->
            <div class="space-y-4 flex-1">
              <div class="flex items-center justify-between gap-4">
                <h3 class="text-2xl md:text-3xl font-black uppercase text-black font-pixel tracking-tight group-hover:text-blue-600 transition-colors">
                  {service.title}
                </h3>
                <Icon name="mdi:arrow-right" size={24} class="text-black group-hover:translate-x-2 transition-transform hidden md:block shrink-0" />
              </div>
              <p class="text-black/75 text-base md:text-lg leading-relaxed font-mono">
                {service.description}
              </p>
              <div class="pt-2 text-xs md:text-sm font-mono font-bold uppercase tracking-wider text-blue-600 group-hover:underline flex items-center gap-1 font-pixel">
                <span>{dist.name} {service.title.split(' ').slice(1).join(' ')} Sayfasına Git →</span>
                <Icon name="mdi:arrow-right" size={14} class="md:hidden" />
              </div>
            </div>
          </a>
        ))}
      </div>

    </div>
  </section>

  <!-- Localized FAQs Section (Unique to District with FAQ Schema) -->
  {dist.localFaqs && dist.localFaqs.length > 0 && (
    <section class="py-20 bg-white relative z-10 border-b-4 border-black">
      <div class="max-w-4xl mx-auto px-6">
        <div class="mb-12 border-l-4 border-black pl-6 space-y-2">
          <span class="text-xs font-mono uppercase tracking-[0.2em] text-black/50 block font-pixel">SIKÇA SORULAN SORULAR</span>
          <h2 class="text-3xl md:text-4xl font-black uppercase tracking-tighter text-black font-pixel">
            {dist.name} Dijital Pazarlama ve SEO Soruları
          </h2>
        </div>

        <div class="space-y-6">
          {dist.localFaqs.map((faq, index) => (
            <div 
              class="border-4 border-black p-6 md:p-8 bg-slate-50 shadow-[4px_4px_0px_rgba(0,0,0,1)]"
              data-aos="fade-up"
              data-aos-delay={index * 100}
            >
              <div class="flex items-start gap-4">
                <span class="w-8 h-8 bg-black text-white shrink-0 flex items-center justify-center font-pixel font-bold text-sm">
                  S{index + 1}
                </span>
                <div class="space-y-3 flex-1">
                  <h3 class="text-lg md:text-xl font-black uppercase text-black font-pixel">
                    {faq.q}
                  </h3>
                  <p class="text-black/80 text-sm md:text-base leading-relaxed font-mono">
                    {faq.a}
                  </p>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Nearby Districts Cross-Linking Mesh (First Priority) -->
  {nearbyDistricts.length > 0 && (
    <section class="py-16 bg-[#fefce8] border-b-4 border-black relative z-10">
      <div class="max-w-5xl mx-auto px-6">
        <div class="mb-8 border-l-4 border-black pl-4">
          <span class="text-xs font-mono uppercase tracking-[0.2em] text-black/60 block font-pixel">COĞRAFİ AĞ</span>
          <h3 class="text-xl md:text-2xl font-black uppercase tracking-tighter text-black font-pixel">
            {dist.name} Çevresindeki Komşu Hizmet Bölgelerimiz
          </h3>
          <p class="text-xs font-mono text-black/70 mt-1">
            {dist.name} ile ticari ve coğrafi bağı bulunan yakın hizmet noktalarımız:
          </p>
        </div>
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3">
          {nearbyDistricts.map((d) => (
            <a 
              href={`/hizmet-bolgeleri/${d.slug}/`}
              class="p-4 bg-white border-2 border-black font-bold text-black hover:bg-[#facc15] hover:-translate-x-[2px] hover:-translate-y-[2px] hover:shadow-[3px_3px_0px_rgba(0,0,0,1)] transition-all font-pixel text-center text-sm flex items-center justify-between"
            >
              <span>{d.name}</span>
              <Icon name="mdi:arrow-top-right" size={16} />
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- All Other Districts Cross-Linking Mesh -->
  <section class="py-16 bg-slate-50 border-b-4 border-black relative z-10">
    <div class="max-w-5xl mx-auto px-6">
      <div class="mb-8 border-l-4 border-black pl-4">
        <span class="text-xs font-mono uppercase tracking-[0.2em] text-black/50 block font-pixel">İZMİR HİZMET HARİTASI</span>
        <h3 class="text-xl md:text-2xl font-black uppercase tracking-tighter text-black font-pixel">
          İzmir'in Diğer 30 Hizmet Bölgesi
        </h3>
      </div>
      <div class="flex flex-wrap gap-2 text-xs font-mono">
        {otherDistricts.map((d) => (
          <a 
            href={`/hizmet-bolgeleri/${d.slug}/`}
            class="px-3 py-2 bg-white border-2 border-black font-bold text-black hover:bg-[#facc15] hover:-translate-x-[1px] hover:-translate-y-[1px] hover:shadow-[2px_2px_0px_rgba(0,0,0,1)] transition-all font-pixel"
          >
            {d.name}
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Lead Box -->
  <section class="py-20 bg-slate-100 relative z-10 retro-grid">
    <div class="max-w-4xl mx-auto px-6 text-center space-y-8">
      <h2 class="text-3xl md:text-5xl font-black uppercase tracking-tighter text-black font-pixel">
        Rakipleriniz {dist.name}'de Müşterileri Topluyor.
      </h2>
      <p class="text-black/85 text-lg md:text-xl font-medium leading-relaxed font-mono max-w-3xl mx-auto">
        Hemen bugün bilgilerinizi bırakın; {dist.name} pazarındaki web sitenizi, harita kaydınızı ve reklamlarınızı ücretsiz analiz edip size özel büyüme yol haritasını sunalım.
      </p>
      <div class="pt-4 font-pixel">
        <a 
          href="/#iletisim" 
