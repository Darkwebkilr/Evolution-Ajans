---
import MainLayout from "../../layout/mainLayout.astro";
import { districts } from "../../components/data/districts.js";
import { Icon } from "astro-icon/components";

export async function getStaticPaths() {
  return districts.map((dist) => ({
    params: { slug: dist.slug },
    props: { dist },
  }));
}

const { dist } = Astro.props;

const localServices = [
  {
    slug: "google-haritalar-seo",
    title: `${dist.name} Google Haritalar SEO & Yorum Optimizasyonu`,
    description: `${dist.name} bölgesinde yerel hizmet veren (nakliyat, teknik servis, tesisat vb.) işletmeniz için Google Benim İşletmem (GMB) harita kaydınızı en ince ayrıntısına kadar optimize ediyoruz. Arama yapan potansiyel müşterilerin karşısına ilk 3 sırada (Local Pack) çıkmanızı sağlayıp, telefon çağrılarınızı ve harita yol tarifi taleplerinizi doğrudan artırıyoruz. Ayrıca olumlu müşteri yorumları toplama stratejileri ile itibarınızı güçlendiriyoruz.`,
    icon: "mdi:map-marker-radius-outline",
    color: "bg-green-500/10 text-green-600 border-green-500/20"
  },
  {
    slug: "reklam-yonetimi",
    title: `${dist.name} Reklam Yönetimi (Google & Meta Ads)`,
    description: `Sadece ${dist.name} bölgesinde hizmet arayan hedef kitleye yönelik, nokta atışı Google Ads arama ağı reklamları ve Meta (Instagram & Facebook) form toplama kampanyaları kuruyoruz. Bütçenizi boşa harcayan gereksiz arama terimlerini ve ilgisiz tıklamaları %100 oranında filtreleyerek, reklam yatırımlarınızın doğrudan nitelikli iş çağrılarına ve form datalarına dönüşmesini sağlıyoruz.`,
    icon: "mdi:google-ads",
    color: "bg-blue-500/10 text-blue-600 border-blue-500/20"
  },
  {
    slug: "web-tasarim",
    title: `${dist.name} Yüksek Dönüşümlü Web Tasarım (Landing Page)`,
    description: `${dist.name} genelinde reklama çıktığınızda veya aramalarda bulunduğunuzda, gelen ziyaretçileri doğrudan müşteriye dönüştürecek şimşek hızında açılış sayfaları (Landing Page) tasarlıyoruz. Karmaşık, yavaş ve iş getirmeyen web siteleri yerine; ziyaretçiyi anında harekete geçiren, neo-brutalist tarzda modern, mobil uyumlu ve telefon çaldırmaya odaklı tek sayfalık dönüşüm tünelleri kuruyoruz.`,
    icon: "mdi:xml",
    color: "bg-amber-500/10 text-amber-600 border-amber-500/20"
  },
  {
    slug: "seo",
    title: `${dist.name} SEO (Arama Motoru Optimizasyonu)`,
    description: `Reklam bütçeniz bittiğinde de telefonlarınızın çalmaya devam etmesini istiyorsanız, ${dist.name} odaklı sektörel kelimelerde organik Google SEO çalışmaları yürütüyoruz. İlçe bazlı arama hacimlerini analiz ederek web sitenizin teknik altyapısını, hızını ve içeriklerini optimize ediyor; arama motorlarında reklamsız, kalıcı ve sürdürülebilir sıralamalar elde etmenizi sağlıyoruz.`,
    icon: "mdi:trending-up",
    color: "bg-purple-500/10 text-purple-600 border-purple-500/20"
  }
];
---

<MainLayout 
  title={`${dist.name} Web Tasarım, Google Ads ve Harita SEO | Evolution Ajans`}
  description={`${dist.name} bölgesindeki işletmeniz için Google Ads, Instagram/Facebook Form Reklamları, Harita SEO ve hızlı Web Tasarım çözümleri. Ücretsiz analiz için hemen başvurun.`}
>
  <!-- Hero Section -->
  <section class="py-32 bg-slate-50 relative z-10 retro-grid border-b-4 border-black">
    <div class="max-w-5xl mx-auto px-6 text-center space-y-6">
      <div class="inline-flex items-center gap-3 px-4 py-2 border-2 border-black bg-black text-white" data-aos="fade-down">
        <span class="w-2 h-2 rounded-full bg-[#25D366] animate-ping"></span>
        <span class="text-xs font-mono uppercase tracking-[0.2em] font-bold font-pixel">{dist.name} Büyüme Çözümleri</span>
      </div>
      <h1 class="text-4xl md:text-6xl font-black uppercase tracking-tighter text-black leading-tight" data-aos="fade-up" data-aos-delay="100">
        {dist.name}'de Telefonlarınızı Çaldıracak Dijital Sistemleri Kuralım
      </h1>
      <p class="text-black/85 max-w-3xl mx-auto text-xl md:text-2xl font-medium leading-relaxed" data-aos="fade-up" data-aos-delay="200">
        {dist.name} bölgesindeki yerel hizmet işletmeniz (nakliyat, servis, tesisat vb.) için sadece gerçekten işe yarayan Google/Meta reklamları, Harita SEO ve dönüşüm odaklı hızlı sayfalar kuruyorum.
      </p>
      <div class="flex flex-col sm:flex-row gap-6 justify-center pt-6 font-pixel" data-aos="fade-up" data-aos-delay="300">
        <a href="/#iletisim" class="group relative inline-flex items-center justify-center gap-4 px-8 py-4 border-2 border-black bg-[#facc15] text-black font-bold uppercase tracking-widest text-xs sm:text-sm hover:-translate-x-[4px] hover:-translate-y-[4px] hover:shadow-[6px_6px_0px_0px_rgba(0,0,0,1)] active:translate-x-0 active:translate-y-0 active:shadow-none shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] transition-all">
          <span>Ücretsiz Analiz Başlat</span>
          <Icon name="mdi:arrow-right" size={18} class="group-hover:translate-x-1 transition-transform" />
        </a>
        <a href="/hizmet-bolgeleri" class="group relative inline-flex items-center justify-center gap-4 px-8 py-4 border-2 border-black bg-white text-black font-bold uppercase tracking-widest text-xs sm:text-sm hover:-translate-x-[4px] hover:-translate-y-[4px] hover:shadow-[6px_6px_0px_0px_rgba(0,0,0,1)] active:translate-x-0 active:translate-y-0 active:shadow-none shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] transition-all">
          <span>Diğer Bölgeler</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Local Services Section -->
  <section class="py-24 bg-white relative z-10">
    <div class="max-w-5xl mx-auto px-6">
      
      <!-- Section Header -->
      <div class="mb-20 border-l-4 border-black pl-6 space-y-2">
        <span class="text-xs font-mono uppercase tracking-[0.2em] text-black/50 block font-pixel">YEREL STRATEJİ</span>
        <h2 class="text-3xl md:text-5xl font-black uppercase tracking-tighter text-black font-pixel">
          {dist.name} Bölgesine Özel Hizmetlerimiz
        </h2>
      </div>

      <!-- Services Stack -->
      <div class="space-y-12">
        {localServices.map((service, index) => (
          <a 
            href={`/hizmet-bolgeleri/${dist.slug}/${service.slug}`}
            class="group block bg-white border-4 border-black p-8 md:p-10 rounded-none shadow-[4px_4px_0px_rgba(0,0,0,1)] hover:-translate-x-[2px] hover:-translate-y-[2px] hover:shadow-[6px_6px_0px_rgba(0,0,0,1)] transition-all duration-300 flex flex-col md:flex-row gap-8 items-start"
            data-aos="fade-up"
            data-aos-delay={index * 100}
          >
            <!-- Service Icon Box -->
            <div class={`w-16 h-16 shrink-0 border-2 border-black rounded-none flex items-center justify-center ${service.color}`}>
              <Icon name={service.icon} size={32} />
            </div>

            <!-- Service Info -->
            <div class="space-y-4 flex-1">
              <div class="flex items-center justify-between gap-4">
                <h3 class="text-2xl md:text-3xl font-black uppercase text-black font-pixel tracking-tight group-hover:text-blue-600 transition-colors">
                  {service.title}
                </h3>
                <Icon name="mdi:arrow-right" size={24} class="text-black group-hover:translate-x-2 transition-transform hidden md:block shrink-0" />
              </div>
              <p class="text-black/75 text-lg md:text-xl leading-relaxed font-mono">
                {service.description}
              </p>
              <div class="pt-2 text-sm font-mono font-bold uppercase tracking-wider text-blue-600 group-hover:underline flex items-center gap-1 font-pixel">
                <span>{dist.name} {service.title.split(' ').slice(1).join(' ')} Sayfasına Git</span>
                <Icon name="mdi:arrow-right" size={14} class="md:hidden" />
              </div>
            </div>
          </a>
        ))}
      </div>

    </div>
  </section>

  <!-- CTA Lead Box -->
  <section class="py-20 bg-slate-100 border-t-4 border-black relative z-10 retro-grid">
    <div class="max-w-4xl mx-auto px-6 text-center space-y-8">
      <h2 class="text-4xl md:text-6xl font-black uppercase tracking-tighter text-black font-pixel">
        Rakipleriniz {dist.name}'de Müşterileri Topluyor.
      </h2>
      <p class="text-black/85 text-xl md:text-2xl font-medium leading-relaxed font-mono max-w-3xl mx-auto">
        Hemen bugün bilgilerinizi bırakın, web siteniz ve reklamlarınızın analizini yapıp telefon görüşmesinde tüm eksiklerinizi aktarayım.
      </p>
      <div class="pt-4 font-pixel">
        <a 
          href="/#iletisim" 
          class="group relative inline-flex items-center justify-center gap-4 px-8 py-5 border-2 border-black bg-[#facc15] text-black font-bold uppercase tracking-widest text-sm sm:text-base hover:-translate-x-[4px] hover:-translate-y-[4px] hover:shadow-[6px_6px_0px_0px_rgba(0,0,0,1)] active:translate-x-0 active:translate-y-0 active:shadow-none shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] transition-all"
        >
          <span>Ücretsiz {dist.name} Analizimi İste</span>
          <Icon name="mdi:send" size={18} />
        </a>
      </div>
    </div>
  </section>
</MainLayout>

<script>
  import AOS from "aos";
  document.addEventListener("DOMContentLoaded", () => {
    AOS.init({
      duration: 1000,
      once: true,
      easing: 'ease-out-cubic'
    });
  });
</script>
