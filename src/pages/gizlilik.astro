---
import MainLayout from "../layout/mainLayout.astro";
import { Icon } from "astro-icon/components";

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Anasayfa",
      "item": "https://evolutionajans.com/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Gizlilik Politikası",
      "item": "https://evolutionajans.com/gizlilik/"
    }
  ]
};
---

<MainLayout 
  title="Gizlilik Politikası ve KVKK Aydınlatma Metni | Evolution Ajans"
  description="Evolution Ajans olarak kişisel verilerinizin güvenliğine önem veriyoruz. 6698 sayılı KVKK kapsamındaki gizlilik ilkelerimiz ve aydınlatma metnimiz."
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <!-- Hero Section -->
  <section class="py-24 md:py-32 bg-slate-50 relative z-10 retro-grid border-b-4 border-black">
    <div class="max-w-4xl mx-auto px-6">
      
      <nav class="flex items-center gap-2 text-xs md:text-sm font-mono text-black/60 mb-8 font-bold uppercase font-pixel" data-aos="fade-down">
        <a href="/" class="hover:text-black transition-colors">Anasayfa</a>
        <span>/</span>
        <span class="text-black bg-[#facc15] px-2 py-0.5 border border-black">Gizlilik Politikası</span>
      </nav>

      <div class="space-y-4">
        <div class="inline-flex items-center gap-2 px-3 py-1 border-2 border-black bg-black text-white font-pixel text-xs uppercase tracking-wider font-bold">
          <Icon name="mdi:shield-check" size={16} class="text-[#25D366]" />
          <span>Veri Güvenliği & KVKK</span>
        </div>
        
        <h1 class="text-3xl md:text-5xl font-black uppercase tracking-tighter text-black leading-tight font-pixel">
          Gizlilik Politikası & Aydınlatma Metni
        </h1>
        
        <p class="text-black/80 font-mono text-sm md:text-base">
          Son Güncelleme Tarihi: 21 Eylül 2026
        </p>
      </div>

    </div>
  </section>

  <!-- Legal Content -->
  <section class="py-16 bg-white relative z-10">
    <div class="max-w-4xl mx-auto px-6 font-mono text-black/85 space-y-10 leading-relaxed text-sm md:text-base">
      
      <div class="p-6 border-4 border-black bg-[#fefce8] shadow-[4px_4px_0px_rgba(0,0,0,1)]">
        <h2 class="text-lg md:text-xl font-black uppercase text-black font-pixel mb-3">1. Giriş ve Kapsam</h2>
        <p>
          Evolution Ajans ("Şirket") olarak, müşterilerimizin, web sitesi ziyaretçilerimizin ve iş ortaklarımızın kişisel verilerinin gizliliğini ve güvenliğini korumaya büyük önem veriyoruz. Bu Gizlilik Politikası ve KVKK Aydınlatma Metni, 6698 sayılı Kişisel Verilerin Korunması Kanunu ("KVKK") uyarınca, verilerinizin hangi amaçlarla toplandığını, nasıl işlendiğini ve korunduğunu açıklamaktadır.
        </p>
      </div>

      <div class="space-y-4">
        <h2 class="text-lg md:text-xl font-black uppercase text-black font-pixel">2. Toplanan Kişisel Veriler</h2>
        <p>
          Web sitemizdeki iletişim, analiz ve teklif formları aracılığıyla aşağıdaki kişisel verileriniz işlenebilir:
        </p>
        <ul class="list-disc pl-6 space-y-2">
          <li><strong>Kimlik ve İletişim Bilgileri:</strong> Adınız, soyadınız, e-posta adresiniz, telefon numaranız, şirket unvanınız.</li>
          <li><strong>Teknik ve Çerez Verileri:</strong> IP adresiniz, tarayıcı türünüz, ziyaret ettiğiniz sayfalar, işletim sisteminiz.</li>
          <li><strong>Hizmet ve Talep Verileri:</strong> Reklam, web tasarım ve SEO projelerinizle ilgili paylaştığınız notlar ve gereksinimler.</li>
        </ul>
      </div>

      <div class="space-y-4">
        <h2 class="text-lg md:text-xl font-black uppercase text-black font-pixel">3. Kişisel Verilerin İşlenme Amaçları</h2>
        <p>Toplanan kişisel verileriniz aşağıdaki amaçlar doğrultusunda işlenmektedir:</p>
        <ul class="list-disc pl-6 space-y-2">
          <li>Talep ettiğiniz ücretsiz analiz, teklif ve dijital pazarlama danışmanlığı süreçlerini yürütmek,</li>
          <li>Sözleşme ve faturalandırma süreçlerini eksiksiz yerine getirmek,</li>
          <li>Web sitemizin performansını, güvenliğini ve kullanıcı deneyimini iyileştirmek,</li>
          <li>Yasal düzenlemelerin getirdiği bildirim ve saklama yükümlülüklerine uymak.</li>
        </ul>
      </div>

      <div class="space-y-4">
        <h2 class="text-lg md:text-xl font-black uppercase text-black font-pixel">4. Çerezler (Cookies) ve Analitik Araçlar</h2>
        <p>
          Web sitemizde, temel site işlevselliğini sağlamak ve trafik analizi gerçekleştirmek amacıyla sınırlı düzeyde analitik çerezler kullanılmaktadır. Tarayıcı ayarlarınız üzerinden çerezleri dilediğiniz an silebilir veya engelleyebilirsiniz.
        </p>
      </div>

      <div class="space-y-4">
        <h2 class="text-lg md:text-xl font-black uppercase text-black font-pixel">5. KVKK Kapsamındaki Haklarınız</h2>
        <p>
          KVKK'nın 11. maddesi uyarınca; verilerinizin işlenip işlenmediğini öğrenme, işlenmişse bilgi talep etme, amacına uygun kullanılıp kullanılmadığını öğrenme, eksik/yanlış verilerin düzeltilmesini ve silinmesini isteme haklarına sahipsiniz.
        </p>
        <p>
          Haklarınızı kullanmak için <strong>hello@evolution.com</strong> e-posta adresimiz üzerinden bizimle iletişime geçebilirsiniz.
        </p>
      </div>

      <div class="pt-6 border-t-2 border-black/10 flex items-center justify-between">
        <a href="/" class="inline-flex items-center gap-2 font-pixel text-xs font-bold uppercase underline hover:text-blue-600">
          <Icon name="mdi:arrow-left" size={16} />
          <span>Anasayfaya Dön</span>
        </a>
        <a href="/sartlar/" class="font-pixel text-xs font-bold uppercase underline hover:text-blue-600">
          Kullanım Şartları &rarr;
        </a>
      </div>

    </div>
  </section>
</MainLayout>
