---
import MainLayout from "../../layout/mainLayout.astro";
import { services } from "../../components/data/services.js";

export function getStaticPaths() {
  return services.map((service) => {
    return {
      params: { slug: service.slug },
      props: { service },
    };
  });
}

const { service } = Astro.props;
---

<MainLayout title={`${service.name} - Evolution Ajans`} description={service.desc}>
  <div class="container mx-auto px-6 py-24 md:py-40">
    <div class="max-w-4xl mx-auto" data-aos="fade-up">
      <span class="inline-block px-4 py-2 border-2 border-black bg-black text-white text-[10px] font-mono uppercase tracking-[0.3em] font-pixel mb-8">
        Hizmetlerimiz
      </span>
      <h1 class="text-lg sm:text-xl md:text-3xl font-black text-black mb-10 tracking-tight leading-none font-pixel uppercase">
        {service.name}
      </h1>
      <div class="prose prose-slate max-w-none text-black leading-relaxed font-mono mb-12">
        <p class="text-lg md:text-xl text-black/80 font-medium leading-relaxed mb-8">
          {service.details || service.desc}
        </p>
      </div>

      <!-- Features Highlights Grid -->
      {service.features && (
        <div class="mt-16 border-t-2 border-black/10 pt-12">
          <h3 class="text-[10px] md:text-xs font-pixel uppercase tracking-wider text-purple-600 mb-8">★ HİZMET ÖZELLİKLERİ</h3>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            {service.features.map(feat => (
              <div class="bg-white border-2 border-black p-4 flex items-center gap-3 shadow-[2px_2px_0px_rgba(0,0,0,1)]">
                <span class="text-green-500 font-bold">✔</span>
                <span class="text-sm font-mono font-bold uppercase">{feat}</span>
              </div>
            ))}
          </div>
        </div>
      )}

      <!-- Work Process Grid -->
      {service.process && (
        <div class="mt-16 border-t-2 border-black/10 pt-12">
          <h3 class="text-[10px] md:text-xs font-pixel uppercase tracking-wider text-blue-600 mb-8">⚡ NASIL ÇALIŞIYORUZ?</h3>
          <div class="grid grid-cols-1 sm:grid-cols-4 gap-4">
            {service.process.map(step => (
              <div class="bg-slate-50 border-2 border-black p-4 text-center shadow-[2px_2px_0px_rgba(0,0,0,1)] flex flex-col justify-center min-h-[100px]">
                <span class="text-[9px] font-pixel block text-black/40 mb-2">{step.split(".")[0]}. ADIM</span>
                <span class="text-xs font-mono block text-black/80 uppercase font-semibold leading-tight">{step.split(".")[1]?.trim()}</span>
              </div>
            ))}
          </div>
        </div>
      )}
      
      <div class="p-8 md:p-12 bg-white border-4 border-black rounded-none shadow-[8px_8px_0px_0px_rgba(0,0,0,1)] mt-16 space-y-6">
        <h3 class="text-sm sm:text-base md:text-lg font-bold text-black font-pixel uppercase">Bu Hizmet Hakkında Detaylı Bilgi Alın</h3>
        <p class="text-black/75 text-base leading-relaxed">
          Markanızı dijital dünyada bir adım öne taşımak ve işinizi büyütmek için profesyonel ekibimizle görüşün. Sorularınızı yanıtlamak ve size en uygun stratejiyi belirlemek için buradayız.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 pt-4 font-pixel">
          <a href="https://wa.me/905519283598" target="_blank" class="inline-flex items-center justify-center gap-3 px-6 py-4 bg-[#25D366] text-black border-2 border-black rounded-none font-bold uppercase tracking-widest text-[10px] sm:text-[11px] hover:-translate-x-[2px] hover:-translate-y-[2px] hover:shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] active:translate-x-0 active:translate-y-0 active:shadow-none transition-all">
            WhatsApp'tan Yazın
          </a>
          <a href="/iletisim" class="inline-flex items-center justify-center gap-3 px-6 py-4 bg-white text-black border-2 border-black rounded-none font-bold uppercase tracking-widest text-[10px] sm:text-[11px] hover:-translate-x-[2px] hover:-translate-y-[2px] hover:shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] active:translate-x-0 active:translate-y-0 active:shadow-none transition-all">
            İletişim Formunu Doldurun
          </a>
        </div>
      </div>
    </div>
  </div>
</MainLayout>

<script>
  import AOS from "aos";
  document.addEventListener("DOMContentLoaded", () => {
    AOS.init({
      duration: 1000,
      once: true,
      easing: 'ease-out-cubic'
    });
  });
</script>
