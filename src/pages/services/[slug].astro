---
import MainLayout from "../../layout/mainLayout.astro";
import { services } from "../../components/data/services.js";

export function getStaticPaths() {
  return services.map((service) => {
    const slug = service.name
      .toLowerCase()
      .replace(/ /g, "-")
      .replace(/&/g, "ve");
    return {
      params: { slug: slug },
      props: { service },
    };
  });
}

const { service } = Astro.props;
---

<MainLayout title={service.name} description={service.desc}>
  <div class="container mx-auto px-4 py-16">
    <h1 class="text-4xl font-bold text-center mb-8">{service.name}</h1>
    <div class="max-w-3xl mx-auto">
      <p class="text-lg text-gray-300">{service.desc}</p>
    </div>
  </div>
</MainLayout>
