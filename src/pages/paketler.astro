---
import MainLayout from "../layout/mainLayout.astro";
import { Icon } from "astro-icon/components";
import Pricing from "../components/Pricing.astro";
import Form from "../components/Form.astro";

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Ana Sayfa",
      "item": "https://evolutionajans.com/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Paketler",
      "item": "https://evolutionajans.com/paketler/"
    }
  ]
};

const offersSchema = {
  "@context": "https://schema.org",
  "@type": "PriceSpecification",
  "name": "Evolution Ajans Dijital Büyüme Paketleri",
  "description": "Google Ads, Web Tasarım, Harita SEO ve 360 derece dijital büyüme paketleri.",
  "priceCurrency": "TRY"
};
---

<MainLayout 
  title="Fiyatlandırma & Büyüme Paketleri | Evolution Ajans"
  description="İşletmenizin büyüklüğüne ve hedeflerinize uygun şeffaf fiyatlandırma planları. Google Ads, Web Tasarım ve Harita SEO paketlerimizi inceleyin."
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(offersSchema)} />

  <!-- Breadcrumb Bar -->
  <div class="max-w-6xl mx-auto px-6 pt-12">
    <nav class="font-mono text-xs text-[#6E6A62] flex items-center gap-2">
      <a href="/" class="hover:text-[#BE5836] transition-colors">Ana Sayfa</a>
      <span>/</span>
      <span class="text-[#181816] font-medium">Büyüme Paketleri</span>
    </nav>
  </div>

  <Pricing />
  <Form />
</MainLayout>
