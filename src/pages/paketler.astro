---
import MainLayout from "../layout/mainLayout.astro";
import { Icon } from "astro-icon/components";
import Pricing from "../components/Pricing.astro";
import Form from "../components/Form.astro";

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Ana Sayfa",
      "item": "https://evolutionajans.com/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Paketler",
      "item": "https://evolutionajans.com/paketler/"
    }
  ]
};

const offersSchema = {
  "@context": "https://schema.org",
  "@type": "PriceSpecification",
  "name": "Evolution Ajans Dijital Büyüme Paketleri",
  "description": "Google Ads, Web Tasarım, Harita SEO ve 360 derece dijital büyüme paketleri.",
  "priceCurrency": "TRY"
};
---

<MainLayout 
  title="Fiyatlandırma & Büyüme Paketleri | Evolution Ajans"
  description="İşletmenizin büyüklüğüne ve hedeflerinize uygun şeffaf fiyatlandırma planları. Google Ads, Web Tasarım ve Harita SEO paketlerimizi inceleyin."
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(offersSchema)} />

  <!-- Breadcrumb Bar -->
  <div class="pt-28 pb-4 bg-slate-50 border-b-2 border-black/10">
    <div class="max-w-7xl mx-auto px-6">
      <nav class="flex items-center gap-2 text-xs md:text-sm font-mono text-black/60 font-bold uppercase font-pixel">
        <a href="/" class="hover:text-black transition-colors">Ana Sayfa</a>
        <span>/</span>
        <span class="text-black bg-[#facc15] px-2 py-0.5 border border-black">Paketler</span>
      </nav>
    </div>
  </div>

  <!-- Reusable Pricing Component -->
  <Pricing />

  <!-- Free Analysis Form -->
  <Form />
</MainLayout>
