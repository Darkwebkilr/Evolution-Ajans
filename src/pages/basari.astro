---
import MainLayout from "../layout/mainLayout.astro";
import { Icon } from "astro-icon/components";

// Placeholder Data for Case Studies
const cases = [
  {
    client: "Lumina Kozmetik",
    category: "E-Ticaret & Performans Pazarlama",
    title: "ROAS'ı %400 Artıran Veri Odaklı Dönüşüm Stratejisi",
    desc: "Yerel bir kozmetik markasını, veri analitiği ve dinamik reklam kurgularıyla ulusal bir e-ticaret devine dönüştürdük.",
    stats: [
      { label: "ROAS Artışı", value: "%400" },
      { label: "Aylık Trafik", value: "+2.5M" }
    ],
    color: "from-pink-500 to-rose-400"
  },
  {
    client: "Nexus FinTech",
    category: "Kurumsal Kimlik & Web Geliştirme",
    title: "Geleceğin Finansal Arayüzünü İnşa Ettik",
    desc: "Karmaşık finansal verileri, kullanıcı dostu ve ultra hızlı bir web ekosistemine entegre ederek B2B müşteri edinimini katladık.",
    stats: [
      { label: "Hız Artışı", value: "3x" },
      { label: "Dönüşüm Oranı", value: "+%180" }
    ],
    color: "from-blue-500 to-cyan-400"
  },
  {
    client: "Aura Mimarlık",
    category: "SEO & İçerik Pazarlaması",
    title: "Organik Görünürlükte Zirveye Yolculuk",
    desc: "Niş mimari terimlerde uyguladığımız teknik SEO ve semantik içerik stratejisiyle Google'da sektörel dominasyon sağladık.",
    stats: [
      { label: "Organik Trafik", value: "+%650" },
      { label: "Anahtar Kelime", value: "#1 Sıra" }
    ],
    color: "from-emerald-400 to-teal-500"
  },
  {
    client: "Vanguard Enerji",
    category: "360° Dijital Kampanya",
    title: "Sürdürülebilir Enerji İçin Sürdürülebilir Büyüme",
    desc: "Çok kanallı dijital PR ve bilinirlik kampanyaları ile markanın B2C pazarındaki güven skorunu maksimize ettik.",
    stats: [
      { label: "Etkileşim", value: "4.2M" },
      { label: "Lead Maliyeti", value: "-%60" }
    ],
    color: "from-amber-400 to-orange-500"
  }
];
---

<MainLayout 
  title="Başarı Hikayeleri - Evolution Ajans" 
  description="Evolution Ajans'ın markalar için yarattığı dijital evrim serüvenlerini ve başarı hikayelerini keşfedin."
>
  <!-- Hero Section -->
  <section class="relative pt-40 pb-24 overflow-hidden retro-grid">
    <div class="max-w-7xl mx-auto px-6 relative z-10 text-center">
      <span class="inline-block px-4 py-2 border-2 border-black bg-black text-white text-[10px] font-mono uppercase tracking-[0.3em] font-pixel mb-8" data-aos="fade-down">
        Vaka Analizleri
      </span>
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-black uppercase tracking-tighter leading-none mb-8" data-aos="fade-up">
        BİZİM DEĞİL, <br/>
        <span class="text-blue-600">ONLARIN</span> BAŞARISI.
      </h1>
      <p class="text-base md:text-lg text-black/60 font-light max-w-2xl mx-auto leading-relaxed" data-aos="fade-up" data-aos-delay="100">
        Rakamlar yalan söylemez. İş ortaklarımızın dijital ekosistemdeki sınırları nasıl zorladığını ve elde ettiğimiz somut sonuçları inceleyin.
      </p>
    </div>
  </section>

  <!-- Case Studies Grid -->
  <section class="pb-40 relative z-10 bg-white">
    <div class="max-w-7xl mx-auto px-6">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-12">
        {cases.map((item, index) => (
          <div 
            class="group relative bg-white border-4 border-black rounded-none p-8 md:p-12 overflow-hidden transition-all duration-300 hover:-translate-x-[4px] hover:-translate-y-[4px] hover:shadow-[8px_8px_0px_0px_rgba(0,0,0,1)] shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] flex flex-col h-full"
            data-aos="fade-up"
            data-aos-delay={index * 100}
          >
            
            <!-- Category & Client -->
            <div class="flex justify-between items-start mb-8 relative z-10">
              <span class="text-[9px] font-mono uppercase tracking-[0.2em] px-3 py-1 border-2 border-black bg-black text-white font-pixel">
                {item.category}
              </span>
              <span class="text-xs font-bold uppercase tracking-widest text-black font-pixel">
                {item.client}
              </span>
            </div>

            <!-- Content -->
            <div class="relative z-10 flex-grow">
              <h2 class="text-lg md:text-xl font-bold text-black mb-6 tracking-tight leading-normal font-pixel">
                {item.title}
              </h2>
              <p class="text-black/70 leading-relaxed font-light mb-10">
                {item.desc}
              </p>
            </div>

            <!-- Stats & CTA -->
            <div class="mt-auto relative z-10 pt-8 border-t-2 border-black/10 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-6">
              
              <div class="flex gap-8">
                {item.stats.map(stat => (
                  <div>
                    <span class="block text-2xl font-bold text-black mb-1 tracking-tighter font-pixel">{stat.value}</span>
                    <span class="block text-[8px] font-mono uppercase tracking-[0.2em] text-black/40 font-pixel">{stat.label}</span>
                  </div>
                ))}
              </div>

              <button class="w-10 h-10 rounded-none border-2 border-black flex items-center justify-center bg-[#facc15] hover:bg-[#facc15]/80 transition-all duration-300 overflow-hidden relative shrink-0 shadow-[2px_2px_0px_0px_rgba(0,0,0,1)]">
                <Icon name="mdi:arrow-right" class="w-5 h-5 text-black" />
              </button>

            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Banner -->
  <section class="py-24 border-t-4 border-black bg-white text-center px-6 retro-grid">
    <div class="max-w-4xl mx-auto font-pixel" data-aos="zoom-in">
      <h2 class="text-3xl md:text-5xl font-black uppercase tracking-tighter mb-8">Sıradaki Başarı Hikayesi <br/> <span class="text-blue-600">Sizin Markanız</span> Olsun.</h2>
      <a href="/iletisim" class="inline-flex items-center gap-4 bg-[#facc15] border-2 border-black text-black px-8 py-4 rounded-none text-xs font-bold uppercase tracking-widest hover:-translate-x-[2px] hover:-translate-y-[2px] hover:shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] active:translate-x-0 active:translate-y-0 active:shadow-none transition-all">
        Projeyi Başlat
        <Icon name="mdi:rocket-launch" size={20} />
      </a>
    </div>
  </section>

</MainLayout>

<script>
  import AOS from "aos";
  document.addEventListener("DOMContentLoaded", () => {
    AOS.init({
      duration: 1000,
      once: true,
      easing: 'ease-out-cubic'
    });
  });
</script>
