---
import MainLayout from "../layout/mainLayout.astro";
import { Icon } from "astro-icon/components";

// Placeholder Data for Case Studies
const cases = [
  {
    client: "Lumina Kozmetik",
    category: "E-Ticaret & Performans Pazarlama",
    title: "ROAS'ı %400 Artıran Veri Odaklı Dönüşüm Stratejisi",
    desc: "Yerel bir kozmetik markasını, veri analitiği ve dinamik reklam kurgularıyla ulusal bir e-ticaret devine dönüştürdük.",
    stats: [
      { label: "ROAS Artışı", value: "%400" },
      { label: "Aylık Trafik", value: "+2.5M" }
    ],
    color: "from-pink-500 to-rose-400"
  },
  {
    client: "Nexus FinTech",
    category: "Kurumsal Kimlik & Web Geliştirme",
    title: "Geleceğin Finansal Arayüzünü İnşa Ettik",
    desc: "Karmaşık finansal verileri, kullanıcı dostu ve ultra hızlı bir web ekosistemine entegre ederek B2B müşteri edinimini katladık.",
    stats: [
      { label: "Hız Artışı", value: "3x" },
      { label: "Dönüşüm Oranı", value: "+%180" }
    ],
    color: "from-blue-500 to-cyan-400"
  },
  {
    client: "Aura Mimarlık",
    category: "SEO & İçerik Pazarlaması",
    title: "Organik Görünürlükte Zirveye Yolculuk",
    desc: "Niş mimari terimlerde uyguladığımız teknik SEO ve semantik içerik stratejisiyle Google'da sektörel dominasyon sağladık.",
    stats: [
      { label: "Organik Trafik", value: "+%650" },
      { label: "Anahtar Kelime", value: "#1 Sıra" }
    ],
    color: "from-emerald-400 to-teal-500"
  },
  {
    client: "Vanguard Enerji",
    category: "360° Dijital Kampanya",
    title: "Sürdürülebilir Enerji İçin Sürdürülebilir Büyüme",
    desc: "Çok kanallı dijital PR ve bilinirlik kampanyaları ile markanın B2C pazarındaki güven skorunu maksimize ettik.",
    stats: [
      { label: "Etkileşim", value: "4.2M" },
      { label: "Lead Maliyeti", value: "-%60" }
    ],
    color: "from-amber-400 to-orange-500"
  }
];
---

<MainLayout 
  title="Başarı Hikayeleri - Evolution Ajans" 
  description="Evolution Ajans'ın markalar için yarattığı dijital evrim serüvenlerini ve başarı hikayelerini keşfedin."
>
  <!-- Hero Section -->
  <section class="relative pt-40 pb-24 overflow-hidden">
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full h-[500px] bg-blue-600/10 blur-[150px] rounded-full pointer-events-none"></div>
    <div class="absolute inset-0 opacity-[0.03]" style="background-image: linear-gradient(rgba(255,255,255,1) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,1) 1px, transparent 1px); background-size: 50px 50px;"></div>
    
    <div class="max-w-7xl mx-auto px-6 relative z-10 text-center">
      <span class="inline-block px-4 py-2 bg-white/5 border border-white/10 rounded-full text-xs font-mono uppercase tracking-[0.3em] text-white/50 mb-8" data-aos="fade-down">
        Vaka Analizleri
      </span>
      <h1 class="text-5xl md:text-7xl lg:text-8xl font-black uppercase tracking-tighter leading-[0.9] mb-8" data-aos="fade-up">
        BİZİM DEĞİL, <br/>
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-white via-white/80 to-white/40">ONLARIN</span> BAŞARISI.
      </h1>
      <p class="text-lg md:text-xl text-white/50 font-light max-w-2xl mx-auto leading-relaxed" data-aos="fade-up" data-aos-delay="100">
        Rakamlar yalan söylemez. İş ortaklarımızın dijital ekosistemdeki sınırları nasıl zorladığını ve elde ettiğimiz somut sonuçları inceleyin.
      </p>
    </div>
  </section>

  <!-- Case Studies Grid -->
  <section class="pb-40 relative z-10">
    <div class="max-w-7xl mx-auto px-6">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-12">
        {cases.map((item, index) => (
          <div 
            class="group relative bg-[#070707] border border-white/5 rounded-[2.5rem] p-8 md:p-12 overflow-hidden transition-all duration-700 hover:border-white/20 hover:-translate-y-2 flex flex-col h-full"
            data-aos="fade-up"
            data-aos-delay={index * 100}
          >
            <!-- Hover Gradient Background -->
            <div class={`absolute inset-0 bg-gradient-to-br ${item.color} opacity-0 group-hover:opacity-[0.03] transition-opacity duration-700 pointer-events-none`}></div>
            
            <!-- Category & Client -->
            <div class="flex justify-between items-start mb-8 relative z-10">
              <span class="text-[10px] font-mono uppercase tracking-[0.2em] px-3 py-1 rounded-full border border-white/10 bg-white/5 text-white/60">
                {item.category}
              </span>
              <span class={`text-sm font-black uppercase tracking-widest text-transparent bg-clip-text bg-gradient-to-r ${item.color}`}>
                {item.client}
              </span>
            </div>

            <!-- Content -->
            <div class="relative z-10 flex-grow">
              <h2 class="text-3xl md:text-4xl font-extrabold text-white mb-6 tracking-tight leading-tight group-hover:text-white/90 transition-colors">
                {item.title}
              </h2>
              <p class="text-white/40 leading-relaxed font-light mb-10">
                {item.desc}
              </p>
            </div>

            <!-- Stats & CTA -->
            <div class="mt-auto relative z-10 pt-8 border-t border-white/5 group-hover:border-white/10 transition-colors flex flex-col sm:flex-row justify-between items-start sm:items-center gap-6">
              
              <div class="flex gap-8">
                {item.stats.map(stat => (
                  <div>
                    <span class="block text-2xl font-black text-white mb-1 tracking-tighter">{stat.value}</span>
                    <span class="block text-[10px] font-mono uppercase tracking-[0.2em] text-white/30">{stat.label}</span>
                  </div>
                ))}
              </div>

              <button class="w-12 h-12 rounded-full border border-white/10 flex items-center justify-center bg-black/50 group-hover:bg-white group-hover:border-white transition-all duration-500 overflow-hidden relative group/btn shrink-0">
                <Icon name="mdi:arrow-right" class="w-5 h-5 text-white/50 absolute group-hover/btn:translate-x-8 transition-transform duration-500" />
                <Icon name="mdi:arrow-right" class="w-5 h-5 text-black absolute -translate-x-8 group-hover/btn:translate-x-0 transition-transform duration-500 delay-75" />
              </button>

            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Banner -->
  <section class="py-24 border-t border-white/5 bg-[#030303] text-center px-6">
    <div class="max-w-4xl mx-auto" data-aos="zoom-in">
      <h2 class="text-4xl md:text-6xl font-black uppercase tracking-tighter mb-8">Sıradaki Başarı Hikayesi <br/> <span class="text-blue-500">Sizin Markanız</span> Olsun.</h2>
      <a href="/iletisim" class="inline-flex items-center gap-4 bg-white text-black px-10 py-5 rounded-full text-sm font-bold uppercase tracking-widest hover:scale-105 transition-transform">
        Projeyi Başlat
        <Icon name="mdi:rocket-launch" size={20} />
      </a>
    </div>
  </section>

</MainLayout>

<script>
  import AOS from "aos";
  document.addEventListener("DOMContentLoaded", () => {
    AOS.init({
      duration: 1000,
      once: true,
      easing: 'ease-out-cubic'
    });
  });
</script>
