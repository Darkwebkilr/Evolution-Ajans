---
import MainLayout from "../layout/mainLayout.astro";
import { Icon } from "astro-icon/components";

const cases = [
  {
    client: "Vizyon Lojistik",
    category: "Google Ads & Yerel Dönüşüm",
    title: "Arama Reklamlarında Aylık Çağrı Hacmini %150 Büyüten Strateji",
    desc: "Gereksiz tıklamaları negatif kelimelerle eleyerek sadece sıcak nakliyat taleplerine odaklandık; bütçe israfını sıfırladık.",
    stats: [
      { label: "Çağrı Artışı", value: "+%150" },
      { label: "Maliyet Düşüşü", value: "-%40" }
    ],
    tag: "01 // LOJİSTİK"
  },
  {
    client: "Ege Teknik Servis",
    category: "Google Haritalar SEO & Açılış Sayfası",
    title: "İzmir Genelinde Günde 15+ Doğrulanmış Servis Çağrısı",
    desc: "Astro tabanlı 0.8 saniyede açılan mobil sayfa ve Harita optimizasyonu ile sezonluk klima/kombi taleplerini domine ettik.",
    stats: [
      { label: "Günlük Servis", value: "15+ Talep" },
      { label: "Sayfa Hızı", value: "0.8s" }
    ],
    tag: "02 // SERVİS"
  },
  {
    client: "Akdeniz Altyapı",
    category: "Meta Ads & Bölgesel B2B",
    title: "Endüstriyel Altyapıda Doğrudan İhale & Kurumsal Talep Akışı",
    desc: "Hedefli coğrafi yarıçap ve karar vericilere yönelik Meta form kampanyaları ile nitelikli kurumsal lead maliyetlerini yarıya indirdik.",
    stats: [
      { label: "Lead Artışı", value: "2x" },
      { label: "Dönüşüm Oranı", value: "%12.4" }
    ],
    tag: "03 // ENDÜSTRİYEL"
  }
];

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Ana Sayfa",
      "item": "https://evolutionajans.com/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Başarılarımız",
      "item": "https://evolutionajans.com/basari/"
    }
  ]
};
---

<MainLayout 
  title="Başarı Hikayeleri & Sonuçlar | Evolution Ajans" 
  description="Gerçek panel verileri ve ölçülebilir sonuçlar. Birlikte çalıştığımız yerel işletmelerin büyüme kayıtları."
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <!-- Breadcrumbs -->
  <div class="max-w-6xl mx-auto px-6 pt-12">
    <nav class="font-mono text-xs text-[#6E6A62] flex items-center gap-2">
      <a href="/" class="hover:text-[#BE5836] transition-colors">Ana Sayfa</a>
      <span>/</span>
      <span class="text-[#181816] font-medium">Başarılarımız</span>
    </nav>
  </div>

  <!-- Header -->
  <section class="py-16 md:py-24 border-b border-dashed border-[#181816]/15">
    <div class="max-w-6xl mx-auto px-6">
      <div class="max-w-3xl space-y-4">
        <div class="inline-flex items-center gap-2 text-xs font-mono uppercase tracking-[0.2em] text-[#536248] bg-[#EBF0E6] px-3 py-1 rounded-full border border-[#536248]/20">
          <span class="w-1.5 h-1.5 rounded-full bg-[#536248]"></span>
          <span>[ SAHA ÇALIŞMALARI ]</span>
        </div>
        <h1 class="text-4xl sm:text-5xl md:text-6xl font-serif tracking-tight text-[#181816]">
          Ölçülebilir vaka analizleri ve <br />
          <span class="italic font-normal text-[#BE5836]">gerçek büyüme hikayeleri</span>.
        </h1>
        <p class="text-base sm:text-lg text-[#6E6A62] leading-relaxed">
          Gereksiz gösterim rakamları değil; ciroya, iş hacmine ve doğrudan telefon aramalarına dönüşen gerçek projelerimiz.
        </p>
      </div>
    </div>
  </section>

  <!-- Cases List -->
  <section class="py-24 bg-[#F4EFE6] border-b border-dashed border-[#181816]/15">
    <div class="max-w-6xl mx-auto px-6 space-y-12">
      {cases.map((item) => (
        <div class="bg-white border border-[#181816]/12 rounded-[28px] p-8 sm:p-12 shadow-[0_4px_24px_rgba(24,24,22,0.03)] grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
          
          <div class="lg:col-span-8 space-y-4">
            <div class="flex items-center gap-3">
              <span class="text-xs font-mono text-[#BE5836] bg-[#FAEDE8] px-3 py-1 rounded-full">
                {item.tag}
              </span>
              <span class="text-xs font-mono text-[#536248]">
                {item.category}
              </span>
            </div>

            <h2 class="font-serif text-2xl sm:text-3xl text-[#181816] leading-snug">
              {item.title}
            </h2>

            <p class="text-sm sm:text-base text-[#4A4742] leading-relaxed">
              {item.desc}
            </p>

            <p class="text-xs font-mono text-[#6E6A62]">
              İş Ortağı: <strong class="text-[#181816]">{item.client}</strong>
            </p>
          </div>

          <div class="lg:col-span-4 grid grid-cols-2 gap-4 border-t lg:border-t-0 lg:border-l border-[#181816]/10 pt-6 lg:pt-0 lg:pl-8">
            {item.stats.map((stat) => (
              <div class="p-4 rounded-2xl bg-[#FBF9F5] border border-[#181816]/8 text-center">
                <span class="font-serif text-2xl sm:text-3xl text-[#181816] block mb-1">{stat.value}</span>
                <span class="font-mono text-[10px] text-[#6E6A62] uppercase tracking-wider">{stat.label}</span>
              </div>
            ))}
          </div>

        </div>
      ))}
    </div>
  </section>

</MainLayout>
