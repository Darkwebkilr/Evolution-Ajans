---
import { getCollection } from "astro:content";
import MainLayout from "../layout/mainLayout.astro";

const allBlogPost = (
  await getCollection("blog", ({ data }) => {
    return !data.isDraft;
  })
).sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime());

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Ana Sayfa",
      "item": "https://evolutionajans.com/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Blog",
      "item": "https://evolutionajans.com/blog/"
    }
  ]
};
---

<MainLayout
  title="Blog & Dijital Kütüphane | Web Tasarım ve SEO Rehberi - Evolution Ajans"
  description="İzmir web tasarım, yerel SEO teknikleri, Google Haritalar algoritmaları ve reklam optimizasyonu üzerine kapsamlı editoryal rehberler."
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <!-- Breadcrumb Bar -->
  <div class="max-w-6xl mx-auto px-6 pt-12">
    <nav class="font-mono text-xs text-[#6E6A62] flex items-center gap-2">
      <a href="/" class="hover:text-[#BE5836] transition-colors">Ana Sayfa</a>
      <span>/</span>
      <span class="text-[#181816] font-medium">Blog</span>
    </nav>
  </div>

  <div class="max-w-6xl mx-auto px-6 py-16 md:py-24">
    <!-- Header Section -->
    <div class="max-w-3xl mb-16 space-y-4">
      <div class="inline-flex items-center gap-2 text-xs font-mono uppercase tracking-[0.2em] text-[#536248] bg-[#EBF0E6] px-3 py-1 rounded-full border border-[#536248]/20">
        <span class="w-1.5 h-1.5 rounded-full bg-[#536248]"></span>
        <span>[ EDİTORYAL KÜTÜPHANE ]</span>
      </div>
      <h1 class="text-4xl sm:text-5xl md:text-6xl font-serif tracking-tight text-[#181816]">
        Dijital büyüme rehberleri ve <br />
        <span class="italic font-normal text-[#BE5836]">sektörel notlar</span>.
      </h1>
      <p class="text-base sm:text-lg text-[#6E6A62] leading-relaxed">
        Web tasarım, yerel SEO, Google Haritalar optimizasyonu ve Google Ads reklam stratejileri hakkında güncel ipuçları.
      </p>
    </div>
    
    <!-- Blog Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {
        allBlogPost.map((post) => (
          <a
            href={`/blog/${post.id}/`}
            class="group bg-white border border-[#181816]/12 rounded-[24px] p-8 shadow-[0_4px_20px_rgba(24,24,22,0.03)] hover:border-[#BE5836]/40 hover:-translate-y-1 transition-all duration-300 flex flex-col justify-between"
          >
            <div>
              <div class="flex items-center justify-between gap-2 mb-4 pb-3 border-b border-dashed border-[#181816]/10">
                <time datetime={new Date(post.data.pubDate).toISOString()} class="text-xs font-mono text-[#6E6A62]">
                  {new Date(post.data.pubDate).toLocaleDateString("tr-TR", { day: "numeric", month: "long", year: "numeric" })}
                </time>
                <span class="text-[10px] font-mono uppercase bg-[#EBF0E6] text-[#536248] px-2.5 py-0.5 rounded-full">
                  {post.data.author}
                </span>
              </div>

              <h2 class="text-xl sm:text-2xl font-serif text-[#181816] mb-3 group-hover:text-[#BE5836] transition-colors leading-snug">
                {post.data.title}
              </h2>

              <p class="text-xs sm:text-sm text-[#4A4742] leading-relaxed mb-6 font-sans">
                {post.data.description}
              </p>
            </div>

            <div class="pt-4 border-t border-[#181816]/8 flex items-center justify-between text-xs font-mono text-[#6E6A62]">
              <span class="group-hover:text-[#BE5836] transition-colors flex items-center gap-1 font-medium">
                Yazıyı Oku →
              </span>
              {post.data.tags && post.data.tags[0] && (
                <span class="text-[10px] font-mono text-[#6E6A62]/60 uppercase">
                  #{post.data.tags[0]}
                </span>
              )}
            </div>
          </a>
        ))
      }
    </div>
  </div>
</MainLayout>
