---
import { getCollection } from "astro:content";
import MainLayout from "../layout/mainLayout.astro";

const allBlogPost = (
  await getCollection("blog", ({ data }) => {
    return !data.isDraft;
  })
).sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime());

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Ana Sayfa",
      "item": "https://evolutionajans.com/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Blog",
      "item": "https://evolutionajans.com/blog/"
    }
  ]
};
---

<MainLayout
  title="Blog | Web Tasarım, SEO ve Dijital Pazarlama Rehberi - Evolution Ajans"
  description="İzmir web tasarım, SEO teknikleri, Google Ads ve yerel sıralama rehberleri. İşletmenizi dijital dünyada büyütecek güncel stratejiler."
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <div class="container mx-auto px-6 py-20 md:py-32">
    <!-- Header Section -->
    <div class="max-w-3xl mx-auto text-center mb-16">
      <span class="inline-block bg-black text-white font-mono text-xs px-3 py-1 uppercase tracking-widest font-bold mb-4">
        Bilgi Merkezi
      </span>
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-black uppercase tracking-tight leading-none mb-6 font-pixel">
        Evolution Ajans Blog
      </h1>
      <p class="text-black/70 font-mono text-sm sm:text-base leading-relaxed">
        Web tasarım, yerel SEO, Google Haritalar optimizasyonu ve Google Ads reklam stratejileri hakkında güncel ipuçları ve kapsamlı rehberler.
      </p>
    </div>
    
    <!-- Blog Cards Grid -->
    <div class="max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {
        allBlogPost.map((post) => (
          <a
            href={`/blog/${post.id}/`}
            class="group relative bg-white border-4 border-black p-6 sm:p-8 rounded-none transition-all duration-300 hover:-translate-x-[4px] hover:-translate-y-[4px] hover:shadow-[8px_8px_0px_0px_rgba(0,0,0,1)] shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] flex flex-col justify-between"
          >
            <div>
              <div class="flex items-center justify-between gap-2 mb-4">
                <span class="text-[10px] font-mono text-black/60 font-pixel">
                  {new Date(post.data.pubDate).toLocaleDateString("tr-TR", { day: "numeric", month: "long", year: "numeric" })}
                </span>
                <span class="text-[9px] font-mono uppercase bg-black text-white px-2 py-0.5 font-bold">
                  {post.data.author}
                </span>
              </div>

              <h2 class="text-base sm:text-lg font-black text-black mb-4 font-pixel uppercase tracking-tight group-hover:text-blue-600 transition-colors leading-snug">
                {post.data.title}
              </h2>

              <p class="text-black/70 font-mono text-xs leading-relaxed mb-6">
                {post.data.description}
              </p>
            </div>

            <div class="pt-4 border-t-2 border-black/10 flex items-center justify-between">
              <span class="text-[10px] uppercase tracking-wider font-pixel font-bold text-black group-hover:underline underline-offset-4 flex items-center gap-1">
                Yazıyı Oku →
              </span>
              {post.data.tags && post.data.tags[0] && (
                <span class="text-[9px] font-mono text-black/50 uppercase">
                  #{post.data.tags[0]}
                </span>
              )}
            </div>
          </a>
        ))
      }
    </div>
  </div>
</MainLayout>
