---
import MainLayout from "../layout/mainLayout.astro";
import { Icon } from "astro-icon/components";
---

<MainLayout 
  title="Hakkımızda - Evolution Ajans | İzmir'in Dijital Gücü" 
  description="İzmir merkezli 360° reklam ajansı. Markanızın dijital evrimini yöneten, yaratıcılık ve teknolojiyi birleştiren çok yönlü bir çözüm ortağıyız."
>
  <section class="relative overflow-hidden py-24 md:py-40 retro-grid">
    <div class="max-w-7xl mx-auto px-6 relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-16 items-center">
        
        <!-- Left Side: Hero Title -->
        <div class="lg:col-span-7 space-y-8" data-aos="fade-right">
          <span class="inline-block px-4 py-2 border-2 border-black bg-black text-white text-[10px] font-mono uppercase tracking-[0.3em] font-pixel">
            Biz Kimiz?
          </span>
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-black uppercase tracking-tighter leading-none mb-8">
            İZMİR'DEN <br/>
            <span class="text-blue-600">DÜNYAYA</span>
          </h1>
          <p class="text-lg md:text-xl text-black/70 font-light leading-relaxed max-w-2xl">
            Evolution Ajans, İzmir'in dinamik ruhunu dijitalin sınırsız gücüyle birleştiren, 360 derece hizmet veren çok yönlü bir reklam ajansıdır.
          </p>
        </div>

        <!-- Right Side: Abstract Visual/Stats -->
        <div class="lg:col-span-5 relative" data-aos="zoom-in" data-aos-delay="200">
           <div class="aspect-square relative flex items-center justify-center">
              <!-- Animated Circle -->
              <div class="absolute inset-0 border-4 border-dashed border-black/10 rounded-full animate-[spin_20s_linear_infinite]"></div>
              <div class="absolute inset-10 border-2 border-black/5 rounded-full animate-[spin_15s_linear_infinite_reverse]"></div>
              
              <div class="text-center space-y-2 z-10">
                <span class="text-5xl md:text-6xl font-bold text-black block tracking-tighter font-pixel">5+</span>
                <span class="text-[9px] font-mono uppercase tracking-[0.4em] text-black/50 block font-pixel">Yıllık Evrim</span>
              </div>
           </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Content Section with Asymmetric Layout -->
  <section class="py-24 bg-white border-y-4 border-black retro-grid">
    <div class="max-w-7xl mx-auto px-6">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-24 items-start">
        
        <div class="space-y-12" data-aos="fade-up">
          <h2 class="text-3xl md:text-4xl font-extrabold uppercase tracking-tight">
            Sadece bir ajans değil, <br/>
            <span class="text-black/50 italic font-light">stratejik bir ortağız.</span>
          </h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-8">
             <div class="space-y-4">
                <div class="w-12 h-12 rounded-none border-2 border-black bg-blue-100 flex items-center justify-center text-blue-600">
                   <Icon name="mdi:flare" size={24} />
                </div>
                <h4 class="text-base font-bold uppercase tracking-wide font-pixel">Yaratıcılık</h4>
                <p class="text-black/60 text-sm leading-relaxed">
                   İzmir'in ilham veren dokusunu modern tasarım trendleriyle harmanlıyoruz.
                </p>
             </div>
             <div class="space-y-4">
                <div class="w-12 h-12 rounded-none border-2 border-black bg-purple-100 flex items-center justify-center text-purple-600">
                   <Icon name="mdi:rocket-launch" size={24} />
                </div>
                <h4 class="text-base font-bold uppercase tracking-wide font-pixel">Teknoloji</h4>
                <p class="text-black/60 text-sm leading-relaxed">
                   En güncel dijital araçları kullanarak markanızın performansını maksimize ediyoruz.
                </p>
             </div>
          </div>
        </div>

        <div class="bg-white p-10 rounded-none border-4 border-black shadow-[8px_8px_0px_0px_rgba(0,0,0,1)] space-y-8" data-aos="fade-left" data-aos-delay="300">
          <p class="text-base md:text-lg text-black/80 leading-relaxed font-light">
            İzmir merkezli ofisimizde, web tasarımdan SEO'ya, sosyal medya yönetiminden kurumsal kimlik inşasına kadar geniş bir yelpazede hizmet veriyoruz. Bizim için her marka, dijital bir evrimin parçasıdır. 
          </p>
          <p class="text-base md:text-lg text-black/80 leading-relaxed font-light">
            Geleneksel reklamcılığın sınırlarını zorluyor, veriye dayalı stratejilerle markanızı sadece görünür değil, aynı zamanda etkileşim kuran bir güce dönüştürüyoruz.
          </p>
          <div class="pt-8 flex items-center gap-4">
             <div class="h-1 w-20 bg-black"></div>
             <span class="text-[9px] font-mono uppercase tracking-[0.3em] text-black/50 font-pixel">Evolution Ads Team</span>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Visual Values Section -->
  <section class="py-32 overflow-hidden bg-white">
    <div class="max-w-7xl mx-auto px-6">
       <div class="flex flex-col items-center text-center mb-24 space-y-6">
          <h3 class="text-3xl md:text-5xl font-black uppercase tracking-tighter" data-aos="fade-up">
            BİZİ <span class="text-purple-600">FARKLI</span> KILAN NE?
          </h3>
          <p class="text-black/50 max-w-xl text-base font-light font-mono" data-aos="fade-up" data-aos-delay="100">
            Sıradan bir ajansın ötesinde, büyüme hedeflerinize odaklanan bir ekosistem sunuyoruz.
          </p>
       </div>

       <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          {[
            { title: "Çok Yönlü Yaklaşım", icon: "mdi:all-inclusive", desc: "360 derece reklamcılık anlayışıyla markanızın her noktasına dokunuyoruz." },
            { title: "Yerel Güç, Küresel Vizyon", icon: "mdi:earth", desc: "İzmir'deki köklerimizden aldığımız güçle küresel standartlarda işler üretiyoruz." },
            { title: "Veri Odaklı Kararlar", icon: "mdi:chart-timeline-variant", desc: "Yaratıcılığımızı sayılarla destekliyor, sonuçları tesadüfe bırakmıyoruz." }
          ].map((val, i) => (
            <div 
              class="group p-10 bg-white border-4 border-black rounded-none hover:bg-slate-50 transition-all duration-300 shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] hover:shadow-[8px_8px_0px_0px_rgba(0,0,0,1)] hover:-translate-x-[4px] hover:-translate-y-[4px]"
              data-aos="fade-up"
              data-aos-delay={i * 150}
            >
              <div class="mb-8 p-4 w-16 h-16 rounded-none border-2 border-black bg-blue-100 flex items-center justify-center text-black group-hover:bg-[#facc15] transition-all duration-300">
                 <Icon name={val.icon} size={32} />
              </div>
              <h4 class="text-xs sm:text-sm font-bold uppercase mb-4 tracking-tight group-hover:text-blue-600 transition-colors duration-300 font-pixel">{val.title}</h4>
              <p class="text-black/70 leading-relaxed transition-colors duration-300">
                {val.desc}
              </p>
            </div>
          ))}
       </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-24 max-w-7xl mx-auto px-6 mb-24 font-pixel" data-aos="zoom-in">
    <div class="relative bg-[#facc15] border-4 border-black rounded-none p-12 md:p-24 overflow-hidden text-center group shadow-[8px_8px_0px_0px_rgba(0,0,0,1)]">
       <h2 class="text-3xl md:text-5xl font-black text-black uppercase tracking-tighter mb-10 relative z-10 leading-none">
          EVRİMİN <br/> BİR PARÇASI OLUN
       </h2>
       <a href="/iletisim" class="inline-flex items-center gap-4 bg-white border-2 border-black text-black px-8 py-4 rounded-none text-xs font-bold uppercase tracking-widest hover:-translate-x-[2px] hover:-translate-y-[2px] hover:shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] active:translate-x-0 active:translate-y-0 active:shadow-none transition-all relative z-10">
          Bizimle Tanışın
          <Icon name="mdi:arrow-right" size={24} />
       </a>
    </div>
  </section>

</MainLayout>

<script>
  import AOS from "aos";
  document.addEventListener("DOMContentLoaded", () => {
    AOS.init({
      duration: 1000,
      once: true,
      easing: 'ease-out-cubic'
    });
  });
</script>