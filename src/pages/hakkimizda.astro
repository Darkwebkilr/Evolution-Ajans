---
import MainLayout from "../layout/mainLayout.astro";
import { Icon } from "astro-icon/components";

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Ana Sayfa",
      "item": "https://evolutionajans.com/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Hakkımızda",
      "item": "https://evolutionajans.com/hakkimizda/"
    }
  ]
};

const aboutPageSchema = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  "name": "Hakkımızda - Evolution Ajans",
  "description": "İzmir merkezli dijital reklam ve web ajansı. Evolution Ajans hakkında detaylı bilgi, felsefemiz ve ekibimiz.",
  "url": "https://evolutionajans.com/hakkimizda/",
  "mainEntity": {
    "@type": "ProfessionalService",
    "@id": "https://evolutionajans.com/#organization"
  }
};
---

<MainLayout 
  title="Hakkımızda | İzmir Web Tasarım ve Reklam Ajansı - Evolution Ajans" 
  description="İzmir merkezli bağımsız dijital atölye. Markanızın büyümesini yöneten, samimi zanaatkarlık ve modern yazılım altyapısını birleştiren çözüm ortağınız."
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(aboutPageSchema)} />

  <!-- Breadcrumbs -->
  <div class="max-w-6xl mx-auto px-6 pt-12">
    <nav class="font-mono text-xs text-[#6E6A62] flex items-center gap-2">
      <a href="/" class="hover:text-[#BE5836] transition-colors">Ana Sayfa</a>
      <span>/</span>
      <span class="text-[#181816] font-medium">Hakkımızda</span>
    </nav>
  </div>

  <!-- Hero Section -->
  <section class="py-16 md:py-24 border-b border-dashed border-[#181816]/15">
    <div class="max-w-6xl mx-auto px-6">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        
        <div class="lg:col-span-8 space-y-6">
          <div class="inline-flex items-center gap-2 text-xs font-mono uppercase tracking-[0.2em] text-[#536248] bg-[#EBF0E6] px-3 py-1 rounded-full border border-[#536248]/20">
            <span class="w-1.5 h-1.5 rounded-full bg-[#536248]"></span>
            <span>[ ATÖLYE HİKAYESİ ]</span>
          </div>

          <h1 class="text-4xl sm:text-5xl md:text-6xl font-serif tracking-tight text-[#181816] leading-[1.1]">
            İzmir'in dinamizmiyle <br />
            <span class="italic font-normal text-[#BE5836]">dijitalde somut sonuçlar</span>.
          </h1>

          <p class="text-base sm:text-lg text-[#4A4742] leading-relaxed max-w-2xl font-sans">
            Evolution Ajans; ezbere şablonların, jenerik ajans klişelerinin ve boşa harcanan reklam bütçelerinin karşısında duran butik bir dijital büyüme atölyesidir.
          </p>
        </div>

        <div class="lg:col-span-4">
          <div class="bg-white border border-[#181816]/12 rounded-[28px] p-8 shadow-[0_4px_24px_rgba(24,24,22,0.03)] space-y-4">
            <span class="text-xs font-mono text-[#536248] uppercase tracking-widest block">
              [ 2026 GÜNCELLEMESİ ]
            </span>
            <p class="font-serif text-xl text-[#181816]">
              "Daha fazla gösterim değil; daha fazla doğrulanmış müşteri telefonu."
            </p>
            <div class="pt-4 border-t border-[#181816]/10 text-xs font-mono text-[#6E6A62]">
              Folkart Towers, Bayraklı / İzmir
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Philosophy & Details -->
  <section class="py-24 bg-[#F4EFE6] border-b border-dashed border-[#181816]/15">
    <div class="max-w-6xl mx-auto px-6">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        
        <div class="bg-white border border-[#181816]/12 rounded-[24px] p-8 shadow-sm space-y-4">
          <span class="font-mono text-xs text-[#BE5836] uppercase tracking-wider block">01 // ŞEFFAFLIK</span>
          <h2 class="font-serif text-2xl text-[#181816]">Gizli Komisyon Yok</h2>
          <p class="text-sm text-[#4A4742] leading-relaxed">
            Google ve Meta reklam panelleri doğrudan sizin adınıza açılır, harcamaları kuruşu kuruşuna canlı izlersiniz.
          </p>
        </div>

        <div class="bg-white border border-[#181816]/12 rounded-[24px] p-8 shadow-sm space-y-4">
          <span class="font-mono text-xs text-[#536248] uppercase tracking-wider block">02 // HIZ & ERİŞİM</span>
          <h2 class="font-serif text-2xl text-[#181816]">Astro SSG Mimarisi</h2>
          <p class="text-sm text-[#4A4742] leading-relaxed">
            Ağır WordPress eklentileriyle boğuşmak yerine şimşek hızında statik kodlama ile Google PageSpeed 95+ garantisi.
          </p>
        </div>

        <div class="bg-white border border-[#181816]/12 rounded-[24px] p-8 shadow-sm space-y-4">
          <span class="font-mono text-xs text-[#BE5836] uppercase tracking-wider block">03 // BÖLGESEL SEO</span>
          <h2 class="font-serif text-2xl text-[#181816]">Harita Hakimiyeti</h2>
          <p class="text-sm text-[#4A4742] leading-relaxed">
            İzmir'in 30 ilçesinde mahalle bazlı yerel aramalarda telefonunuzun çalmasını sağlayan kalıcı optimizasyon.
          </p>
        </div>

      </div>
    </div>
  </section>

</MainLayout>
