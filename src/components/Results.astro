---
import { Icon } from "astro-icon/components";

const results = [
  {
    title: "Google Ads Raporu",
    description: "Yönettiğimiz kampanyalardan biri olan Google Ads arama ağı reklamlarının gösterim, tıklama ve maliyet detaylarını içeren canlı sistem panel ekranı.",
    metric: "Google Ads Paneli",
    image: "/google-ads-ss.png",
    badge: "PANEL GÖRÜNTÜSÜ",
    color: "text-green-600"
  },
  {
    title: "Google Ads Ham Müşteri Listesi",
    description: "Google Ads reklamları üzerinden web sitemize gelip form dolduran veya doğrudan telefonla arayan potansiyel müşterilerin anlık çağrı ve talep listesi.",
    metric: "Ham Müşteri Listesi",
    image: "/google-ads-ham-musteriler.png",
    badge: "MÜŞTERİ LİSTESİ",
    color: "text-blue-600"
  },
  {
    title: "Meta Ads Form Paneli",
    description: "Instagram ve Facebook üzerinde aktif olan form toplama kampanyalarımızın form sayılarını, gösterimlerini ve erişim verilerini gösteren Meta Business reklam paneli ekranı.",
    metric: "Meta Ads Paneli",
    image: "/meta-ads-ss.png",
    badge: "FORM VERİLERİ",
    color: "text-purple-600"
  }
];
---

<section id="sonuclar" class="py-32 bg-slate-50 border-t-4 border-black relative z-10 retro-grid">
  <div class="max-w-7xl mx-auto px-6">
    
    <!-- Title -->
    <div class="text-center mb-28 space-y-4">
      <span class="inline-block px-4 py-2 border-2 border-black bg-black text-white text-xs md:text-sm font-mono uppercase tracking-[0.3em] font-pixel">
        Canlı Panel Kanıtları
      </span>
      <h2 class="text-4xl md:text-6xl font-black uppercase tracking-tighter text-black">
        GERÇEK SONUÇLAR
      </h2>
      <p class="text-black/75 max-w-2xl mx-auto text-lg md:text-xl font-medium">
        Yönettiğimiz panellerden alınan gerçek ekran görüntüleri. Resimlerin üzerine tıklayarak tam boyutta büyütebilir ve verileri detaylıca inceleyebilirsiniz.
      </p>
    </div>

    <!-- Stacked Vertical Showcase List -->
    <div class="space-y-32">
      {results.map((item, index) => (
        <div class="flex flex-col gap-10 items-stretch" data-aos="fade-up">
          
          <!-- Text Header Above Image -->
          <div class="max-w-5xl mx-auto w-full space-y-4 border-l-4 border-black pl-6">
            <div class="flex flex-wrap items-center gap-3">
              <span class="text-[10px] font-mono bg-black text-white px-3 py-1.5 uppercase tracking-wider font-bold font-pixel">
                {item.badge}
              </span>
              <span class={`text-lg md:text-xl font-black font-pixel tracking-tighter ${item.color}`}>
                ★ {item.metric}
              </span>
            </div>
            <h3 class="text-2xl md:text-3xl font-black text-black font-pixel uppercase tracking-tight">
              {item.title}
            </h3>
            <p class="text-black/85 text-base md:text-lg leading-relaxed font-mono">
              {item.description}
            </p>
          </div>

          <!-- Large Image Wrapper -->
          <div class="w-full max-w-5xl mx-auto relative group overflow-hidden border-4 border-black bg-white shadow-[8px_8px_0px_rgba(0,0,0,1)] hover:shadow-[12px_12px_0px_rgba(0,0,0,1)] hover:-translate-x-[4px] hover:-translate-y-[4px] transition-all duration-300">
            <img 
              src={item.image} 
              alt={item.title} 
              class="zoomable-image w-full h-auto object-contain cursor-zoom-in" 
            />
            
            <!-- Floating Zoom Icon -->
            <div class="absolute bottom-6 right-6 bg-black text-white border-2 border-white px-4 py-2 font-pixel text-xs flex items-center gap-2 uppercase tracking-wider opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none select-none">
              <Icon name="mdi:magnify-plus" size={16} />
              <span>Tam Boyut Gör</span>
            </div>
          </div>

        </div>
      ))}
    </div>

  </div>
</section>

<!-- Lightbox Modal -->
<div id="lightbox-modal" class="fixed inset-0 z-[150] bg-black/95 hidden flex items-center justify-center p-4 cursor-zoom-out select-none">
  <div class="relative max-w-5xl max-h-[85vh] w-full h-full flex items-center justify-center">
    <!-- Close button -->
    <button id="lightbox-close" class="absolute -top-12 right-0 text-white hover:text-red-500 font-mono text-xs font-bold uppercase tracking-widest flex items-center gap-2 px-4 py-2 border-2 border-white hover:border-red-500 bg-black transition-all">
      KAPAT [ESC]
    </button>
    <!-- Image -->
    <img id="lightbox-image" src="" alt="Zoomed Result" class="max-w-full max-h-full object-contain border-4 border-white shadow-[0_0_50px_rgba(255,255,255,0.15)]" />
  </div>
</div>

<script>
  const images = document.querySelectorAll('.zoomable-image') as NodeListOf<HTMLImageElement>;
  const modal = document.getElementById('lightbox-modal');
  const modalImg = document.getElementById('lightbox-image') as HTMLImageElement;
  const closeBtn = document.getElementById('lightbox-close');

  images.forEach(img => {
    img.addEventListener('click', () => {
      if (modal && modalImg) {
        modalImg.src = img.src;
        modalImg.alt = img.alt;
        modal.classList.remove('hidden');
        document.body.style.overflow = 'hidden'; // stop scrolling
      }
    });
  });

  function closeModal() {
    if (modal) {
      modal.classList.add('hidden');
      document.body.style.overflow = ''; // restore scrolling
    }
  }

  if (modal) {
    modal.addEventListener('click', (e) => {
      // Close only if clicked outside the image itself or close button
      if (e.target === modal || e.target === closeBtn || (e.target as HTMLElement).closest('#lightbox-close')) {
        closeModal();
      }
    });
  }

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      closeModal();
    }
  });
</script>
