---
import { Icon } from "astro-icon/components";

const results = [
  {
    title: "1 Ayda Kazandırılan Potansiyel Müşteri Araması",
    description: "Yerel lojistik ve nakliyat sektöründeki iş ortağımız için optimize edilmiş Google Ads arama kampanyası.",
    metric: "+480 Arama",
    color: "text-green-600"
  },
  {
    title: "Google Ads Optimizasyonu Sonrası Arama Maliyeti",
    description: "Tıklama başına maliyetleri düşürerek aynı bütçeyle %120 daha fazla telefon araması topladık.",
    metric: "-55% Maliyet",
    color: "text-blue-600"
  },
  {
    title: "Meta Ads Kampanyası ile Elde Edilen Form Talepleri",
    description: "Instagram ve Facebook form reklamları üzerinden doğrudan dönüşüm odaklı potansiyel müşteri datası.",
    metric: "180+ Form",
    color: "text-purple-600"
  }
];
---

<section id="sonuclar" class="py-24 bg-white border-t-4 border-black relative z-10">
  <div class="max-w-7xl mx-auto px-6">
    
    <!-- Title -->
    <div class="text-center mb-20 space-y-4">
      <span class="inline-block px-4 py-2 border-2 border-black bg-black text-white text-xs md:text-sm font-mono uppercase tracking-[0.3em] font-pixel">
        Kanıtlanmış Veriler
      </span>
      <h2 class="text-4xl md:text-6xl font-black uppercase tracking-tighter text-black">
        GERÇEK SONUÇLAR
      </h2>
      <p class="text-black/75 max-w-2xl mx-auto text-lg md:text-xl font-medium">
        Süslü sözler değil, net rakamlar. Yönettiğimiz panellerden aldığımız büyüme grafiklerinin özet sonuçları.
      </p>
    </div>

    <!-- Graphics Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {results.map((item, index) => (
        <div class="bg-white border-4 border-black p-6 md:p-8 rounded-none shadow-[4px_4px_0px_rgba(0,0,0,1)] hover:-translate-x-[2px] hover:-translate-y-[2px] hover:shadow-[6px_6px_0px_rgba(0,0,0,1)] transition-all flex flex-col justify-between" data-aos="fade-up" data-aos-delay={index * 100}>
          <div class="space-y-6">
            <!-- Visual Graphic Placeholder (Dashed border, grid back) -->
            <div class="aspect-video w-full border-4 border-dashed border-black/20 bg-slate-50 flex flex-col items-center justify-center relative overflow-hidden group select-none">
              <!-- Grid BG inside placeholder -->
              <div class="absolute inset-0 opacity-[0.03]" style="background-image: linear-gradient(rgba(0,0,0,1) 1px, transparent 1px), linear-gradient(90deg, rgba(0,0,0,1) 1px, transparent 1px); background-size: 15px 15px;"></div>
              
              <!-- Metric Label -->
              <span class={`text-4xl md:text-5xl font-black font-pixel relative z-10 tracking-tighter ${item.color}`}>
                {item.metric}
              </span>
              <span class="text-[10px] md:text-xs font-mono text-black/30 font-pixel uppercase mt-2 relative z-10">[ PANEL_GRAFIK.PNG ]</span>
            </div>

            <!-- Title -->
            <h3 class="text-sm sm:text-base lg:text-lg font-bold text-black font-pixel uppercase leading-relaxed tracking-tight">
              {item.title}
            </h3>

            <!-- Description -->
            <p class="text-black/80 text-base leading-relaxed font-mono">
              {item.description}
            </p>
          </div>

          <!-- Bottom Action indicator -->
          <div class="mt-8 border-t-2 border-black/10 pt-4 flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-green-500 animate-pulse"></span>
            <span class="text-[10px] md:text-xs font-mono text-black/50 font-pixel uppercase">Canlı Kampanya Sonucu</span>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
