---
import { Icon } from "astro-icon/components";
---

<div class="fixed bottom-6 right-6 md:bottom-8 md:right-8 z-50 flex flex-col items-end gap-2 pointer-events-none">
  
  <!-- Tooltip Message -->
  <div class="wp-tooltip bg-white text-[#181816] border border-[#181816]/12 px-3.5 py-1.5 rounded-full text-xs font-mono opacity-0 translate-y-1 transition-all duration-300 pointer-events-none shadow-md">
    <span>Hızlı WhatsApp Analizi ☕</span>
  </div>

  <a
    href="https://wa.me/905519283598?text=Merhaba,%20sitemin%20ve%20reklamlarımın%20ücretsiz%20analizi%20için%20ulaşıyorum."
    target="_blank"
    class="relative group pointer-events-auto flex items-center justify-center w-13 h-13 md:w-14 md:h-14 rounded-full bg-[#536248] text-white hover:bg-[#3E4A35] transition-all duration-300 shadow-[0_4px_20px_rgba(83,98,72,0.35)] hover:scale-105"
    aria-label="WhatsApp üzerinden iletişime geçin"
  >
    <Icon 
      name="mdi:whatsapp" 
      class="w-7 h-7 text-white" 
    />
  </a>
</div>

<style>
  .fixed:has(a:hover) .wp-tooltip {
    opacity: 1;
    transform: translateY(0);
  }
</style>
