---
import { Icon } from "astro-icon/components";
---

<div class="fixed bottom-6 right-6 md:bottom-8 md:right-8 z-50 flex flex-col items-end gap-3 pointer-events-none">
  
  <!-- Tooltip Message -->
  <div class="wp-tooltip bg-[#facc15] text-black border-2 border-black px-3 py-1.5 rounded-none text-[8px] font-pixel uppercase opacity-0 translate-y-2 transition-all duration-300 pointer-events-none shadow-[2px_2px_0px_rgba(0,0,0,1)]">
    Bir Kahve İçelim! ☕
  </div>

  <a
    href="https://wa.me/905519283598"
    target="_blank"
    class="relative group pointer-events-auto flex items-center justify-center w-14 h-14 md:w-16 md:h-16 rounded-none bg-[#25D366] border-4 border-black transition-all duration-300 shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] hover:-translate-x-[2px] hover:-translate-y-[2px] hover:shadow-[6px_6px_0px_0px_rgba(0,0,0,1)] active:translate-x-0 active:translate-y-0 active:shadow-none"
    aria-label="WhatsApp üzerinden iletişime geçin"
  >
    <!-- Icon -->
    <Icon 
      name="mdi:whatsapp" 
      class="w-8 h-8 md:w-9 md:h-9 text-black relative z-10 group-hover:scale-105 transition-transform duration-300" 
    />
  </a>
</div>

<style>
  /* Show tooltip when hovering the button */
  .fixed:has(a:hover) .wp-tooltip {
    opacity: 1;
    transform: translateY(0);
  }
</style>