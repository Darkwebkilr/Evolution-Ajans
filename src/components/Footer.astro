---
import { Icon } from "astro-icon/components";
import { districts } from "./data/districts.js";
const today = new Date();

const company = [
  { name: "Hakkımızda", link: "/hakkimizda/" },
  { name: "Başarı Hikayeleri", link: "/basari/" },
  { name: "Büyüme Paketleri", link: "/paketler/" },
  { name: "Hizmet Bölgeleri", link: "/hizmet-bolgeleri/" },
  { name: "Blog & Rehber", link: "/blog/" },
  { name: "İletişim", link: "/iletisim/" },
];

const services = [
  { name: "Yüksek Dönüşümlü Web Tasarım", link: "/#services" },
  { name: "Google Ads Reklam Yönetimi", link: "/#services" },
  { name: "Google Haritalar Yerel SEO", link: "/#services" },
  { name: "Meta Ads Reklam Yönetimi", link: "/#services" },
];

const socials = [
  { icon: "mdi:instagram", link: "https://www.instagram.com/evolutionajans" },
  { icon: "mdi:linkedin", link: "https://www.linkedin.com/company/evolutionajans" },
];
---

<footer class="relative bg-[#F4EFE6] pt-20 pb-12 overflow-hidden border-t border-dashed border-[#181816]/15 text-[#181816]">
  <div class="max-w-6xl mx-auto px-6 relative z-10">
    
    <!-- Top Editorial Call to Action -->
    <div class="flex flex-col md:flex-row justify-between items-start md:items-end gap-8 mb-16 pb-12 border-b border-[#181816]/10">
      <div class="max-w-xl">
        <span class="text-xs font-mono uppercase tracking-[0.2em] text-[#536248] block mb-2">
          [ DİJİTAL DÖNÜŞÜM ATÖLYESİ ]
        </span>
        <h2 class="text-3xl sm:text-4xl md:text-5xl font-serif tracking-tight text-[#181816]">
          Birlikte yeni bir <br />
          <span class="italic font-normal text-[#BE5836]">büyüme sayfası açalım</span>.
        </h2>
      </div>

      <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3">
        <a 
          href="mailto:ismethaktan39@gmail.com" 
          class="px-5 py-3 rounded-full bg-white border border-[#181816]/15 text-xs font-mono uppercase tracking-wider text-[#181816] hover:border-[#BE5836] transition-colors shadow-sm"
        >
          ismethaktan39@gmail.com
        </a>
        <a 
          href="tel:+905519283598" 
          class="px-6 py-3 rounded-full bg-[#BE5836] text-white text-xs font-mono uppercase tracking-wider hover:bg-[#9E4324] transition-colors shadow-sm text-center"
        >
          +90 551 928 35 98
        </a>
      </div>
    </div>

    <!-- Main Links Columns -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-10 mb-16">
      
      <!-- Studio Intro (5 Cols) -->
      <div class="md:col-span-5 space-y-4">
        <span class="font-serif text-2xl tracking-tight text-[#181816] block">
          Evolution <span class="italic text-[#BE5836]">Ajans</span>
        </span>
        <p class="text-sm text-[#6E6A62] leading-relaxed max-w-sm">
          İzmir merkezli yerel dijital dönüşüm ve performans atölyesi. Sadece telefon çaldıran ve ölçülebilir büyüme üreten sistemlere odaklanıyoruz.
        </p>
        <div class="flex gap-2 pt-2">
          {socials.map(social => (
            <a 
              href={social.link} 
              target="_blank"
              class="w-9 h-9 rounded-full bg-white border border-[#181816]/15 flex items-center justify-center text-[#4A4742] hover:text-[#BE5836] hover:border-[#BE5836] transition-all"
            >
              <Icon name={social.icon} size={18} />
            </a>
          ))}
        </div>
      </div>

      <!-- Company Links (3 Cols) -->
      <div class="md:col-span-3 space-y-3">
        <p class="text-[11px] font-mono uppercase tracking-widest text-[#536248]">Kurumsal</p>
        <ul class="space-y-2 text-xs font-mono text-[#4A4742]">
          {company.map(item => (
            <li>
              <a href={item.link} class="hover:text-[#BE5836] transition-colors">
                {item.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Services Links (4 Cols) -->
      <div class="md:col-span-4 space-y-3">
        <p class="text-[11px] font-mono uppercase tracking-widest text-[#536248]">Odak Çözümler</p>
        <ul class="space-y-2 text-xs font-mono text-[#4A4742]">
          {services.map(item => (
            <li>
              <a href={item.link} class="hover:text-[#BE5836] transition-colors">
                {item.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

    </div>

    <!-- Districts Directory -->
    <div class="border-t border-dashed border-[#181816]/12 pt-8 mb-12">
      <div class="text-[11px] font-mono uppercase tracking-widest text-[#536248] mb-3">
        İzmir Bölgesel SEO Kapsama Alanımız (30 İlçe):
      </div>
      <div class="flex flex-wrap gap-x-3 gap-y-2 text-xs font-mono text-[#6E6A62]">
        {districts.map((d, index) => (
          <span>
            <a href={`/hizmet-bolgeleri/${d.slug}/`} class="hover:text-[#BE5836] transition-colors">
              {d.name}
            </a>
            {index < districts.length - 1 && <span class="text-[#181816]/20 ml-2">/</span>}
          </span>
        ))}
      </div>
    </div>

    <!-- Bottom Copyright -->
    <div class="border-t border-[#181816]/10 pt-8 flex flex-col sm:flex-row justify-between items-center gap-4 text-xs font-mono text-[#6E6A62]">
      <p>© {today.getFullYear()} EVOLUTION AJANS. İzmir / Folkart Towers.</p>
      <div class="flex gap-6">
        <a href="/gizlilik/" class="hover:text-[#BE5836] transition-colors">Gizlilik Politikası</a>
        <a href="/sartlar/" class="hover:text-[#BE5836] transition-colors">Kullanım Şartları</a>
      </div>
    </div>

  </div>
</footer>
