---
import { Icon } from "astro-icon/components";
import { districts } from "./data/districts.js";
const today = new Date();

const services = [
  { name: "Yüksek Dönüşümlü Web Tasarım", link: "#services" },
  { name: "Google Ads Reklamları", link: "#services" },
  { name: "Meta Ads Reklamları", link: "#services" },
];

const company = [
  { name: "Gerçek Sonuçlar", link: "#sonuclar" },
  { name: "Hizmetlerimiz", link: "#services" },
  { name: "Hizmet Bölgeleri", link: "/hizmet-bolgeleri/" },
  { name: "Ücretsiz Analiz", link: "#iletisim" },
];

const socials = [
  { icon: "mdi:instagram", link: "#" },
  { icon: "mdi:linkedin", link: "#" },
  { icon: "mdi:twitter", link: "#" },
  { icon: "mdi:youtube", link: "#" },
];
---

<footer class="relative bg-white pt-24 pb-8 overflow-hidden border-t-4 border-black retro-grid text-black">
  
  <div class="max-w-7xl mx-auto px-6 lg:px-12 relative z-10">
    
    <!-- Top Section: Big Call to Action -->
    <div class="flex flex-col md:flex-row justify-between items-start md:items-end gap-10 mb-20 border-b-2 border-black/10 pb-16">
      <div class="max-w-2xl">
        <h2 class="text-4xl md:text-6xl font-black text-black uppercase tracking-tighter mb-4 font-pixel">
          Birlikte <br/>
          <span class="text-blue-600 block mt-2">Büyüyelim</span>
        </h2>
        <p class="text-black/75 text-lg md:text-xl font-medium">Dijital dönüşümünüzü başlatmak için bir kahve içelim.</p>
      </div>
      <a href="mailto:hello@evolution.com" class="group relative inline-flex items-center justify-center px-6 py-4 bg-[#facc15] text-black border-2 border-black font-bold uppercase tracking-widest text-sm rounded-none hover:-translate-x-[2px] hover:-translate-y-[2px] hover:shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] transition-all font-pixel">
        <span class="relative z-10">hello@evolution.com</span>
      </a>
    </div>

    <!-- Middle Section: Links -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 mb-20">
      
      <!-- Brand Info -->
      <div class="lg:col-span-1">
        <div class="inline-flex items-center gap-2 mb-6">
          <Icon name="mdi:flare" class="text-blue-600" size={24} />
          <span class="text-xl font-black tracking-widest uppercase text-black font-pixel">EVOLUTION</span>
        </div>
        <p class="text-black/75 text-base leading-relaxed mb-6">
          İzmir merkezli yeni nesil reklam ve teknoloji ajansı. Markanızı geleceğe taşıyoruz.
        </p>
        <div class="flex gap-4">
          {socials.map(social => (
            <a href={social.link} class="w-10 h-10 border-2 border-black rounded-none flex items-center justify-center text-black/60 hover:text-black hover:bg-slate-100 transition-all duration-300">
              <Icon name={social.icon} size={20} />
            </a>
          ))}
        </div>
      </div>

      <!-- Hizmet Bölgeleri -->
      <div>
        <h4 class="text-[11px] sm:text-xs font-mono uppercase tracking-[0.2em] text-black/60 mb-6 font-pixel">Bölgeler</h4>
        <ul class="space-y-3">
          <li><a href="/hizmet-bolgeleri/bornova/" class="text-black/80 hover:text-black text-sm transition-colors font-medium">Bornova</a></li>
          <li><a href="/hizmet-bolgeleri/karsiyaka/" class="text-black/80 hover:text-black text-sm transition-colors font-medium">Karşıyaka</a></li>
          <li><a href="/hizmet-bolgeleri/konak/" class="text-black/80 hover:text-black text-sm transition-colors font-medium">Konak</a></li>
          <li><a href="/hizmet-bolgeleri/buca/" class="text-black/80 hover:text-black text-sm transition-colors font-medium">Buca</a></li>
          <li><a href="/hizmet-bolgeleri/bayrakli/" class="text-black/80 hover:text-black text-sm transition-colors font-medium">Bayraklı</a></li>
          <li><a href="/hizmet-bolgeleri/" class="text-blue-600 hover:underline font-pixel text-xs pt-1 block font-bold">Tüm 30 Bölge →</a></li>
        </ul>
      </div>

      <!-- Services -->
      <div>
        <h4 class="text-[11px] sm:text-xs font-mono uppercase tracking-[0.2em] text-black/60 mb-6 font-pixel">Hizmetlerimiz</h4>
        <ul class="space-y-4">
          {services.map(item => (
            <li>
              <a href={item.link} class="text-black/80 hover:text-black text-base transition-colors relative group font-semibold">
                {item.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Company -->
      <div>
        <h4 class="text-[11px] sm:text-xs font-mono uppercase tracking-[0.2em] text-black/60 mb-6 font-pixel">Ajans</h4>
        <ul class="space-y-4">
          {company.map(item => (
            <li>
              <a href={item.link} class="text-black/80 hover:text-black text-base transition-colors relative group font-semibold">
                {item.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

    </div>

    <!-- SEO Internal Linking: All Districts -->
    <div class="border-t-2 border-black/10 pt-8 pb-10">
      <div class="flex items-center gap-3 mb-4">
        <span class="text-xs font-mono font-bold uppercase tracking-wider text-black/60 font-pixel">İzmir Hizmet Bölgelerimiz:</span>
      </div>
      <div class="flex flex-wrap gap-x-3 gap-y-2 text-xs font-mono text-black/70">
        {districts.map((d, index) => (
          <span>
            <a href={`/hizmet-bolgeleri/${d.slug}/`} class="hover:text-black hover:underline transition-colors">
              {d.name}
            </a>
            {index < districts.length - 1 && <span class="text-black/30 ml-2">/</span>}
          </span>
        ))}
      </div>
    </div>

    <!-- Bottom Section: Giant Text & Copyright -->
    <div class="relative flex flex-col items-center border-t-2 border-black/10 pt-8">
      <!-- Huge Background Text -->
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-full text-center pointer-events-none opacity-[0.03] select-none overflow-hidden">
        <span class="text-[12vw] font-black uppercase tracking-tighter whitespace-nowrap text-black">EVOLUTION</span>
      </div>
      
      <div class="w-full flex flex-col md:flex-row justify-between items-center gap-4 relative z-10">
        <p class="text-black/50 text-[10px] sm:text-xs font-mono uppercase tracking-widest font-pixel">
          © {today.getFullYear()} EVOLUTION AJANS.
        </p>
        <div class="flex gap-6">
          <a href="/gizlilik/" class="text-black/50 hover:text-black text-[10px] sm:text-xs font-mono uppercase tracking-widest transition-colors font-pixel">Gizlilik Politikası</a>
          <a href="/sartlar/" class="text-black/50 hover:text-black text-[10px] sm:text-xs font-mono uppercase tracking-widest transition-colors font-pixel">Kullanım Şartları</a>
        </div>
      </div>
    </div>

  </div>
</footer>