---
import { districts } from "./data/districts.js";
import { Icon } from "astro-icon/components";

const popularSlugs = [
  "konak",
  "bornova",
  "karsiyaka",
  "bayrakli",
  "buca",
  "cigli",
  "gaziemir",
  "cesme",
  "urla",
  "torbali",
  "balcova",
  "menemen"
];

const popularDistricts = popularSlugs
  .map(slug => districts.find(d => d.slug === slug))
  .filter(Boolean);
---

<section class="py-24 md:py-36 bg-[#F4EFE6] relative z-10 border-b border-dashed border-[#181816]/15">
  <div class="max-w-6xl mx-auto px-6">
    
    <!-- Section Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-16 pb-8 border-b border-[#181816]/10">
      <div class="space-y-4 max-w-2xl">
        <div class="inline-flex items-center gap-2 text-xs font-mono uppercase tracking-[0.2em] text-[#536248] bg-[#EBF0E6] px-3 py-1 rounded-full border border-[#536248]/20">
          <span class="w-1.5 h-1.5 rounded-full bg-[#536248]"></span>
          <span>[ 05 // YEREL HİZMET AĞI ]</span>
        </div>
        <h2 class="text-3xl sm:text-4xl md:text-5xl font-serif tracking-tight text-[#181816]">
          İzmir geneli <span class="italic font-normal text-[#536248]">bölgesel optimizasyon</span>.
        </h2>
        <p class="text-[#6E6A62] text-sm sm:text-base leading-relaxed">
          Google Haritalar ve yerel aramalarda esnaf ve işletmelerin kendi ilçelerinde ilk sırada listelenmesini sağlıyoruz.
        </p>
      </div>

      <a 
        href="/hizmet-bolgeleri/" 
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-white border border-[#181816]/15 text-[#181816] text-xs uppercase tracking-widest font-mono hover:bg-[#BE5836] hover:text-white hover:border-[#BE5836] transition-all self-start md:self-end shadow-sm"
      >
        <span>Tüm 30 İlçeyi İncele</span>
        <span class="text-xs">→</span>
      </a>
    </div>

    <!-- 12-District Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {popularDistricts.map((dist) => (
        <a 
          href={`/hizmet-bolgeleri/${dist.slug}/`}
          class="group bg-white border border-[#181816]/10 rounded-[20px] p-6 hover:border-[#BE5836]/40 hover:-translate-y-0.5 transition-all duration-300 flex flex-col justify-between shadow-[0_2px_12px_rgba(24,24,22,0.02)]"
        >
          <div>
            <div class="flex items-center justify-between gap-2 border-b border-dashed border-[#181816]/10 pb-3 mb-3">
              <span class="text-xs font-mono uppercase tracking-widest text-[#536248] group-hover:text-[#BE5836] transition-colors">
                İzmir / {dist.name}
              </span>
              <span class="text-xs text-[#6E6A62] font-mono">
                {dist.distance}
              </span>
            </div>

            <h3 class="font-serif text-xl text-[#181816] group-hover:text-[#BE5836] transition-colors mb-2">
              {dist.name} Dijital Çözümler
            </h3>

            <p class="text-xs text-[#6E6A62] line-clamp-2 leading-relaxed">
              {dist.overview}
            </p>
          </div>

          <div class="pt-4 mt-4 border-t border-[#181816]/8 flex items-center justify-between text-xs font-mono text-[#6E6A62]">
            <span class="group-hover:text-[#BE5836] transition-colors">Bölge Sayfasına Git</span>
            <span class="group-hover:translate-x-1 group-hover:text-[#BE5836] transition-all">→</span>
          </div>
        </a>
      ))}
    </div>

  </div>
</section>
