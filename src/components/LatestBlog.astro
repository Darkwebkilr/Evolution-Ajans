---
import { getCollection } from "astro:content";

const latestPosts = (
  await getCollection("blog", ({ data }) => {
    return !data.isDraft;
  })
)
  .sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime())
  .slice(0, 3);
---

<section class="py-24 bg-[#f8fafc] border-t-4 border-black relative z-10 retro-grid">
  <div class="max-w-7xl mx-auto px-6">
    <!-- Section Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-16 gap-6">
      <div class="space-y-4 max-w-2xl" data-aos="fade-right">
        <span class="inline-block px-4 py-2 border-2 border-black bg-black text-white text-[10px] font-mono uppercase tracking-[0.3em] font-pixel">
          Blog & Dijital Rehber
        </span>
        <h2 class="text-3xl sm:text-4xl md:text-5xl font-black uppercase tracking-tighter text-black font-pixel">
          GÜNCEL YAZILARIMIZ
        </h2>
        <p class="text-black/70 font-mono text-sm sm:text-base leading-relaxed">
          İzmir web tasarım, SEO, Meta Ads ve dönüşüm optimizasyonu hakkında en son sektörel analizler ve pratik rehberler.
        </p>
      </div>

      <div data-aos="fade-left">
        <a
          href="/blog/"
          class="inline-flex items-center gap-3 px-6 py-3 border-4 border-black bg-[#facc15] text-black font-pixel font-black text-xs uppercase shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] hover:-translate-x-[2px] hover:-translate-y-[2px] hover:shadow-[6px_6px_0px_0px_rgba(0,0,0,1)] active:translate-x-0 active:translate-y-0 transition-all"
        >
          <span>Tüm Yazıları Gör</span>
          <span class="text-base">→</span>
        </a>
      </div>
    </div>

    <!-- 3 Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {latestPosts.map((post, index) => (
        <article
          class="group bg-white border-4 border-black p-6 sm:p-8 rounded-none shadow-[6px_6px_0px_0px_rgba(0,0,0,1)] hover:-translate-x-[4px] hover:-translate-y-[4px] hover:shadow-[10px_10px_0px_0px_rgba(0,0,0,1)] transition-all duration-300 flex flex-col justify-between"
          data-aos="fade-up"
          data-aos-delay={index * 100}
        >
          <div>
            <!-- Header: Date & Tag -->
            <div class="flex items-center justify-between gap-2 mb-4 pb-3 border-b-2 border-black/10">
              <span class="text-[10px] font-mono text-black/60 font-pixel">
                {new Date(post.data.pubDate).toLocaleDateString("tr-TR", {
                  day: "numeric",
                  month: "short",
                  year: "numeric"
                })}
              </span>
              {post.data.tags && post.data.tags[0] && (
                <span class="text-[9px] font-mono uppercase bg-black text-white px-2 py-0.5 font-bold">
                  #{post.data.tags[0]}
                </span>
              )}
            </div>

            <!-- Title -->
            <h3 class="text-base sm:text-lg font-black text-black mb-4 font-pixel uppercase tracking-tight group-hover:text-blue-600 transition-colors leading-snug">
              <a href={`/blog/${post.id}/`}>
                {post.data.title}
              </a>
            </h3>

            <!-- Description snippet -->
            <p class="text-black/70 font-mono text-xs leading-relaxed mb-6 line-clamp-3">
              {post.data.description}
            </p>
          </div>

          <!-- Card Footer -->
          <div class="pt-4 border-t-2 border-black/10 flex items-center justify-between">
            <a
              href={`/blog/${post.id}/`}
              class="text-[11px] uppercase tracking-wider font-pixel font-black text-black group-hover:underline underline-offset-4 flex items-center gap-2"
            >
              <span>Devamını Oku</span>
              <span class="group-hover:translate-x-1 transition-transform">→</span>
            </a>
            <span class="text-[9px] font-mono text-black/40 uppercase">
              {post.data.author}
            </span>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
