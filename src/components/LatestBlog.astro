---
import { getCollection } from "astro:content";

const latestPosts = (
  await getCollection("blog", ({ data }) => {
    return !data.isDraft;
  })
)
  .sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime())
  .slice(0, 3);
---

<section class="py-24 md:py-36 bg-[#F4EFE6] border-b border-dashed border-[#181816]/15 relative z-10">
  <div class="max-w-6xl mx-auto px-6">
    
    <!-- Section Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-16 gap-6 pb-8 border-b border-[#181816]/10">
      <div class="space-y-4 max-w-2xl">
        <div class="inline-flex items-center gap-2 text-xs font-mono uppercase tracking-[0.2em] text-[#536248] bg-[#EBF0E6] px-3 py-1 rounded-full border border-[#536248]/20">
          <span class="w-1.5 h-1.5 rounded-full bg-[#536248]"></span>
          <span>[ 07 // BİLGİ MERKEZİ ]</span>
        </div>
        <h2 class="text-3xl sm:text-4xl md:text-5xl font-serif tracking-tight text-[#181816]">
          Editoryal rehberler ve <span class="italic font-normal text-[#536248]">içgörüler</span>.
        </h2>
        <p class="text-[#6E6A62] text-sm sm:text-base leading-relaxed">
          İzmir web tasarım, SEO algoritmaları, yerel sıralamalar ve reklam optimizasyonu üzerine samimi analizler.
        </p>
      </div>

      <a
        href="/blog/"
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-white border border-[#181816]/15 text-[#181816] text-xs uppercase tracking-widest font-mono hover:bg-[#BE5836] hover:text-white hover:border-[#BE5836] transition-all self-start md:self-end shadow-sm"
      >
        <span>Tüm Yazıları Gör</span>
        <span class="text-xs">→</span>
      </a>
    </div>

    <!-- 3 Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {latestPosts.map((post) => (
        <article
          class="group bg-white border border-[#181816]/12 rounded-[24px] p-8 shadow-[0_4px_20px_rgba(24,24,22,0.03)] hover:border-[#BE5836]/40 hover:-translate-y-1 transition-all duration-300 flex flex-col justify-between"
        >
          <div>
            <!-- Date & Author -->
            <div class="flex items-center justify-between gap-2 mb-5 pb-4 border-b border-dashed border-[#181816]/10">
              <time datetime={new Date(post.data.pubDate).toISOString()} class="text-xs font-mono text-[#6E6A62]">
                {new Date(post.data.pubDate).toLocaleDateString("tr-TR", { day: "numeric", month: "long", year: "numeric" })}
              </time>
              <span class="text-[10px] font-mono uppercase bg-[#EBF0E6] text-[#536248] px-2.5 py-0.5 rounded-full">
                {post.data.author}
              </span>
            </div>

            <!-- Title -->
            <h3 class="font-serif text-xl sm:text-2xl text-[#181816] mb-3 group-hover:text-[#BE5836] transition-colors leading-snug">
              <a href={`/blog/${post.id}/`}>
                {post.data.title}
              </a>
            </h3>

            <!-- Description -->
            <p class="text-xs sm:text-sm text-[#4A4742] line-clamp-3 leading-relaxed mb-6 font-sans">
              {post.data.description}
            </p>
          </div>

          <!-- Bottom Read Link -->
          <div class="pt-5 border-t border-[#181816]/8 flex items-center justify-between text-xs font-mono text-[#6E6A62]">
            <a href={`/blog/${post.id}/`} class="group-hover:text-[#BE5836] transition-colors flex items-center gap-1 font-medium">
              <span>Makaleyi Oku</span>
              <span class="group-hover:translate-x-1 transition-transform">→</span>
            </a>
            {post.data.tags && post.data.tags[0] && (
              <span class="text-[10px] font-mono text-[#6E6A62]/60 uppercase">
                #{post.data.tags[0]}
              </span>
            )}
          </div>
        </article>
      ))}
    </div>

  </div>
</section>
