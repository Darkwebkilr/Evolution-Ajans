---
import "../styles/global.css";
import { services } from "../components/data/services.js";
import Cards from "../components/Cards.astro";
---

<section class="relative w-full bg-white py-32 overflow-hidden border-t-4 border-black retro-grid" id="services">
  <div class="max-w-7xl mx-auto px-6 md:px-12 relative z-10">
    
    <div class="flex flex-col lg:flex-row justify-between items-start lg:items-end mb-24 gap-10">
      <div class="max-w-3xl">
        <span class="text-black/50 font-mono text-[10px] tracking-[0.4em] uppercase mb-6 block font-pixel" data-aos="fade-right">ODAK HİZMETLERİMİZ</span>
        <h2 
          class="text-4xl md:text-5xl lg:text-7xl font-black uppercase tracking-tighter leading-none"
          data-aos="fade-up"
        >
          <span class="block text-black">İŞİNİZİ BÜYÜTECEK</span> 
          <span class="block mt-2 text-blue-600">3 ANA HİZMETİMİZ</span>
        </h2>
      </div>
      <p class="text-black/75 max-w-sm text-lg lg:text-right font-medium leading-relaxed" data-aos="fade-left">
        Sadece sizin için telefon çaldıran ve yeni müşteri kazandıran Google & Meta reklamları ile yüksek dönüşümlü sayfalara odaklanıyoruz.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8 auto-rows-fr">
      {
        services.map((features, index) => (
          <Cards
            title={features.name}
            desc={features.desc}
            icon={features.icon}
            slug={features.slug}
            index={index}
          />
        ))
      }
    </div>
  </div>
</section>

<script>
  import AOS from "aos";
  document.addEventListener("DOMContentLoaded", () => {
    AOS.init({
      duration: 1000,
      once: true,
      easing: 'ease-out-cubic'
    });
  });
</script>