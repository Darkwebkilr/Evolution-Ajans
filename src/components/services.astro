---
import { services } from "../components/data/services.js";
import Cards from "../components/Cards.astro";
---

<section class="relative w-full bg-[#FBF9F5] py-24 md:py-36 border-b border-dashed border-[#181816]/15" id="services">
  <div class="max-w-6xl mx-auto px-6 relative z-10">
    
    <!-- Section Header (Asymmetric Layout) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 mb-20 items-end">
      <div class="lg:col-span-7 space-y-4">
        <div class="inline-flex items-center gap-2 text-xs font-mono uppercase tracking-[0.2em] text-[#536248] bg-[#EBF0E6] px-3 py-1 rounded-full border border-[#536248]/20">
          <span class="w-1.5 h-1.5 rounded-full bg-[#536248]"></span>
          <span>[ 04 // UZMANLIK ALANLARI ]</span>
        </div>
        <h2 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-serif tracking-tight leading-tight text-[#181816]">
          İşinizi büyütecek <br />
          <span class="italic font-normal text-[#BE5836]">3 temel disiplin</span>.
        </h2>
      </div>

      <div class="lg:col-span-5">
        <p class="text-base sm:text-lg text-[#6E6A62] font-sans leading-relaxed">
          Gereksiz detaylara boğulmadan; sadece işletmenizin telefonunu çaldıran ve yeni müşteri kazandıran Google, Meta ve yüksek dönüşümlü arayüz sistemlerine odaklanıyoruz.
        </p>
      </div>
    </div>

    <!-- 3 Core Services Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 auto-rows-fr">
      {
        services.map((features, index) => (
          <Cards
            title={features.name}
            desc={features.desc}
            icon={features.icon}
            slug={features.slug}
            index={index}
          />
        ))
      }
    </div>
  </div>
</section>
