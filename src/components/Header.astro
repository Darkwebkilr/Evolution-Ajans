---
import { Image } from "astro:assets";
import Logo from "../../public/img/Logo.png";
import { Icon } from "astro-icon/components";

const nav = [
  { name: "Anasayfa", link: "/" },
  { name: "Başarı Hikayeleri", link: "/basari" },
  { name: "Blog", link: "/blog" },
  { name: "Hakkımızda", link: "/hakkimizda" },
  { name: "Bize Ulaşın", link: "/iletisim" },
];
---

<header class="fixed top-6 left-1/2 -translate-x-1/2 w-[calc(100%-2rem)] max-w-7xl z-60 pointer-events-none flex justify-between items-center">
  <!-- LOGO BOX -->
  <a href="/" class="pointer-events-auto bg-white border-4 border-black px-5 py-3 shadow-[4px_4px_0px_rgba(0,0,0,1)] hover:-translate-y-[2px] hover:shadow-[6px_6px_0px_rgba(0,0,0,1)] transition-all flex items-center justify-center">
    <Image
      class="w-[90px] md:w-[110px] h-auto object-contain"
      src={Logo}
      width={200}
      height={200}
      alt="Evolution Logo"
    />
  </a>

  <!-- DESKTOP NAVIGATION BOX -->
  <nav class="hidden lg:flex pointer-events-auto bg-white border-4 border-black px-8 py-4.5 shadow-[4px_4px_0px_rgba(0,0,0,1)] gap-8 items-center">
    {
      nav.map((item) => (
        <a
          href={item.link}
          class="text-[10px] uppercase font-bold text-black/70 hover:text-black transition-colors duration-300 font-pixel"
        >
          {item.name}
        </a>
      ))
    }
  </nav>

  <!-- CALL TO ACTION BOX -->
  <a
    href="tel:+905519283598"
    class="hidden lg:flex pointer-events-auto bg-[#facc15] border-4 border-black px-5 py-4 shadow-[4px_4px_0px_rgba(0,0,0,1)] hover:-translate-y-[2px] hover:shadow-[6px_6px_0px_rgba(0,0,0,1)] transition-all font-pixel text-[9px] font-bold uppercase text-black"
  >
    Hemen Ara
  </a>

  <!-- MOBILE TOGGLE BOX -->
  <button
    id="menu-toggle"
    class="lg:hidden pointer-events-auto bg-white border-4 border-black w-12 h-12 flex flex-col justify-center items-center gap-[5px] shadow-[4px_4px_0px_rgba(0,0,0,1)] hover:-translate-y-[2px] hover:shadow-[6px_6px_0px_rgba(0,0,0,1)] transition-all z-[60]"
    aria-label="Toggle Menu"
  >
    <span class="block w-6 h-[2.5px] bg-black transition-all duration-300"></span>
    <span class="block w-6 h-[2.5px] bg-black transition-all duration-300"></span>
    <span class="block w-6 h-[2.5px] bg-black transition-all duration-300"></span>
  </button>
</header>

<!-- FULLSCREEN MOBILE MENU -->
<div
  id="mobile-overlay"
  class="hidden fixed inset-0 bg-[#f8fafc] z-[55] flex flex-col justify-center px-8 sm:px-12 pointer-events-none opacity-0 transition-all duration-700 ease-[cubic-bezier(0.19,1,0.22,1)] border-b-4 border-black"
>
  <!-- Background Texture/Noise -->
  <div
    class="absolute inset-0 opacity-[0.02] pointer-events-none mix-blend-overlay"
    style="background-image: url('data:image/svg+xml,%3Csvg viewBox=%220 0 200 200%22 xmlns=%22http://www.w3.org/2000/svg%22%3E%3Cfilter id=%22noiseFilter%22%3E%3CfeTurbulence type=%22fractalNoise%22 baseFrequency=%220.8%22 numOctaves=%224%22 stitchTiles=%22stitch%22/%3E%3C/filter%3E%3Crect width=%22100%25%22 height=%22100%25%22 filter=%22url(%23noiseFilter)%22/%3E%3C/svg%3E');"
  >
  </div>

  <nav class="relative z-[70] flex flex-col gap-6 mt-16 pointer-events-auto nav">
    {
      nav.map((item, index) => (
        <a href={item.link} class="mobile-link block overflow-hidden font-pixel">
          <span
            class="block text-2xl sm:text-4xl font-extrabold uppercase tracking-tighter text-black/40 hover:text-black hover:translate-x-4 transition-all duration-500 origin-left"
            style={`transform: translateY(120%); transition: transform 0.8s cubic-bezier(0.19, 1, 0.22, 1) ${index * 0.1}s, color 0.4s ease, padding 0.4s ease;`}
          >
            {item.name}
          </span>
        </a>
      ))
    }
  </nav>

  <div
    class="absolute bottom-12 left-8 sm:left-12 flex flex-col gap-4 mobile-footer opacity-0 translate-y-8 transition-all duration-1000 ease-[cubic-bezier(0.19,1,0.22,1)] delay-300 pointer-events-auto"
  >
    <a
      href="mailto:hello@evolution.com"
      class="text-black/60 hover:text-black text-sm tracking-widest uppercase transition-colors font-mono"
      >hello@evolution.com</a
    >
    <a
      href="tel:+905519283598"
      class="text-black/60 hover:text-black text-sm tracking-widest uppercase transition-colors font-mono"
      >+90 551 928 35 98</a
    >
    <p class="text-black/40 text-xs tracking-[0.2em] uppercase mt-4 font-mono">
      Evolution Ajans © {new Date().getFullYear()}
    </p>
  </div>
</div>

<style>
  /* Active states for Mobile Menu */
  #mobile-overlay.active {
    pointer-events: auto;
    opacity: 1;
    display: flex !important;
  }

  #mobile-overlay.active .mobile-link span {
    transform: translateY(0) !important;
  }

  #mobile-overlay.active .mobile-footer {
    opacity: 1;
    transform: translateY(0);
    display: flex !important;
  }

  /* Hamburger transition active state */
  #menu-toggle.active span:nth-child(1) {
    transform: translateY(7.5px) rotate(45deg);
  }
  #menu-toggle.active span:nth-child(2) {
    opacity: 0;
  }
  #menu-toggle.active span:nth-child(3) {
    transform: translateY(-7.5px) rotate(-45deg);
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    // Mobile Menu Toggle Logic
    const toggle = document.getElementById("menu-toggle");
    const overlay = document.getElementById("mobile-overlay");
    const body = document.body;

    if (toggle && overlay) {
      toggle.addEventListener("click", () => {
        const isActive = toggle.classList.contains("active");

        if (isActive) {
          toggle.classList.remove("active");
          overlay.classList.remove("active");
          body.style.overflow = "";
        } else {
          toggle.classList.add("active");
          overlay.classList.add("active");
          body.style.overflow = "hidden";
        }
      });
    }
  });
</script>
