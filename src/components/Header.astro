---
import { Icon } from "astro-icon/components";

const nav = [
  { name: "Anasayfa", link: "/" },
  { name: "Hakkımızda", link: "/hakkimizda/" },
  { name: "Başarılarımız", link: "/basari/" },
  { name: "Paketler", link: "/paketler/" },
  { name: "Hizmet Bölgeleri", link: "/hizmet-bolgeleri/" },
  { name: "İletişim", link: "/iletisim/" },
];
---

<header class="fixed top-5 left-1/2 -translate-x-1/2 w-[calc(100%-2rem)] max-w-6xl z-50 pointer-events-none flex justify-between items-center transition-all duration-300">
  
  <!-- LOGO -->
  <a 
    href="/" 
    class="pointer-events-auto bg-[#FBF9F5]/95 backdrop-blur-md border border-[#181816]/15 rounded-full px-5 py-2.5 shadow-sm hover:border-[#BE5836]/40 transition-all flex items-center gap-3 group"
  >
    <span class="font-serif text-lg tracking-tight font-normal text-[#181816] group-hover:text-[#BE5836] transition-colors">
      Evolution <span class="italic font-light text-[#BE5836]">Ajans</span>
    </span>
    <span class="hidden sm:inline-block text-[9px] font-mono tracking-[0.2em] uppercase text-[#536248] bg-[#EBF0E6] px-2 py-0.5 rounded-full border border-[#536248]/20">
      İzmir
    </span>
  </a>

  <!-- DESKTOP NAVIGATION -->
  <nav class="hidden lg:flex pointer-events-auto bg-[#FBF9F5]/95 backdrop-blur-md border border-[#181816]/15 rounded-full px-6 py-2.5 shadow-sm gap-7 items-center">
    {
      nav.map((item) => (
        <a
          href={item.link}
          class="text-xs uppercase tracking-widest font-medium text-[#181816]/75 hover:text-[#BE5836] transition-colors duration-200"
        >
          {item.name}
        </a>
      ))
    }
  </nav>

  <!-- CALL TO ACTION & CONTACT -->
  <div class="hidden lg:flex pointer-events-auto items-center gap-3">
    <a
      href="tel:+905519283598"
      class="bg-[#BE5836] text-white rounded-full px-5 py-2.5 text-xs font-medium uppercase tracking-widest hover:bg-[#9E4324] transition-all shadow-sm flex items-center gap-2 group"
    >
      <span>Görüşme Başlat</span>
      <span class="text-xs group-hover:translate-x-0.5 transition-transform">→</span>
    </a>
  </div>

  <!-- MOBILE TOGGLE BUTTON -->
  <button
    id="menu-toggle"
    class="lg:hidden pointer-events-auto bg-[#FBF9F5]/95 backdrop-blur-md border border-[#181816]/15 w-11 h-11 rounded-full flex flex-col justify-center items-center gap-1.5 shadow-sm hover:border-[#BE5836]/40 transition-all z-[60]"
    aria-label="Menüyü Aç"
  >
    <span class="block w-4 h-[1.5px] bg-[#181816] transition-all duration-300"></span>
    <span class="block w-4 h-[1.5px] bg-[#181816] transition-all duration-300"></span>
  </button>
</header>

<!-- FULLSCREEN MOBILE MENU (Editorial Warm Paper) -->
<div
  id="mobile-overlay"
  class="fixed inset-0 bg-[#FBF9F5] z-[55] flex flex-col justify-between p-8 sm:p-12 pointer-events-none opacity-0 invisible transition-all duration-500 ease-out"
>
  <!-- Top Bar in Mobile Overlay -->
  <div class="flex justify-between items-center border-b border-dashed border-[#181816]/15 pb-6">
    <span class="font-serif text-xl tracking-tight text-[#181816]">
      Evolution <span class="italic text-[#BE5836]">Ajans</span>
    </span>
    <span class="text-[10px] font-mono tracking-widest uppercase text-[#536248] bg-[#EBF0E6] px-3 py-1 rounded-full">
      [ MENÜ ]
    </span>
  </div>

  <!-- Navigation Links -->
  <nav class="relative z-[70] flex flex-col gap-4 my-auto pointer-events-auto">
    {
      nav.map((item, index) => (
        <a 
          href={item.link} 
          class="mobile-link group flex items-baseline justify-between border-b border-[#181816]/10 py-3 transition-colors"
        >
          <span class="font-serif text-2xl sm:text-3xl text-[#181816] group-hover:italic group-hover:text-[#BE5836] transition-all">
            {item.name}
          </span>
          <span class="font-mono text-xs text-[#6E6A62] group-hover:text-[#BE5836] transition-colors">
            0{index + 1} //
          </span>
        </a>
      ))
    }
  </nav>

  <!-- Mobile Footer Info -->
  <div class="border-t border-dashed border-[#181816]/15 pt-6 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 text-xs font-mono text-[#6E6A62] pointer-events-auto">
    <div>
      <a href="tel:+905519283598" class="text-[#181816] hover:text-[#BE5836] block font-semibold">+90 551 928 35 98</a>
      <a href="mailto:ismethaktan39@gmail.com" class="hover:text-[#BE5836] block mt-1">ismethaktan39@gmail.com</a>
    </div>
    <div class="text-[10px] uppercase tracking-widest text-[#536248]">
      [ İZMİR // FOLKART TOWERS ]
    </div>
  </div>
</div>

<script>
  const toggleBtn = document.getElementById("menu-toggle");
  const overlay = document.getElementById("mobile-overlay");
  const links = document.querySelectorAll(".mobile-link");

  let isOpen = false;

  function toggleMenu() {
    isOpen = !isOpen;
    if (isOpen) {
      overlay?.classList.remove("opacity-0", "invisible", "pointer-events-none");
      overlay?.classList.add("opacity-100", "pointer-events-auto");
      document.body.style.overflow = "hidden";
    } else {
      overlay?.classList.add("opacity-0", "invisible", "pointer-events-none");
      overlay?.classList.remove("opacity-100", "pointer-events-auto");
      document.body.style.overflow = "";
    }
  }

  toggleBtn?.addEventListener("click", toggleMenu);
  links.forEach(link => {
    link.addEventListener("click", () => {
      if (isOpen) toggleMenu();
    });
  });
</script>
