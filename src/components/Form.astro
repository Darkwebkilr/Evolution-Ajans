---
import { Icon } from "astro-icon/components";
---

<section
  id="iletisim"
  class="relative w-full py-32 bg-white overflow-hidden border-t-4 border-black retro-grid"
>

  <div class="max-w-7xl mx-auto px-6 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 lg:gap-24 items-center">
      
      <!-- Contact Info / Typography -->
      <div class="space-y-12" data-aos="fade-right">
        <div>
          <span class="inline-block px-4 py-2 border-2 border-black bg-black text-white text-xs md:text-sm font-mono uppercase tracking-[0.3em] font-pixel mb-6">
            Ücretsiz Check-Up
          </span>
          <h2 class="text-4xl sm:text-5xl md:text-6xl lg:text-[64px] xl:text-[70px] font-black uppercase tracking-tighter leading-none">
            ÜCRETSİZ CHECK-UP İÇİN <br/>
            <span class="text-blue-600 block mt-2">BİLGİLERİNİZİ BIRAKIN</span>
          </h2>
        </div>

        <p class="text-black/80 text-lg md:text-xl lg:text-2xl leading-relaxed max-w-xl font-medium">
          Siteniz ve reklam bütçeniz nerede boşa gidiyor? Bilgilerinizi bırakın, tüm eksiklikleri ve iyileştirme fırsatlarını raporlayıp telefon görüşmesinde aktarayım.
        </p>

        <div class="space-y-6 pt-6 border-t-2 border-black/10">
          <div class="flex items-center gap-6 group">
            <div class="w-14 h-14 rounded-none border-2 border-black bg-slate-100 flex items-center justify-center text-black group-hover:bg-[#facc15] transition-all duration-300">
              <Icon name="mdi:phone-outline" size={24} />
            </div>
            <div>
              <p class="text-xs font-mono uppercase tracking-widest text-black/55 font-pixel mb-1">Telefon / WhatsApp</p>
              <a href="tel:+905519283598" class="text-lg md:text-2xl font-bold text-black hover:text-blue-600 transition-colors">+90 551 928 35 98</a>
            </div>
          </div>
        </div>
      </div>

      <!-- Form Concept -->
      <div class="relative" data-aos="fade-left">
        <form
          id="contact-form"
          class="relative bg-white border-4 border-black rounded-none p-8 md:p-12 shadow-[8px_8px_0px_0px_rgba(0,0,0,1)] z-10"
        >
          <!-- Web3Forms Config -->
          <input type="hidden" name="access_key" value="0d040a39-0e41-40fa-8148-865c250a7adf" />
          <input type="hidden" name="subject" value="Evolution Ajans - Yeni İletişim Formu Mesajı" />
          <input type="hidden" name="from_name" value="Evolution Ajans Web Sitesi" />
          <div class="space-y-6">
            <!-- Name Input -->
            <div class="relative group">
              <label for="name" class="block text-xs sm:text-sm uppercase font-bold mb-2 font-pixel text-black">Adınız Soyadınız / Firma Adı</label>
              <input
                type="text"
                id="name"
                name="name"
                required
                class="w-full bg-slate-50 border-2 border-black p-4 text-black text-base focus:outline-none focus:bg-white focus:shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] transition-all font-mono"
                placeholder="Örn: Ahmet Yılmaz / Vizyon Nakliyat"
              />
            </div>

            <!-- Phone Input -->
            <div class="relative group">
              <label for="phone" class="block text-xs sm:text-sm uppercase font-bold mb-2 font-pixel text-black">Telefon Numarası</label>
              <input
                type="tel"
                id="phone"
                name="phone"
                required
                class="w-full bg-slate-50 border-2 border-black p-4 text-black text-base focus:outline-none focus:bg-white focus:shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] transition-all font-mono"
                placeholder="Örn: 0555 555 55 55"
              />
            </div>

            <!-- Website Input (Optional) -->
            <div class="relative group">
              <label for="website" class="block text-xs sm:text-sm uppercase font-bold mb-2 font-pixel text-black">Mevcut Web Siteniz (Opsiyonel)</label>
              <input
                type="text"
                id="website"
                name="website"
                class="w-full bg-slate-50 border-2 border-black p-4 text-black text-base focus:outline-none focus:bg-white focus:shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] transition-all font-mono"
                placeholder="Örn: www.firmam.com"
              />
            </div>

            <!-- Budget Select Box -->
            <div class="relative group">
              <label for="budget" class="block text-xs sm:text-sm uppercase font-bold mb-2 font-pixel text-black">Aylık Reklam Bütçeniz</label>
              <select
                id="budget"
                name="budget"
                required
                class="w-full bg-slate-50 border-2 border-black p-4 text-black text-base focus:outline-none focus:bg-white focus:shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] transition-all font-mono appearance-none bg-[url('data:image/svg+xml;charset=UTF-8,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20width%3D%2224%22%20height%3D%2224%22%20viewBox%3D%220%200%2024%2024%22%20fill%3D%22none%22%20stroke%3D%22currentColor%22%20stroke-width%3D%222%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%3E%3Cpolyline%20points%3D%226%209%2012%2015%2018%209%22%3E%3C%2Fpolyline%3E%3C%2Fsvg%3E')] bg-[length:1.25rem_1.25rem] bg-[right_1rem_center] bg-no-repeat pr-10"
              >
                <option value="" disabled selected>Seçiniz...</option>
                <option value="10.000 TL - 20.000 TL">10.000 TL - 20.000 TL</option>
                <option value="20.000 TL - 50.000 TL">20.000 TL - 50.000 TL</option>
                <option value="50.000 TL ve Üzeri">50.000 TL ve Üzeri</option>
              </select>
            </div>

            <!-- Submit Button -->
            <button
              type="submit"
              class="w-full group relative inline-flex items-center justify-center gap-4 px-8 py-4 bg-[#facc15] text-black border-2 border-black rounded-none transition-all hover:-translate-x-[2px] hover:-translate-y-[2px] hover:shadow-[6px_6px_0px_0px_rgba(0,0,0,1)] shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] active:translate-x-0 active:translate-y-0 active:shadow-none font-pixel text-xs sm:text-sm"
            >
              <span class="relative z-10 font-bold uppercase tracking-widest">Ücretsiz Analizimi İste</span>
              <Icon name="mdi:send" size={18} class="relative z-10 text-black" />
            </button>
          </div>
        </form>
      </div>

    </div>
  </div>
</section>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const form = document.getElementById("contact-form");
    if (form) {
      form.addEventListener("submit", async (e) => {
        e.preventDefault();
        
        const btn = form.querySelector('button[type="submit"]');
        if (!btn) return;
        const originalText = btn.innerHTML;
        
        // Yükleme durumu
        btn.innerHTML = `<span class="relative z-10 text-sm font-bold uppercase tracking-widest text-white">Gönderiliyor...</span><div class="absolute inset-0 bg-blue-600 z-0"></div>`;
        btn.setAttribute("disabled", "true");

        try {
          const formData = new FormData(form as HTMLFormElement);
          const response = await fetch("https://api.web3forms.com/submit", {
            method: "POST",
            body: formData
          });
          const result = await response.json();
          
          if (response.status === 200 || result.success) {
            btn.innerHTML = `<span class="relative z-10 text-sm font-bold uppercase tracking-widest text-white">Başarıyla İletildi</span><div class="absolute inset-0 bg-green-500 z-0"></div>`;
            (form as HTMLFormElement).reset();
            setTimeout(() => {
              window.location.href = "/tesekkurler";
            }, 1000);
          } else {
            console.error(result);
            btn.innerHTML = `<span class="relative z-10 text-sm font-bold uppercase tracking-widest text-white">Hata Oluştu</span><div class="absolute inset-0 bg-red-600 z-0"></div>`;
          }
        } catch (error) {
          console.error(error);
          btn.innerHTML = `<span class="relative z-10 text-sm font-bold uppercase tracking-widest text-white">Hata Oluştu</span><div class="absolute inset-0 bg-red-600 z-0"></div>`;
        } finally {
          setTimeout(() => {
            btn.innerHTML = originalText;
            btn.removeAttribute("disabled");
          }, 3000);
        }
      });
    }
  });
</script>