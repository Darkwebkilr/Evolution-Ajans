---
import { Icon } from "astro-icon/components";
---

<section
  id="iletisim"
  class="relative w-full py-32 bg-white overflow-hidden border-t-4 border-black retro-grid"
>

  <div class="max-w-7xl mx-auto px-6 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 lg:gap-24 items-center">
      
      <!-- Contact Info / Typography -->
      <div class="space-y-12" data-aos="fade-right">
        <div>
          <span class="inline-block px-4 py-2 border-2 border-black bg-black text-white text-[10px] font-mono uppercase tracking-[0.3em] font-pixel mb-6">
            Yeni Bir Proje
          </span>
          <h2 class="text-4xl md:text-5xl font-black uppercase tracking-tighter leading-none">
            HİKAYENİZİ <br/>
            <span class="text-blue-600 block mt-2">YAZALIM.</span>
          </h2>
        </div>

        <p class="text-black/60 text-base leading-relaxed max-w-md">
          Sınırları zorlayan bir fikriniz mi var? Gelin, onu dijital ekosistemde bir güç merkezine dönüştürelim. Formu doldurun, sizinle hemen iletişime geçelim.
        </p>

        <div class="space-y-6 pt-6 border-t-2 border-black/10">
          <div class="flex items-center gap-6 group">
            <div class="w-14 h-14 rounded-none border-2 border-black bg-slate-100 flex items-center justify-center text-black group-hover:bg-[#facc15] transition-all duration-300">
              <Icon name="mdi:email-outline" size={24} />
            </div>
            <div>
              <p class="text-[9px] font-mono uppercase tracking-widest text-black/40 font-pixel mb-1">E-posta</p>
              <a href="mailto:hello@evolution.com" class="text-base font-bold text-black hover:text-blue-600 transition-colors">hello@evolution.com</a>
            </div>
          </div>

          <div class="flex items-center gap-6 group">
            <div class="w-14 h-14 rounded-none border-2 border-black bg-slate-100 flex items-center justify-center text-black group-hover:bg-[#facc15] transition-all duration-300">
              <Icon name="mdi:phone-outline" size={24} />
            </div>
            <div>
              <p class="text-[9px] font-mono uppercase tracking-widest text-black/40 font-pixel mb-1">Telefon / WhatsApp</p>
              <a href="tel:+905519283598" class="text-base font-bold text-black hover:text-blue-600 transition-colors">+90 551 928 35 98</a>
            </div>
          </div>
        </div>
      </div>

      <!-- Form Concept -->
      <div class="relative" data-aos="fade-left">
        <form
          id="contact-form"
          class="relative bg-white border-4 border-black rounded-none p-8 md:p-12 shadow-[8px_8px_0px_0px_rgba(0,0,0,1)] z-10"
        >
          <!-- Web3Forms Config -->
          <input type="hidden" name="access_key" value="YOUR_ACCESS_KEY_HERE" />
          <input type="hidden" name="subject" value="Evolution Ajans - Yeni İletişim Formu Mesajı" />
          <input type="hidden" name="from_name" value="Evolution Ajans Web Sitesi" />
          <div class="space-y-6">
            <!-- Name Input -->
            <div class="relative group">
              <label for="name" class="block text-[9px] uppercase font-bold mb-2 font-pixel text-black">Adınız Soyadınız</label>
              <input
                type="text"
                id="name"
                name="name"
                required
                class="w-full bg-slate-50 border-2 border-black p-4 text-black text-sm focus:outline-none focus:bg-white focus:shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] transition-all font-mono"
                placeholder="Örn: Ahmet Yılmaz"
              />
            </div>

            <!-- Email Input -->
            <div class="relative group">
              <label for="email" class="block text-[9px] uppercase font-bold mb-2 font-pixel text-black">E-posta Adresiniz</label>
              <input
                type="email"
                id="email"
                name="email"
                required
                class="w-full bg-slate-50 border-2 border-black p-4 text-black text-sm focus:outline-none focus:bg-white focus:shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] transition-all font-mono"
                placeholder="Örn: ahmet@mail.com"
              />
            </div>

            <!-- Message Input -->
            <div class="relative group">
              <label for="message" class="block text-[9px] uppercase font-bold mb-2 font-pixel text-black">Projenizden Bahsedin</label>
              <textarea
                id="message"
                name="message"
                rows="4"
                required
                class="w-full bg-slate-50 border-2 border-black p-4 text-black text-sm focus:outline-none focus:bg-white focus:shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] transition-all resize-none font-mono"
                placeholder="Projenizin hedeflerini kısaca anlatın..."
              ></textarea>
            </div>

            <!-- Submit Button -->
            <button
              type="submit"
              class="w-full group relative inline-flex items-center justify-center gap-4 px-8 py-4 bg-[#facc15] text-black border-2 border-black rounded-none transition-all hover:-translate-x-[2px] hover:-translate-y-[2px] hover:shadow-[6px_6px_0px_0px_rgba(0,0,0,1)] shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] active:translate-x-0 active:translate-y-0 active:shadow-none font-pixel text-[10px]"
            >
              <span class="relative z-10 font-bold uppercase tracking-widest">Sisteme Gönder</span>
              <Icon name="mdi:send" size={18} class="relative z-10 text-black" />
            </button>
          </div>
        </form>
      </div>

    </div>
  </div>
</section>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const form = document.getElementById("contact-form");
    if (form) {
      form.addEventListener("submit", async (e) => {
        e.preventDefault();
        
        const btn = form.querySelector('button[type="submit"]');
        if (!btn) return;
        const originalText = btn.innerHTML;
        
        // Yükleme durumu
        btn.innerHTML = `<span class="relative z-10 text-sm font-bold uppercase tracking-widest text-white">Gönderiliyor...</span><div class="absolute inset-0 bg-blue-600 z-0"></div>`;
        btn.setAttribute("disabled", "true");

        try {
          const formData = new FormData(form as HTMLFormElement);
          const response = await fetch("https://api.web3forms.com/submit", {
            method: "POST",
            body: formData
          });
          const result = await response.json();
          
          if (response.status === 200 || result.success) {
            btn.innerHTML = `<span class="relative z-10 text-sm font-bold uppercase tracking-widest text-white">Başarıyla İletildi</span><div class="absolute inset-0 bg-green-500 z-0"></div>`;
            (form as HTMLFormElement).reset();
          } else {
            console.error(result);
            btn.innerHTML = `<span class="relative z-10 text-sm font-bold uppercase tracking-widest text-white">Hata Oluştu</span><div class="absolute inset-0 bg-red-600 z-0"></div>`;
          }
        } catch (error) {
          console.error(error);
          btn.innerHTML = `<span class="relative z-10 text-sm font-bold uppercase tracking-widest text-white">Hata Oluştu</span><div class="absolute inset-0 bg-red-600 z-0"></div>`;
        } finally {
          setTimeout(() => {
            btn.innerHTML = originalText;
            btn.removeAttribute("disabled");
          }, 3000);
        }
      });
    }
  });
</script>