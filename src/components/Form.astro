---
import { Icon } from "astro-icon/components";
---

<section
  id="iletisim"
  class="relative w-full py-24 md:py-36 bg-[#FBF9F5] overflow-hidden border-b border-dashed border-[#181816]/15"
>
  <div class="max-w-6xl mx-auto px-6 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">
      
      <!-- Contact Info / Typography (5 Cols) -->
      <div class="lg:col-span-5 space-y-8">
        <div class="space-y-4">
          <div class="inline-flex items-center gap-2 text-xs font-mono uppercase tracking-[0.2em] text-[#536248] bg-[#EBF0E6] px-3 py-1 rounded-full border border-[#536248]/20">
            <span class="w-1.5 h-1.5 rounded-full bg-[#536248]"></span>
            <span>[ 10 // DİJİTAL CHECK-UP ]</span>
          </div>

          <h2 class="text-3xl sm:text-4xl md:text-5xl font-serif tracking-tight text-[#181816] leading-tight">
            Sitenizi ve bütçenizi <br />
            <span class="italic font-normal text-[#BE5836]">ücretsiz inceleyelim</span>.
          </h2>

          <p class="text-base text-[#4A4742] leading-relaxed">
            Mevcut web siteniz veya reklam bütçeniz nerede boşa gidiyor? Bilgilerinizi bırakın; sektörünüze özel eksikleri ve fırsatları detaylıca çıkarıp 24 saat içinde aktaralım.
          </p>
        </div>

        <!-- Contact Detail Cards -->
        <div class="space-y-4 pt-4 border-t border-dashed border-[#181816]/15">
          <div class="p-5 rounded-2xl bg-white border border-[#181816]/10 flex items-center gap-4">
            <div class="w-10 h-10 rounded-full bg-[#FAEDE8] text-[#BE5836] flex items-center justify-center shrink-0">
              <Icon name="mdi:phone-outline" size={20} />
            </div>
            <div>
              <p class="text-[10px] font-mono uppercase tracking-widest text-[#6E6A62]">Doğrudan Hat / WhatsApp</p>
              <a href="tel:+905519283598" class="text-base font-semibold text-[#181816] hover:text-[#BE5836] transition-colors">+90 551 928 35 98</a>
            </div>
          </div>

          <div class="p-5 rounded-2xl bg-white border border-[#181816]/10 flex items-center gap-4">
            <div class="w-10 h-10 rounded-full bg-[#EBF0E6] text-[#536248] flex items-center justify-center shrink-0">
              <Icon name="mdi:email-outline" size={20} />
            </div>
            <div>
              <p class="text-[10px] font-mono uppercase tracking-widest text-[#6E6A62]">E-Posta</p>
              <a href="mailto:ismethaktan39@gmail.com" class="text-sm font-semibold text-[#181816] hover:text-[#BE5836] transition-colors">ismethaktan39@gmail.com</a>
            </div>
          </div>

          <div class="p-5 rounded-2xl bg-white border border-[#181816]/10 flex items-center gap-4">
            <div class="w-10 h-10 rounded-full bg-[#F4EFE6] text-[#4A4742] flex items-center justify-center shrink-0">
              <Icon name="mdi:map-marker-outline" size={20} />
            </div>
            <div>
              <p class="text-[10px] font-mono uppercase tracking-widest text-[#6E6A62]">Atölye Konumu</p>
              <p class="text-xs text-[#181816]">Folkart Towers, Bayraklı / İzmir</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Form (7 Cols) -->
      <div class="lg:col-span-7">
        <form
          id="contact-form"
          class="bg-white border border-[#181816]/12 rounded-[28px] p-8 sm:p-12 shadow-[0_4px_30px_rgba(24,24,22,0.03)]"
        >
          <input type="hidden" name="access_key" value="0d040a39-0e41-40fa-8148-865c250a7adf" />
          <input type="hidden" name="subject" value="Evolution Ajans - Yeni İletişim Formu Mesajı" />
          <input type="hidden" name="from_name" value="Evolution Ajans Web Sitesi" />

          <div class="space-y-6">
            <div>
              <label for="name" class="block text-xs uppercase tracking-wider font-mono text-[#4A4742] mb-2">Adınız Soyadınız / İşletmeniz</label>
              <input
                type="text"
                id="name"
                name="name"
                required
                placeholder="Örn: Ahmet Yılmaz - Ege Nakliyat"
                class="w-full px-4 py-3.5 rounded-xl bg-[#FBF9F5] border border-[#181816]/15 text-[#181816] placeholder-[#6E6A62]/50 text-sm focus:outline-none focus:border-[#BE5836] transition-colors"
              />
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
              <div>
                <label for="phone" class="block text-xs uppercase tracking-wider font-mono text-[#4A4742] mb-2">Telefon Numaranız</label>
                <input
                  type="tel"
                  id="phone"
                  name="phone"
                  required
                  placeholder="05XX XXX XX XX"
                  class="w-full px-4 py-3.5 rounded-xl bg-[#FBF9F5] border border-[#181816]/15 text-[#181816] placeholder-[#6E6A62]/50 text-sm focus:outline-none focus:border-[#BE5836] transition-colors"
                />
              </div>

              <div>
                <label for="service" class="block text-xs uppercase tracking-wider font-mono text-[#4A4742] mb-2">İhtiyaç Duyulan Hizmet</label>
                <select
                  id="service"
                  name="service"
                  class="w-full px-4 py-3.5 rounded-xl bg-[#FBF9F5] border border-[#181816]/15 text-[#181816] text-sm focus:outline-none focus:border-[#BE5836] transition-colors"
                >
                  <option value="Google Ads ve Sıcak Müşteri Reklamları">Google Ads ve Arama Reklamları</option>
                  <option value="Yüksek Dönüşümlü Web Tasarımı">Yüksek Dönüşümlü Web Tasarımı</option>
                  <option value="Google Haritalar Yerel SEO">Google Haritalar Yerel SEO</option>
                  <option value="Meta (Instagram/Facebook) Reklamları">Meta (Instagram/Facebook) Reklamları</option>
                  <option value="Komple Büyüme Paketi">Komple Büyüme Paketi</option>
                </select>
              </div>
            </div>

            <div>
              <label for="website" class="block text-xs uppercase tracking-wider font-mono text-[#4A4742] mb-2">Mevcut Web Siteniz (Varsa)</label>
              <input
                type="text"
                id="website"
                name="website"
                placeholder="www.firmaniz.com"
                class="w-full px-4 py-3.5 rounded-xl bg-[#FBF9F5] border border-[#181816]/15 text-[#181816] placeholder-[#6E6A62]/50 text-sm focus:outline-none focus:border-[#BE5836] transition-colors"
              />
            </div>

            <div>
              <label for="message" class="block text-xs uppercase tracking-wider font-mono text-[#4A4742] mb-2">İşletmeniz ve Hedefiniz Hakkında Kısa Not</label>
              <textarea
                id="message"
                name="message"
                rows="4"
                placeholder="Örneğin: Günlük telefon aramalarımızı artırmak istiyoruz..."
                class="w-full px-4 py-3.5 rounded-xl bg-[#FBF9F5] border border-[#181816]/15 text-[#181816] placeholder-[#6E6A62]/50 text-sm focus:outline-none focus:border-[#BE5836] transition-colors resize-none"
              ></textarea>
            </div>

            <!-- Submit Button -->
            <button
              type="submit"
              id="submit-btn"
              class="w-full py-4 px-8 rounded-full bg-[#BE5836] text-white text-xs uppercase tracking-widest font-medium hover:bg-[#9E4324] transition-all shadow-sm flex items-center justify-center gap-2 cursor-pointer"
            >
              <span id="btn-text">Ücretsiz Analiz Talebini Gönder</span>
              <span class="text-sm">→</span>
            </button>

            <!-- Status Message -->
            <div id="form-status" class="hidden text-center text-xs font-mono p-3 rounded-xl"></div>
          </div>
        </form>
      </div>

    </div>
  </div>
</section>

<script>
  const form = document.getElementById("contact-form") as HTMLFormElement;
  const status = document.getElementById("form-status");
  const btnText = document.getElementById("btn-text");

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (btnText) btnText.textContent = "Gönderiliyor...";

    try {
      const formData = new FormData(form);
      const response = await fetch("https://api.web3forms.com/submit", {
        method: "POST",
        body: formData,
      });

      const result = await response.json();

      if (result.success) {
        if (status) {
          status.className = "block text-center text-xs font-mono p-3 rounded-xl bg-[#EBF0E6] text-[#3E4A35] border border-[#536248]/30";
          status.textContent = "✓ Teşekkürler! Mesajınız alındı, en geç 24 saat içinde dönüş yapacağız.";
        }
        form.reset();
      } else {
        throw new Error();
      }
    } catch {
      if (status) {
        status.className = "block text-center text-xs font-mono p-3 rounded-xl bg-[#FAEDE8] text-[#9E4324] border border-[#BE5836]/30";
        status.textContent = "Bir hata oluştu. Lütfen doğrudan WhatsApp veya telefon ile ulaşın.";
      }
    } finally {
      if (btnText) btnText.textContent = "Ücretsiz Analiz Talebini Gönder";
    }
  });
</script>
