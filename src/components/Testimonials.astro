---
import { Icon } from "astro-icon/components";

const testimonials = [
  {
    company: "Vizyon Lojistik",
    logoText: "VİZYON LOJİSTİK",
    author: "Kemal D.",
    role: "Kurucu",
    text: "Google Ads bütçemizi boşa harcıyormuşuz. Evolution bizim için yeni bir açılış sayfası yaptı ve telefonlarımız ilk günden çalmaya başladı. Aylık müşteri aramalarımız %150 arttı.",
    rating: 5,
    tag: "Nakliyat & Taşımacılık"
  },
  {
    company: "Ege Teknik Servis",
    logoText: "EGE TEKNİK SERVİS",
    author: "Murat Ş.",
    role: "Kurucu",
    text: "Klima ve kombi servisi olarak sezonda günde 3-4 çağrı alırken, bütçe optimizasyonu ve nokta atışı hedefleme sonrasında günde 15'ten fazla servis talebi almaya başladık.",
    rating: 5,
    tag: "Teknik Servis"
  },
  {
    company: "Akdeniz Vidanjör",
    logoText: "AKDENİZ VİDANJÖR",
    author: "Bülent K.",
    role: "Genel Müdür",
    text: "Reklam maliyetimiz yarı yarıya düştü ama gelen iş sayısı ikiye katlandı. Bütçemizi boşa harcayan kelimeleri eleyip sadece sıcak aramalara odaklandık. Çok memnunuz.",
    rating: 5,
    tag: "Altyapı & Çevre"
  }
];
---

<section id="yorumlar" class="py-24 bg-white border-t-4 border-black relative z-10">
  <div class="max-w-7xl mx-auto px-6">
    
    <!-- Title -->
    <div class="text-center mb-20 space-y-4">
      <span class="inline-block px-4 py-2 border-2 border-black bg-black text-white text-xs md:text-sm font-mono uppercase tracking-[0.3em] font-pixel">
        Referans Yorumları
      </span>
      <h2 class="text-4xl md:text-6xl font-black uppercase tracking-tighter text-black">
        MÜŞTERİ YORUMLARI
      </h2>
      <p class="text-black/75 max-w-2xl mx-auto text-lg md:text-xl font-medium">
        Birlikte büyüdüğümüz yerel hizmet ortaklarımızın sistem hakkındaki gerçek yorumları.
      </p>
    </div>

    <!-- Testimonials Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {testimonials.map((item, index) => (
        <div class="bg-white border-4 border-black p-6 md:p-8 rounded-none shadow-[4px_4px_0px_rgba(0,0,0,1)] hover:-translate-x-[2px] hover:-translate-y-[2px] hover:shadow-[6px_6px_0px_rgba(0,0,0,1)] transition-all flex flex-col justify-between" data-aos="fade-up" data-aos-delay={index * 100}>
          
          <div class="space-y-6">
            
            <!-- Star Ratings -->
            <div class="flex items-center gap-1">
              {[...Array(item.rating)].map(() => (
                <span class="text-[#facc15] text-xl">★</span>
              ))}
            </div>

            <!-- Review Text -->
            <p class="text-black/85 text-base md:text-[17px] leading-relaxed font-mono font-medium">
              "{item.text}"
            </p>

          </div>

          <!-- Client details -->
          <div class="mt-8 pt-6 border-t-2 border-black/10 flex flex-col gap-4">
            
            <!-- Author info -->
            <div>
              <h4 class="text-base font-bold text-black font-pixel uppercase">{item.author}</h4>
            </div>

          </div>

        </div>
      ))}
    </div>

  </div>
</section>
