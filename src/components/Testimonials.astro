---
import { Icon } from "astro-icon/components";

const testimonials = [
  {
    company: "Vizyon Lojistik",
    author: "Kemal D.",
    role: "Kurucu & Genel Müdür",
    text: "Google Ads bütçemizi daha önce boşa harcıyormuşuz. Evolution bizim için yeni ve yalın bir açılış sayfası yaptı; telefonlarımız ilk günden çalmaya başladı. Aylık müşteri aramalarımız %150 arttı.",
    rating: 5,
    tag: "Nakliyat & Lojistik",
    metric: "+%150 Çağrı Artışı"
  },
  {
    company: "Ege Teknik Servis",
    author: "Murat Ş.",
    role: "Firma Sahibi",
    text: "Klima ve kombi servisi olarak yoğun sezonda günde 3-4 çağrı alırken, yerel hedefleme ve negatif kelime temizliği sonrasında günde 15'ten fazla doğrulanmış servis talebi almaya başladık.",
    rating: 5,
    tag: "Teknik Servis",
    metric: "15+ Günlük Servis"
  },
  {
    company: "Akdeniz Vidanjör",
    author: "Bülent K.",
    role: "Genel Koordinatör",
    text: "Reklam maliyetimiz neredeyse yarıya indi ama gelen somut iş sayısı ikiye katlandı. Bütçeyi emen gereksiz kelimeleri eledik, doğrudan sıcak arayanlara ulaştık. Hem şeffaf hem çok memnunuz.",
    rating: 5,
    tag: "Altyapı & Çevre",
    metric: "%50 Bütçe Tasarrufu"
  }
];
---

<section id="yorumlar" class="py-24 md:py-36 bg-[#F4EFE6] border-b border-dashed border-[#181816]/15 relative z-10">
  <div class="max-w-6xl mx-auto px-6">
    
    <!-- Header -->
    <div class="max-w-3xl mb-20 space-y-4">
      <div class="inline-flex items-center gap-2 text-xs font-mono uppercase tracking-[0.2em] text-[#536248] bg-[#EBF0E6] px-3 py-1 rounded-full border border-[#536248]/20">
        <span class="w-1.5 h-1.5 rounded-full bg-[#536248]"></span>
        <span>[ 03 // REFERANS NOTLARI ]</span>
      </div>
      <h2 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-serif tracking-tight text-[#181816]">
        Doğrudan sahadan gelen <br />
        <span class="italic font-normal text-[#536248]">iş ortaklarımızın sesi</span>.
      </h2>
      <p class="text-base sm:text-lg text-[#6E6A62] leading-relaxed">
        Birlikte büyüdüğümüz yerel işletmelerin ve servis firmalarının kurduğumuz sistem hakkındaki samimi değerlendirmeleri.
      </p>
    </div>

    <!-- Testimonials Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {testimonials.map((item, index) => (
        <div class="bg-white border border-[#181816]/12 rounded-[28px] p-8 shadow-[0_4px_20px_rgba(24,24,22,0.03)] flex flex-col justify-between hover:border-[#BE5836]/30 transition-all duration-300">
          
          <div class="space-y-6">
            
            <!-- Stars & Tag -->
            <div class="flex items-center justify-between border-b border-dashed border-[#181816]/12 pb-4">
              <div class="flex text-[#BE5836] text-sm tracking-wider">
                ★★★★★
              </div>
              <span class="text-[10px] font-mono uppercase tracking-wider text-[#536248] bg-[#EBF0E6] px-2.5 py-0.5 rounded-full">
                {item.tag}
              </span>
            </div>

            <!-- Quote Text -->
            <p class="text-[#34322E] font-serif text-lg leading-relaxed italic">
              "{item.text}"
            </p>

          </div>

          <!-- Author Info & Result Metric -->
          <div class="pt-6 border-t border-[#181816]/10 mt-6 flex items-center justify-between">
            <div>
              <p class="font-sans font-semibold text-sm text-[#181816]">{item.author}</p>
              <p class="text-xs text-[#6E6A62] font-mono">{item.company}</p>
            </div>
            <span class="text-xs font-mono font-medium text-[#BE5836] bg-[#FAEDE8] px-2.5 py-1 rounded-md">
              {item.metric}
            </span>
          </div>

        </div>
      ))}
    </div>

  </div>
</section>
