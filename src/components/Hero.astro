---
// EvolutionHero.astro
// Framework: Astro.js + Tailwind CSS
// Aesthetic: Refined Luxury / High-Tech Elegance
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";

// Placeholder for rocket image if needed, or we use a clean CSS-based geometric approach.
---

<section class="relative min-h-[75vh] w-full bg-[#f8fafc] text-black overflow-hidden flex items-center justify-center py-12 md:py-16 retro-grid">
  
  <div class="max-w-7xl w-full mx-auto px-6 lg:px-12 relative z-10 grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
    
    <!-- Typographic Left Column -->
    <div class="lg:col-span-7 flex flex-col items-start space-y-8">
      
      <div class="inline-flex items-center gap-3 px-4 py-2 border-2 border-black bg-black text-white" data-aos="fade-down">
        <span class="w-2 h-2 rounded-full bg-[#25D366] animate-ping"></span>
        <span class="text-[10px] font-mono uppercase tracking-[0.2em] font-bold font-pixel">EVOLUTION BÜYÜME TÜNELİ</span>
      </div>

      <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-5xl font-black uppercase tracking-tighter leading-none" data-aos="fade-up" data-aos-delay="100">
        <span class="block text-black leading-tight">Rakipleriniz İnternetten İşi Toplarken Siz İzlemeyin.</span>
        <span class="block text-blue-600 mt-4 leading-tight">Telefonlarınızı Çaldıracak Sistemi Kurayım.</span>
      </h1>

      <p class="text-base md:text-lg text-black/85 font-medium max-w-2xl leading-relaxed" data-aos="fade-up" data-aos-delay="200">
        Web siteniz ve reklamlarınız nerede kan kaybediyor? Sadece gerçekten işe yarayan Google/Meta reklamları ve hızlı açılış sayfalarıyla, yerel hizmetiniz için (nakliyat, servis vb.) her gün yeni müşteri talebi almanızı sağlıyorum.
      </p>

      <div class="flex flex-col sm:flex-row gap-6 pt-4 w-full sm:w-auto font-pixel" data-aos="fade-up" data-aos-delay="300">
        <a href="#iletisim" class="group relative inline-flex items-center justify-center gap-4 px-8 py-4 border-2 border-black bg-[#facc15] text-black font-bold uppercase tracking-widest text-xs hover:-translate-x-[4px] hover:-translate-y-[4px] hover:shadow-[6px_6px_0px_0px_rgba(0,0,0,1)] active:translate-x-0 active:translate-y-0 active:shadow-none shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] transition-all">
          <span class="relative z-10">Sitemin Hatalarını Ücretsiz Analiz Et</span>
          <Icon name="mdi:arrow-down" size={20} class="relative z-10" />
        </a>
        
        <a href="https://wa.me/905519283598?text=Merhaba,%20sitemin%20ve%20reklamlarımın%20ücretsiz%20analizi%20için%20ulaşıyorum." target="_blank" class="group relative inline-flex items-center justify-center gap-4 px-8 py-4 border-2 border-black bg-white text-black font-bold uppercase tracking-widest text-xs hover:-translate-x-[4px] hover:-translate-y-[4px] hover:shadow-[6px_6px_0px_0px_rgba(0,0,0,1)] active:translate-x-0 active:translate-y-0 active:shadow-none shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] transition-all">
          <span>Hızlı WhatsApp</span>
          <Icon name="mdi:whatsapp" size={20} class="relative z-10" />
        </a>
      </div>
    </div>

    <!-- Geometric/Visual Right Column -->
    <div class="lg:col-span-5 relative hidden lg:flex justify-center items-center" data-aos="zoom-in" data-aos-delay="400">
      <div class="relative w-full aspect-square max-w-[500px]">
        <!-- Rotating Outer Rings -->
        <div class="absolute inset-0 border border-black/10 rounded-full animate-[spin_20s_linear_infinite]"></div>
        <div class="absolute inset-8 border border-black/5 rounded-full animate-[spin_15s_linear_infinite_reverse]"></div>
        <div class="absolute inset-16 border border-dashed border-black/20 rounded-full animate-[spin_30s_linear_infinite]"></div>
        
        <!-- Central Element (Abstract modern shape) -->
        <div class="absolute inset-0 flex items-center justify-center">
           <div class="relative w-48 h-48 bg-[#facc15] border-4 border-black text-black rotate-12 animate-[pulse_4s_ease-in-out_infinite] shadow-[8px_8px_0px_0px_rgba(0,0,0,1)] group">
              <div class="absolute inset-0 flex items-center justify-center">
                 <Icon name="mdi:rocket-launch-outline" size={64} class="text-black group-hover:-translate-y-4 group-hover:translate-x-4 group-hover:opacity-0 transition-all duration-500" />
                 <Icon name="mdi:rocket-launch" size={64} class="text-black absolute opacity-0 translate-y-4 -translate-x-4 group-hover:translate-y-0 group-hover:translate-x-0 group-hover:opacity-100 transition-all duration-500" />
              </div>
           </div>
        </div>

        <!-- Floating Badges -->
        <div class="absolute top-10 right-10 bg-white border-2 border-black px-4 py-2 flex items-center gap-2 animate-[bounce_3s_infinite] shadow-[4px_4px_0px_0px_rgba(0,0,0,1)]">
           <Icon name="mdi:star-four-points" class="text-yellow-500" />
           <span class="text-[9px] font-mono font-bold font-pixel">5+ Yıl Deneyim</span>
        </div>
        
        <div class="absolute bottom-20 left-0 bg-white border-2 border-black px-4 py-2 flex items-center gap-2 animate-[bounce_4s_infinite_reverse] shadow-[4px_4px_0px_0px_rgba(0,0,0,1)]">
           <Icon name="mdi:code-braces" class="text-blue-600" />
           <span class="text-[9px] font-mono font-bold font-pixel">Modern Tech</span>
        </div>

      </div>
    </div>
    
  </div>

  <!-- Scroll Indicator -->
  <div class="absolute bottom-10 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 opacity-50 animate-bounce hidden md:flex">
    <span class="text-[10px] uppercase tracking-[0.3em] font-mono">Keşfet</span>
    <div class="w-[1px] h-12 bg-gradient-to-b from-white to-transparent"></div>
  </div>
</section>

<script>
  import AOS from "aos";
  document.addEventListener("DOMContentLoaded", () => {
    AOS.init({
      duration: 1200,
      once: true,
      easing: 'ease-out-cubic'
    });
  });
</script>