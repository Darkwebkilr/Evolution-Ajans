---
// Hero.astro - Warm Editorial / Crafted Design Studio Aesthetic
import { Icon } from "astro-icon/components";
---

<section class="relative min-h-[78vh] w-full bg-[#FBF9F5] text-[#181816] flex items-center justify-center pt-28 pb-16 md:pt-36 md:pb-24 border-b border-dashed border-[#181816]/15">
  
  <div class="max-w-6xl w-full mx-auto px-6 lg:px-8 relative z-10">
    
    <!-- Asymmetrical 12-Column Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-14 items-center">
      
      <!-- Typographic Left Column (6 Cols) -->
      <div class="lg:col-span-6 flex flex-col items-start space-y-6">
        
        <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-[#EBF0E6] border border-[#536248]/25 text-[#3E4A35] text-xs font-mono tracking-wider">
          <span class="w-1.5 h-1.5 rounded-full bg-[#536248]"></span>
          <span>Doğrudan Müşteri Getiren Dijital Büyüme</span>
        </div>

        <h1 class="text-4xl sm:text-5xl md:text-6xl font-serif tracking-tight leading-[1.08] text-[#181816]">
          Rakipleriniz iş toplarken, <br class="hidden sm:block" />
          siz geride <span class="italic font-normal text-[#BE5836]">kalmayın</span>.
        </h1>

        <p class="text-base sm:text-lg text-[#4A4742] font-sans leading-relaxed max-w-xl font-normal">
          Web siteniz ve reklamlarınız nerede kan kaybediyor? Şabloncu ajans tuzaklarına düşmeden; sadece sizin için telefon çaldıran Google & Meta sistemleri ve yüksek dönüşümlü arayüzler kuruyoruz.
        </p>

        <!-- CTAs -->
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4 pt-2 w-full sm:w-auto">
          <a 
            href="#iletisim" 
            class="group inline-flex items-center justify-center gap-3 px-7 py-3.5 rounded-full bg-[#BE5836] text-white text-xs uppercase tracking-widest font-medium hover:bg-[#9E4324] transition-all shadow-sm"
          >
            <span>Ücretsiz Analiz İsteyin</span>
            <span class="text-sm group-hover:translate-x-1 transition-transform">→</span>
          </a>
          
          <a 
            href="https://wa.me/905519283598?text=Merhaba,%20sitemin%20ve%20reklamlarımın%20ücretsiz%20analizi%20için%20ulaşıyorum." 
            target="_blank" 
            class="inline-flex items-center justify-center gap-3 px-6 py-3.5 rounded-full bg-[#FFFFFF] border border-[#181816]/15 text-[#181816] text-xs uppercase tracking-widest font-medium hover:bg-[#F3EFE6] hover:border-[#181816]/30 transition-all shadow-sm"
          >
            <span>Hızlı WhatsApp</span>
            <span class="text-xs text-[#536248]">↗</span>
          </a>
        </div>

      </div>

      <!-- Coding Screen / Terminal Window Right Column (6 Cols) -->
      <div class="lg:col-span-6 relative">
        <div class="relative bg-[#1A1917] border border-[#181816]/20 rounded-[22px] shadow-[0_12px_40px_rgba(24,24,22,0.12)] overflow-hidden font-mono text-xs">
          
          <!-- Code Window Header / Top Bar -->
          <div class="flex items-center justify-between px-5 py-3.5 bg-[#23211D] border-b border-[#33312B] select-none">
            <div class="flex items-center gap-2">
              <span class="w-3 h-3 rounded-full bg-[#BE5836]/90 inline-block"></span>
              <span class="w-3 h-3 rounded-full bg-[#D4A359]/80 inline-block"></span>
              <span class="w-3 h-3 rounded-full bg-[#536248]/90 inline-block"></span>
            </div>

            <div class="flex items-center gap-2 text-[11px] text-[#A6A095] tracking-wider font-mono">
              <Icon name="mdi:code-tags" class="text-[#BE5836]" size={14} />
              <span>growth-engine.config.ts</span>
            </div>

            <div class="flex items-center gap-1.5 text-[10px] text-[#536248] tracking-widest">
              <span class="w-1.5 h-1.5 rounded-full bg-[#536248] animate-pulse"></span>
              <span class="text-[#8E9B82]">CANLI</span>
            </div>
          </div>

          <!-- Code Content Area -->
          <div class="p-5 sm:p-6 text-[12px] sm:text-[13px] leading-[1.7] overflow-x-auto text-[#E8E4DC] selection:bg-[#BE5836]/40">
            <pre class="font-mono"><code><span class="text-[#8E9B82]">// ⚡ Evolution Ajans — Yüksek Performanslı Sistem</span>
<span class="text-[#BE5836]">import</span> &#123; <span class="text-[#D4A359]">defineGrowthEngine</span> &#125; <span class="text-[#BE5836]">from</span> <span class="text-[#8E9B82]">"@evolution/core"</span>;

<span class="text-[#BE5836]">export default</span> <span class="text-[#D4A359]">defineGrowthEngine</span>(&#123;
  <span class="text-[#A6A095]">hedefBölge:</span> <span class="text-[#8E9B82]">"İzmir (30 İlçe Kapsamı)"</span>,
  <span class="text-[#A6A095]">mimari:</span> <span class="text-[#8E9B82]">"Astro SSG + Sıfır Bloat"</span>,

  <span class="text-[#A6A095]">performans:</span> &#123;
    <span class="text-[#A6A095]">pageSpeedSkoru:</span> <span class="text-[#D4A359]">100</span>,
    <span class="text-[#A6A095]">ilkAçılışSüresi:</span> <span class="text-[#8E9B82]">"&lt; 0.6s"</span>,
    <span class="text-[#A6A095]">coreWebVitals:</span> <span class="text-[#8E9B82]">"KUSURSUZ (Tüm Metrikler Yeşil)"</span>
  &#125;,

  <span class="text-[#A6A095]">yerelSEO:</span> &#123;
    <span class="text-[#A6A095]">googleHaritaPaketi:</span> <span class="text-[#8E9B82]">"Zirve (#1 Sıra Hedefi)"</span>,
    <span class="text-[#A6A095]">otomatikİndeks:</span> <span class="text-[#BE5836]">true</span>, <span class="text-[#8E9B82]">// Google Indexing API</span>
    <span class="text-[#A6A095]">yapılandırılmışVeri:</span> <span class="text-[#8E9B82]">"Schema.org LocalBusiness"</span>
  &#125;,

  <span class="text-[#A6A095]">dönüşümOdaklı:</span> &#123;
    <span class="text-[#A6A095]">çağrıTakibi:</span> <span class="text-[#8E9B82]">"Doğrudan Telefon &amp; WhatsApp"</span>,
    <span class="text-[#A6A095]">reklamİsrafÖnleme:</span> <span class="text-[#8E9B82]">"-%40 Negatif Filtreleme"</span>,
    <span class="text-[#A6A095]">sonuç:</span> <span class="text-[#8E9B82]">"Günlük Doğrulanmış Müşteri Talebi"</span>
  &#125;
&#125;);</code></pre>
          </div>

          <!-- Code Window Status Footer -->
          <div class="px-5 py-2.5 bg-[#23211D] border-t border-[#33312B] flex items-center justify-between text-[10px] text-[#A6A095] select-none">
            <div class="flex items-center gap-4">
              <span>TypeScript 5.8</span>
              <span>UTF-8</span>
              <span class="text-[#8E9B82]">● 0 Hata</span>
            </div>
            <div class="text-[#BE5836]">
              Astro 5.x
            </div>
          </div>

        </div>
      </div>

    </div>

  </div>
</section>
