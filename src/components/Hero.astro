---
// Hero.astro - Warm Editorial / Crafted Design Studio Aesthetic
import { Icon } from "astro-icon/components";
---

<section class="relative min-h-[82vh] w-full bg-[#FBF9F5] text-[#181816] flex items-center justify-center pt-28 pb-20 md:pt-36 md:pb-28 border-b border-dashed border-[#181816]/15">
  
  <div class="max-w-6xl w-full mx-auto px-6 lg:px-8 relative z-10">
    
    <!-- Top Editorial Metadata Row -->
    <div class="flex items-center justify-between border-b border-[#181816]/10 pb-5 mb-12 text-[11px] font-mono tracking-[0.2em] uppercase text-[#6E6A62]">
      <div class="flex items-center gap-3">
        <span class="w-2 h-2 rounded-full bg-[#536248]"></span>
        <span class="text-[#536248] font-medium">[ 01 // DİJİTAL ATÖLYE ]</span>
      </div>
      <div class="hidden sm:flex items-center gap-6">
        <span>İZMİR // BAYRAKLI</span>
        <span>•</span>
        <span>SEO, WEB & DÖNÜŞÜM</span>
      </div>
      <span class="text-[#BE5836] font-medium">EST. 2026</span>
    </div>

    <!-- Asymmetrical 12-Column Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
      
      <!-- Typographic Left Column (7 Cols) -->
      <div class="lg:col-span-7 flex flex-col items-start space-y-8">
        
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#EBF0E6] border border-[#536248]/25 text-[#3E4A35] text-xs font-mono tracking-wider">
          <span class="w-1.5 h-1.5 rounded-full bg-[#536248]"></span>
          <span>Doğrudan Müşteri Getiren Dijital Büyüme</span>
        </div>

        <h1 class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-serif tracking-tight leading-[1.08] text-[#181816]">
          Rakipleriniz iş toplarken, <br class="hidden sm:block" />
          siz geride <span class="italic font-normal text-[#BE5836]">kalmayın</span>.
        </h1>

        <p class="text-base sm:text-lg text-[#4A4742] font-sans leading-relaxed max-w-xl font-normal">
          Web siteniz ve reklamlarınız nerede kan kaybediyor? Şabloncu ajans tuzaklarına düşmeden; sadece sizin için telefon çaldıran Google & Meta sistemleri ve yüksek dönüşümlü arayüzler kuruyoruz.
        </p>

        <!-- CTAs -->
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4 pt-2 w-full sm:w-auto">
          <a 
            href="#iletisim" 
            class="group inline-flex items-center justify-center gap-3 px-7 py-3.5 rounded-full bg-[#BE5836] text-white text-xs uppercase tracking-widest font-medium hover:bg-[#9E4324] transition-all shadow-sm"
          >
            <span>Ücretsiz Analiz İsteyin</span>
            <span class="text-sm group-hover:translate-x-1 transition-transform">→</span>
          </a>
          
          <a 
            href="https://wa.me/905519283598?text=Merhaba,%20sitemin%20ve%20reklamlarımın%20ücretsiz%20analizi%20için%20ulaşıyorum." 
            target="_blank" 
            class="inline-flex items-center justify-center gap-3 px-6 py-3.5 rounded-full bg-[#FFFFFF] border border-[#181816]/15 text-[#181816] text-xs uppercase tracking-widest font-medium hover:bg-[#F3EFE6] hover:border-[#181816]/30 transition-all shadow-sm"
          >
            <span>Hızlı WhatsApp</span>
            <span class="text-xs text-[#536248]">↗</span>
          </a>
        </div>

        <!-- Micro Social Proof -->
        <div class="pt-6 border-t border-[#181816]/10 w-full flex items-center gap-6 text-xs text-[#6E6A62] font-mono">
          <div class="flex items-center gap-1.5 text-[#BE5836]">
            <span>★★★★★</span>
          </div>
          <span>30+ Aktif İşletme Sistemi</span>
          <span class="hidden sm:inline">•</span>
          <span class="hidden sm:inline text-[#536248]">Canlı Panel Doğrulaması</span>
        </div>

      </div>

      <!-- Editorial Card / Visual Right Column (5 Cols) -->
      <div class="lg:col-span-5 relative">
        <div class="relative bg-white border border-[#181816]/12 rounded-[28px] p-8 sm:p-10 shadow-[0_4px_30px_rgba(24,24,22,0.04)] overflow-hidden">
          
          <!-- Subtle Top Label -->
          <div class="flex items-center justify-between pb-6 border-b border-dashed border-[#181816]/15 mb-6">
            <span class="text-[10px] font-mono tracking-widest uppercase text-[#536248]">
              [ ATÖLYE MANİFESTOSU ]
            </span>
            <span class="text-xs font-serif italic text-[#6E6A62]">
              Sıfır Dolgu, Saf Dönüşüm
            </span>
          </div>

          <!-- Quote / Core Metric -->
          <div class="space-y-6">
            <p class="font-serif text-2xl text-[#181816] leading-snug">
              "Bir işletmenin web sitesi sanat galerisi değil; <span class="italic text-[#BE5836]">her gün yeni iş getiren</span> en çalışkan elemanı olmalıdır."
            </p>

            <div class="space-y-3 pt-4 font-mono text-xs text-[#4A4742]">
              <div class="flex items-center justify-between py-2 border-b border-[#181816]/8">
                <span class="text-[#6E6A62]">Odak Yaklaşım:</span>
                <span class="font-semibold text-[#181816]">Bölgesel Hakimiyet & SEO</span>
              </div>
              <div class="flex items-center justify-between py-2 border-b border-[#181816]/8">
                <span class="text-[#6E6A62]">Teknoloji:</span>
                <span class="font-semibold text-[#181816]">Astro SSG + Sıfır Bloat</span>
              </div>
              <div class="flex items-center justify-between py-2 border-b border-[#181816]/8">
                <span class="text-[#6E6A62]">İndeksleme:</span>
                <span class="font-semibold text-[#536248]">Google Indexing API</span>
              </div>
            </div>

            <!-- Soft terracotta footer seal -->
            <div class="pt-4 flex items-center justify-between text-[11px] font-mono text-[#6E6A62]">
              <span class="inline-flex items-center gap-1.5 text-[#536248]">
                <span class="w-1.5 h-1.5 rounded-full bg-[#536248]"></span>
                Danışmanlık Kontenjanı Açık
              </span>
              <span class="text-[#BE5836] font-medium">İZMİR 2026</span>
            </div>
          </div>

        </div>
      </div>

    </div>

  </div>
</section>
