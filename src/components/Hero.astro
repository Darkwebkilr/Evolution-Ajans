---
// EvolutionHero.astro
// Framework: Astro.js + Tailwind CSS
// Aesthetic: Refined Luxury / High-Tech Elegance
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";

// Placeholder for rocket image if needed, or we use a clean CSS-based geometric approach.
---

<section class="relative min-h-[90vh] md:h-screen w-full bg-[#030303] text-white overflow-hidden flex items-center justify-center pt-20">
  
  <!-- Atmospheric Backgrounds -->
  <div class="absolute inset-0 z-0">
    <div class="absolute top-[20%] left-[10%] w-[30vw] h-[30vw] rounded-full bg-blue-600/20 blur-[100px] animate-[pulse_8s_ease-in-out_infinite]"></div>
    <div class="absolute bottom-[20%] right-[10%] w-[40vw] h-[40vw] rounded-full bg-purple-600/10 blur-[120px] animate-[pulse_12s_ease-in-out_infinite_reverse]"></div>
    <!-- Fine Noise Texture -->
    <div class="absolute inset-0 opacity-[0.03] mix-blend-overlay pointer-events-none" style="background-image: url('data:image/svg+xml,%3Csvg viewBox=%220 0 200 200%22 xmlns=%22http://www.w3.org/2000/svg%22%3E%3Cfilter id=%22noiseFilter%22%3E%3CfeTurbulence type=%22fractalNoise%22 baseFrequency=%220.9%22 numOctaves=%223%22 stitchTiles=%22stitch%22/%3E%3C/filter%3E%3Crect width=%22100%25%22 height=%22100%25%22 filter=%22url(%23noiseFilter)%22/%3E%3C/svg%3E');"></div>
  </div>

  <div class="max-w-7xl w-full mx-auto px-6 lg:px-12 relative z-10 grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
    
    <!-- Typographic Left Column -->
    <div class="lg:col-span-7 flex flex-col items-start space-y-8">
      
      <div class="inline-flex items-center gap-3 px-4 py-2 rounded-full border border-white/10 bg-white/5 backdrop-blur-md" data-aos="fade-down">
        <span class="w-2 h-2 rounded-full bg-blue-500 animate-ping"></span>
        <span class="text-xs font-mono uppercase tracking-[0.2em] text-white/70">Yeni Nesil Reklam Ajansı</span>
      </div>

      <h1 class="text-6xl sm:text-7xl md:text-8xl lg:text-[100px] font-black uppercase tracking-tighter leading-[0.85]" data-aos="fade-up" data-aos-delay="100">
        <span class="block text-white">Gerçekçi</span>
        <span class="block text-transparent bg-clip-text bg-gradient-to-r from-blue-400 via-purple-400 to-white mt-2">& Modern</span>
        <span class="block text-white/40 mt-2">Çözümler</span>
      </h1>

      <p class="text-lg md:text-xl text-white/50 font-light max-w-xl leading-relaxed" data-aos="fade-up" data-aos-delay="200">
        İlham veren fikirleri, en güncel teknolojilerle gerçeğe dönüştürüyoruz. Sınırları zorlayan dijital deneyimler yaratmak için buradayız.
      </p>

      <div class="flex flex-col sm:flex-row gap-6 pt-4 w-full sm:w-auto" data-aos="fade-up" data-aos-delay="300">
        <a href="https://wa.me/+905519283598" class="group relative inline-flex items-center justify-center gap-4 px-8 py-4 bg-white text-black rounded-full overflow-hidden transition-transform hover:scale-105 active:scale-95">
          <span class="relative z-10 text-sm font-bold uppercase tracking-widest">Hemen Ulaşın</span>
          <div class="absolute inset-0 bg-blue-100 translate-y-full group-hover:translate-y-0 transition-transform duration-500 ease-[cubic-bezier(0.19,1,0.22,1)] z-0"></div>
          <Icon name="mdi:whatsapp" size={20} class="relative z-10" />
        </a>
        
        <a href="#services" class="group relative inline-flex items-center justify-center gap-4 px-8 py-4 bg-transparent border border-white/20 text-white rounded-full overflow-hidden transition-all hover:border-white/60 hover:bg-white/5">
          <span class="text-sm font-bold uppercase tracking-widest">Hizmetleri İncele</span>
          <Icon name="mdi:arrow-down" size={20} class="group-hover:translate-y-1 transition-transform" />
        </a>
      </div>
    </div>

    <!-- Geometric/Visual Right Column -->
    <div class="lg:col-span-5 relative hidden lg:flex justify-center items-center" data-aos="zoom-in" data-aos-delay="400">
      <div class="relative w-full aspect-square max-w-[500px]">
        <!-- Rotating Outer Rings -->
        <div class="absolute inset-0 border border-white/10 rounded-full animate-[spin_20s_linear_infinite]"></div>
        <div class="absolute inset-8 border border-white/5 rounded-full animate-[spin_15s_linear_infinite_reverse]"></div>
        <div class="absolute inset-16 border border-dashed border-white/20 rounded-full animate-[spin_30s_linear_infinite]"></div>
        
        <!-- Central Element (Replacing literal rocket with abstract modern shape) -->
        <div class="absolute inset-0 flex items-center justify-center">
           <div class="relative w-48 h-48 bg-gradient-to-br from-blue-500 to-purple-600 rounded-[2rem] rotate-12 animate-[pulse_4s_ease-in-out_infinite] shadow-[0_0_50px_rgba(59,130,246,0.5)] backdrop-blur-3xl overflow-hidden group">
              <!-- Glass reflection effect -->
              <div class="absolute top-0 left-0 w-full h-1/2 bg-gradient-to-b from-white/30 to-transparent"></div>
              
              <div class="absolute inset-0 flex items-center justify-center text-white">
                 <Icon name="mdi:rocket-launch-outline" size={64} class="group-hover:-translate-y-4 group-hover:translate-x-4 group-hover:opacity-0 transition-all duration-500" />
                 <Icon name="mdi:rocket-launch" size={64} class="absolute opacity-0 translate-y-4 -translate-x-4 group-hover:translate-y-0 group-hover:translate-x-0 group-hover:opacity-100 transition-all duration-500" />
              </div>
           </div>
        </div>

        <!-- Floating Badges -->
        <div class="absolute top-10 right-10 bg-black/50 backdrop-blur-md border border-white/10 px-4 py-2 rounded-2xl flex items-center gap-2 animate-[bounce_3s_infinite]">
           <Icon name="mdi:star-four-points" class="text-yellow-500" />
           <span class="text-xs font-mono font-bold">5+ Yıl Deneyim</span>
        </div>
        
        <div class="absolute bottom-20 left-0 bg-black/50 backdrop-blur-md border border-white/10 px-4 py-2 rounded-2xl flex items-center gap-2 animate-[bounce_4s_infinite_reverse]">
           <Icon name="mdi:code-braces" class="text-blue-400" />
           <span class="text-xs font-mono font-bold">Modern Tech</span>
        </div>

      </div>
    </div>
    
  </div>

  <!-- Scroll Indicator -->
  <div class="absolute bottom-10 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 opacity-50 animate-bounce hidden md:flex">
    <span class="text-[10px] uppercase tracking-[0.3em] font-mono">Keşfet</span>
    <div class="w-[1px] h-12 bg-gradient-to-b from-white to-transparent"></div>
  </div>
</section>

<script>
  import AOS from "aos";
  document.addEventListener("DOMContentLoaded", () => {
    AOS.init({
      duration: 1200,
      once: true,
      easing: 'ease-out-cubic'
    });
  });
</script>