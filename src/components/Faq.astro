---
const faqItems = [
  {
    q: "Neden retro-atari tarzı bir tasarım tercih ettiniz?",
    a: "Çünkü dijital dünyadaki binlerce birbirinin kopyası kurumsal şablondan sıyrılmak istiyoruz. Bu özgün tasarım, markanızın hafızalarda kalmasını sağlar, kreatif cesaretinizi gösterir ve Google'dan gelen ziyaretçileri şaşırtarak dönüşüm oranlarını artırır."
  },
  {
    q: "SEO (Arama Motoru Optimizasyonu) çalışmaları ne kadar sürede sonuç verir?",
    a: "SEO organik ve kalıcı bir büyüme sürecidir. Sitenizde yaptığımız optimizasyonlar ve Google Indexing API entegrasyonu sayesinde ilk haftalarda hızlı indeks alıp yükseliş görürüz. Ancak tam ve kalıcı sonuçları genellikle 3 ila 6 ay arasında elde ederiz."
  },
  {
    q: "Yeni bir web sitesinin tasarımı ve yayına alınması ne kadar sürer?",
    a: "Projenizin kapsamına ve özel isteklerinize bağlı olarak tasarım ve kodlama süreci genellikle 2 ila 4 hafta arasında tamamlanmaktadır. Bu süreçte siteniz tüm mobil cihazlarla tam uyumlu ve SEO altyapısı hazır şekilde teslim edilir."
  },
  {
    q: "Evolution Ajans olarak hangi dijital hizmetleri sunuyorsunuz?",
    a: "A'dan Z'ye dijital reklamcılık ve yazılım hizmetleri sunuyoruz. Başlıca odak alanlarımız: Kurumsal Web Tasarım, Google SEO Hizmeti, Meta (Instagram/Facebook) Reklam Yönetimi, Sosyal Medya Yönetimi ve Marka Kimliği Tasarımıdır."
  }
];
---

<section class="py-24 bg-white border-t-4 border-black relative z-10">
  <div class="max-w-4xl mx-auto px-6">
    <div class="text-center mb-16 space-y-4">
      <span class="inline-block px-4 py-2 border-2 border-black bg-black text-white text-[10px] font-mono uppercase tracking-[0.3em] font-pixel">
        Sorular & Cevaplar
      </span>
      <h2 class="text-2xl md:text-4xl font-black uppercase tracking-tighter text-black">
        SIKÇA SORULAN SORULAR
      </h2>
    </div>

    <div class="space-y-4">
      {faqItems.map((item, index) => (
        <div class="faq-item group bg-white border-4 border-black p-6 rounded-none shadow-[4px_4px_0px_rgba(0,0,0,1)] hover:-translate-y-[2px] hover:shadow-[6px_6px_0px_rgba(0,0,0,1)] transition-all duration-200 cursor-pointer" data-index={index}>
          <div class="faq-trigger flex justify-between items-center select-none font-pixel text-[10px] sm:text-xs font-bold text-black uppercase">
            <span class="pr-4">{item.q}</span>
            <span class="faq-icon text-lg font-bold transition-transform duration-200 select-none">+</span>
          </div>
          <div class="faq-content max-h-0 overflow-hidden transition-all duration-300 ease-in-out">
            <div class="mt-4 text-black/75 text-sm leading-relaxed border-t-2 border-black/10 pt-4 font-mono">
              <p>{item.a}</p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const items = document.querySelectorAll(".faq-item");
    items.forEach((item) => {
      const trigger = item.querySelector(".faq-trigger");
      const content = item.querySelector(".faq-content") as HTMLElement;
      const icon = item.querySelector(".faq-icon");

      trigger?.addEventListener("click", (e) => {
        e.preventDefault();
        const isOpen = item.classList.contains("active");
        
        // Close all items
        items.forEach((otherItem) => {
          otherItem.classList.remove("active");
          const otherContent = otherItem.querySelector(".faq-content") as HTMLElement;
          const otherIcon = otherItem.querySelector(".faq-icon");
          if (otherContent) otherContent.style.maxHeight = "0px";
          if (otherIcon) {
            otherIcon.textContent = "+";
          }
        });

        // Toggle clicked item
        if (!isOpen) {
          item.classList.add("active");
          if (content) {
            content.style.maxHeight = content.scrollHeight + 16 + "px";
          }
          if (icon) {
            icon.textContent = "−";
          }
        }
      });
    });
  });
</script>
