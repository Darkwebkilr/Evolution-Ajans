---
import { Icon } from "astro-icon/components";

const packages = [
  {
    name: "Hızlı Başlangıç",
    price: "10.000 TL",
    period: "/ ay",
    desc: "Acil sıcak talebe ihtiyacı olan, telefonlarının hemen bugün çalmasını isteyen servis ve esnaf işletmeleri için.",
    features: [
      "Tek sayfalık, ultra hızlı özel açılış sayfası (Landing Page)",
      "Sadece müşteri getiren Google Arama Ağı Reklamları kurulumu ve yönetimi",
      "Doğrudan telefon araması ve WhatsApp tıklama takibi",
      "Aylık şeffaf performans ve dönüşüm raporu"
    ],
    buttonText: "Bu Paketle Başla",
    highlight: false,
    cardBg: "bg-white",
    badge: "01 // BAŞLANGIÇ",
    btnClass: "bg-white border border-[#181816]/20 text-[#181816] hover:bg-[#181816] hover:text-white"
  },
  {
    name: "Bölge Hakimi",
    price: "20.000 TL",
    period: "/ ay",
    desc: "Sadece ilk arayanı değil, kararsız müşteriyi de rakiplere kaptırmak istemeyen büyüme odaklı firmalar için.",
    features: [
      "Hızlı açılış sayfası + Google Haritalar (İşletme Profili) tam optimizasyonu",
      "Google Arama Ağı Reklamları + Negatif anahtar kelime filtresi",
      "Ziyaretçileri takip eden Meta (Instagram/Facebook) Yeniden Pazarlama Reklamları",
      "Rakip hamle analizi ve haftalık bütçe optimizasyonu"
    ],
    buttonText: "Bölgemi Domine Et",
    highlight: true,
    cardBg: "bg-[#FAEDE8] border-[#BE5836]/40",
    badge: "02 // EN ÇOK TERCİH EDİLEN",
    btnClass: "bg-[#BE5836] text-white hover:bg-[#9E4324]"
  },
  {
    name: "Sektör Lideri",
    price: "35.000 TL",
    period: "/ ay",
    desc: "Tüm İzmir ve Ege genelinde organik olarak her ilçeden reklamsız ve reklamlı müşteri toplamak isteyenler için.",
    features: [
      "Google & Meta reklamlarının tam kapsamlı profesyonel yönetimi",
      "İlçe Bazlı Otomasyon: Hizmet bölgeleriniz için yüzlerce SEO uyumlu alt sayfa",
      "Google Indexing API ile anında dizine eklenme altyapısı",
      "Kapsamlı dijital varlık yönetimi ve 7/24 öncelikli danışmanlık"
    ],
    buttonText: "Zirveye Oyna",
    highlight: false,
    cardBg: "bg-white",
    badge: "03 // TAM ÖLÇEKLİ",
    btnClass: "bg-white border border-[#181816]/20 text-[#181816] hover:bg-[#181816] hover:text-white"
  }
];
---

<section id="fiyatlandirma" class="py-24 md:py-36 bg-[#FBF9F5] border-b border-dashed border-[#181816]/15 relative z-10">
  <div class="max-w-6xl mx-auto px-6">
    
    <!-- Header Title -->
    <div class="max-w-3xl mb-20 space-y-4">
      <div class="inline-flex items-center gap-2 text-xs font-mono uppercase tracking-[0.2em] text-[#536248] bg-[#EBF0E6] px-3 py-1 rounded-full border border-[#536248]/20">
        <span class="w-1.5 h-1.5 rounded-full bg-[#536248]"></span>
        <span>[ 06 // ŞEFFAF YATIRIM ]</span>
      </div>
      <h2 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-serif tracking-tight text-[#181816]">
        Sürpriz maliyetsiz, <br />
        <span class="italic font-normal text-[#BE5836]">net büyüme paketleri</span>.
      </h2>
      <p class="text-base sm:text-lg text-[#6E6A62] leading-relaxed">
        İşletmenizin ölçeğine ve aylık talep hedefinize uygun şeffaf paketler. Sözleşme baskısı olmadan, ölçülebilir sonuçlarla çalışıyoruz.
      </p>
    </div>

    <!-- Pricing Cards Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-stretch">
      {packages.map((pkg) => (
        <div class={`relative border rounded-[28px] p-8 md:p-10 shadow-[0_4px_24px_rgba(24,24,22,0.03)] flex flex-col justify-between transition-all duration-300 ${pkg.cardBg}`}>
          
          <div>
            <!-- Top Tag -->
            <div class="flex items-center justify-between pb-6 border-b border-dashed border-[#181816]/12 mb-6">
              <span class="text-[10px] font-mono tracking-widest uppercase font-medium text-[#536248]">
                {pkg.badge}
              </span>
              {pkg.highlight && (
                <span class="text-[9px] font-mono uppercase bg-[#BE5836] text-white px-2 py-0.5 rounded-full">
                  ÖNERİLEN
                </span>
              )}
            </div>

            <!-- Title & Price -->
            <h3 class="text-2xl font-serif text-[#181816] mb-3">
              {pkg.name}
            </h3>
            
            <div class="flex items-baseline gap-2 mb-4">
              <span class="text-3xl md:text-4xl font-serif tracking-tight font-semibold text-[#181816]">
                {pkg.price}
              </span>
              <span class="text-xs font-mono text-[#6E6A62]">
                {pkg.period}
              </span>
            </div>

            <p class="text-sm text-[#4A4742] leading-relaxed mb-8">
              {pkg.desc}
            </p>

            <!-- Features -->
            <div class="space-y-3 pt-4 border-t border-[#181816]/10 mb-8">
              {pkg.features.map((feat) => (
                <div class="flex items-start gap-3 text-xs sm:text-sm text-[#34322E] leading-relaxed">
                  <span class="text-[#536248] font-bold text-sm">✓</span>
                  <span>{feat}</span>
                </div>
              ))}
            </div>
          </div>

          <!-- CTA Button -->
          <a
            href="#iletisim"
            class={`w-full py-3.5 px-6 rounded-full text-xs uppercase tracking-widest font-medium transition-all text-center block shadow-sm ${pkg.btnClass}`}
          >
            {pkg.buttonText} →
          </a>

        </div>
      ))}
    </div>

  </div>
</section>
