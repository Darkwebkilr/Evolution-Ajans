---
import { Icon } from "astro-icon/components";

export interface Props {
  title: string;
  desc: string;
  icon: string;
  slug: string;
  index?: number;
}

const { title, desc, icon, slug, index = 0 } = Astro.props;
const isIconify = icon.includes(":");
const formattedIndex = (index + 1).toString().padStart(2, '0');
---

<a href="#iletisim" class="block h-full group outline-none">
  <div class="h-full bg-white border border-[#181816]/12 rounded-[28px] p-8 md:p-10 shadow-[0_4px_24px_rgba(24,24,22,0.03)] hover:border-[#BE5836]/40 hover:-translate-y-1 transition-all duration-300 flex flex-col justify-between">
    
    <div>
      <!-- Top Number & Icon -->
      <div class="flex justify-between items-center mb-8 pb-5 border-b border-dashed border-[#181816]/15">
        <div class="w-13 h-13 rounded-2xl bg-[#EBF0E6] border border-[#536248]/25 flex items-center justify-center text-[#536248] group-hover:bg-[#FAEDE8] group-hover:text-[#BE5836] group-hover:border-[#BE5836]/25 transition-colors">
          {isIconify ? (
            <Icon name={icon} class="w-6 h-6" />
          ) : (
            <img src={icon} class="w-6 h-6 object-contain" alt={title} loading="lazy" />
          )}
        </div>
        <span class="font-mono text-2xl font-light text-[#181816]/25 group-hover:text-[#BE5836] transition-colors">
          {formattedIndex} //
        </span>
      </div>

      <h3 class="text-2xl font-serif text-[#181816] mb-4 tracking-tight leading-snug group-hover:text-[#BE5836] transition-colors">
        {title}
      </h3>
      
      <p class="text-[#4A4742] text-sm md:text-base leading-relaxed font-sans">
        {desc}
      </p>
    </div>

    <!-- Bottom Action -->
    <div class="mt-8 pt-6 border-t border-[#181816]/10 flex items-center justify-between">
      <span class="text-xs uppercase tracking-widest font-mono text-[#536248] group-hover:text-[#BE5836] transition-colors">
        Detaylı Analiz
      </span>
      <span class="text-base text-[#181816] group-hover:text-[#BE5836] group-hover:translate-x-1 transition-all">
        →
      </span>
    </div>

  </div>
</a>
