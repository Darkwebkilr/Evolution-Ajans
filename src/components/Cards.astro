---
import { Icon } from "astro-icon/components";

export interface Props {
  title: string;
  desc: string;
  icon: string;
  slug: string;
  index?: number;
}

const { title, desc, icon, slug, index = 0 } = Astro.props;
const isIconify = icon.includes(":");

// Format index as 01, 02, etc.
const formattedIndex = (index + 1).toString().padStart(2, '0');
---

<a href="/#iletisim" class="block h-full group outline-none" data-aos="fade-up" data-aos-delay={index * 100}>
  <div class="relative h-full bg-white border-4 border-black p-8 md:p-10 rounded-none overflow-hidden transition-all duration-300 hover:bg-slate-50 flex flex-col justify-between z-10 hover:-translate-x-[4px] hover:-translate-y-[4px] hover:shadow-[8px_8px_0px_0px_rgba(0,0,0,1)] shadow-[4px_4px_0px_0px_rgba(0,0,0,1)]">
    
    <div class="relative z-10">
      <div class="flex justify-between items-center mb-8 border-b-2 border-black/10 pb-6">
        <div class="w-16 h-16 border-2 border-black bg-[#facc15] flex items-center justify-center shadow-[3px_3px_0px_rgba(0,0,0,1)] group-hover:scale-105 transition-transform duration-300">
          {isIconify ? (
            <Icon name={icon} class="w-8 h-8 text-black" />
          ) : (
            <img src={icon} class="w-8 h-8 object-contain" alt={title} loading="lazy" />
          )}
        </div>
        <span class="text-3xl font-black font-pixel text-black/25 group-hover:text-blue-600 transition-colors">
          {formattedIndex}
        </span>
      </div>

      <h3 class="text-xl lg:text-2xl font-black text-black mb-4 tracking-tight uppercase font-pixel leading-snug group-hover:text-blue-600 transition-colors">
        {title}
      </h3>
      
      <p class="text-black/80 text-base leading-relaxed font-mono">
        {desc}
      </p>
    </div>

    <!-- Details Button Area -->
    <div class="relative z-10 mt-8 flex items-center justify-between overflow-hidden pt-6 border-t-2 border-black/10">
      <span class="text-xs uppercase tracking-[0.2em] text-black/60 font-pixel font-bold">Ücretsiz Analiz Al</span>
      
      <div class="w-10 h-10 border-2 border-black flex items-center justify-center bg-[#facc15] transition-all duration-300 group-hover:translate-x-1 shadow-[2px_2px_0px_rgba(0,0,0,1)]">
        <Icon name="mdi:arrow-right" size={20} class="text-black" />
      </div>
    </div>

  </div>
</a>