---
export interface Props {
  title: string;
  desc: string;
  icon: string;
  slug: string;
  index?: number;
}

const { title, desc, icon, slug, index = 0 } = Astro.props;
const isLottie = icon.endsWith("json");
import LottieAnimation from "astro-integration-lottie/Lottie.astro";

// Format index as 01, 02, etc.
const formattedIndex = (index + 1).toString().padStart(2, '0');
---

<a href={`/hizmetler/${slug}`} class="block h-full group outline-none" data-aos="fade-up" data-aos-delay={index * 100}>
  <div class="relative h-full bg-white border-4 border-black p-8 md:p-10 rounded-none overflow-hidden transition-all duration-300 hover:bg-slate-50 flex flex-col justify-between z-10 hover:-translate-x-[4px] hover:-translate-y-[4px] hover:shadow-[8px_8px_0px_0px_rgba(0,0,0,1)] shadow-[4px_4px_0px_0px_rgba(0,0,0,1)]">
    
    <div class="relative z-10">
      <div class="flex justify-center items-center mb-8 border-b-2 border-black/10 pb-8">
        <div class="w-32 h-32 md:w-40 md:h-40 flex items-center justify-center transition-all duration-300 group-hover:scale-110">
          {isLottie ? (
            <div class="w-full h-full">
              <LottieAnimation src={icon} autoplay="visible" />
            </div>
          ) : (
            <img src={icon} class="w-full h-full object-contain" alt={title} />
          )}
        </div>
      </div>

      <h3 class="text-xs sm:text-sm md:text-[14px] font-bold text-black mb-6 tracking-tight uppercase font-pixel leading-relaxed">
        {title}
      </h3>
      
      <p class="text-black/70 text-sm leading-relaxed">
        {desc}
      </p>
    </div>

    <!-- Animated Details Area -->
    <div class="relative z-10 mt-10 flex items-center justify-between overflow-hidden pt-6 border-t border-black/5">
      <span class="text-[9px] uppercase tracking-[0.25em] text-black/50 font-pixel">Detayları Gör</span>
      
      <div class="w-10 h-10 rounded-none border-2 border-black flex items-center justify-center bg-[#facc15] transition-all duration-300 overflow-hidden relative">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-black absolute group-hover:translate-x-8 group-hover:-translate-y-8 transition-all duration-300 ease-[cubic-bezier(0.19,1,0.22,1)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-black absolute -translate-x-8 translate-y-8 group-hover:translate-x-0 group-hover:translate-y-0 transition-all duration-300 ease-[cubic-bezier(0.19,1,0.22,1)] delay-75" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </div>
    </div>

  </div>
</a>