---
// Brands.astro - Editorial Partner Marquee
---

<div class="py-5 bg-[#F4EFE6] text-[#4A4742] border-b border-dashed border-[#181816]/15 overflow-hidden select-none font-mono text-[11px] tracking-[0.25em] uppercase relative z-20">
  <div class="flex whitespace-nowrap gap-16 animate-marquee">
    {Array(4).fill([
      "★ VİZYON GRUP",
      "• EGE TEKNİK SERVİS",
      "★ ATLAS DİJİTAL",
      "• AKDENİZ TAŞIMACILIK",
      "★ KREATİF MİMARLIK",
      "• İZMİR ENDÜSTRİYEL"
    ]).flat().map(brand => (
      <span class="flex items-center gap-3 hover:text-[#BE5836] transition-colors">{brand}</span>
    ))}
  </div>
</div>

<style>
  @keyframes marquee {
    0% { transform: translateX(0%); }
    100% { transform: translateX(-25%); }
  }
  .animate-marquee {
    display: flex;
    animation: marquee 35s linear infinite;
    width: max-content;
  }
</style>
